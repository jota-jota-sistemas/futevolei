---
import Layout from "../../../../layouts/Layout.astro";
import GuardaAcesso from "../../../../components/GuardaAcesso.astro";
import OrganizarAbas from "../../../../components/OrganizarAbas.astro";
import OrganizarAtalhos from "../../../../components/OrganizarAtalhos.astro";
import OrganizarSecoes from "../../../../components/OrganizarSecoes.astro";
import OrganizarEstilos from "../../../../components/OrganizarEstilos.astro";
import Toasts from "../../../../components/Toasts.astro";
import { comBase, slugCategoria } from "../../../../utils/url";
import { carregarEventos, type EventoCarregado } from "../../../../utils/eventos-db";
import { CACHE_PAGINAS } from "../../../../utils/cache-http";
import "../../../../styles/chaveamento-compacto.css";

/**
 * Página de ORGANIZAÇÃO de UMA categoria (R9.1): gerencia duplas, configura o
 * formato, define o seeding, gera o chaveamento e registra resultados — tudo
 * POR CATEGORIA, de forma independente das demais categorias do campeonato.
 *
 * ## Arquitetura estática + organização no navegador
 *
 * O site é `output: "static"` (ver astro.config.mjs). Esta rota é
 * PRÉ-RENDERIDA em build a partir da tabela `campeonatos` (e `categorias`) do
 * Supabase: o `getStaticPaths()` emite uma página para cada par (campeonato, categoria),
 * usando o SLUG estável do nome da categoria (`slugCategoria`, a mesma
 * convenção da 18.1). O `id` (uuid) real da categoria vive no Supabase; ele é
 * resolvido em RUNTIME, no navegador, por (campeonato_id, nome) na tabela
 * `categorias` (mesma convenção de resolução da página pública [id].astro).
 *
 * Toda a INTERAÇÃO de organização é client-side (o `<script>` abaixo). Ela:
 *   - usa a lógica de domínio PURA (validação de duplas/formato/seeding,
 *     geração, progressão, serialização) de `src/domain/...`;
 *   - persiste/lê via `criarBracketStoreBrowser(supabase)` de
 *     `src/store/bracketStore.ts` (cliente público com RLS);
 *   - reutiliza `renderBracketClient` para exibir o estado atual do chaveamento.
 *
 * Esta rota NÃO é linkada publicamente. Administradores logados usam qualquer
 * evento; organizadores logados, só os eventos em que são donos (GuardaAcesso +
 * posse conferida no banco + RLS). Como o ambiente de build não tem Supabase real, o script é
 * DEFENSIVO (try/catch): sem Supabase a página apenas mostra avisos e não
 * quebra a geração estática.
 *
 * ## Escopo do "gerar" (decisão documentada)
 *
 * O botão "Gerar chaveamento" cria a ESTRUTURA INICIAL do chaveamento da
 * categoria, chamando o domínio puro `gerarChaveamento`:
 *   - "dupla eliminação" → gera o mata-mata completo (upper/lower/grande final);
 *   - "fase de grupos"  → gera a FASE DE GRUPOS (grupos + round-robin).
 *
 * A TRANSIÇÃO grupos → mata-mata (posicionar os classificados) NÃO é feita no
 * "gerar". Ela depende dos resultados dos jogos de grupo e fica num passo
 * SEPARADO: quando todos os grupos estão completos, aparece o botão "Gerar
 * mata-mata", que usa `prepararMataMata` (src/domain/bracket/matamata.ts)
 * e re-salva o chaveamento (mantendo o fluxo simples e explícito).
 */
export const prerender = false;

const lista = await carregarEventos({ escopo: "todos" });
const encontrado = lista.find((e) => e.id === (Astro.params.id ?? ""));
// Nomes exatamente como no banco: a página localiza a categoria por eles. Dois
// nomes com o mesmo slug (ex.: só muda a caixa) disputariam a rota: vale o primeiro.
const nomeCategoria = encontrado?.categoriasBanco.find(
  (nome) => slugCategoria(nome) === (Astro.params.categoria ?? ""),
);
if (!encontrado || !nomeCategoria) return Astro.rewrite("/404");
const campeonato: EventoCarregado = encontrado;
const categoriaNome: string = nomeCategoria;
Astro.response.headers.set("Cache-Control", CACHE_PAGINAS);
---

<Layout
  titulo={`Organizar ${categoriaNome} — ${campeonato.nome}`}
  descricao={`Organização da categoria ${categoriaNome} do campeonato ${campeonato.nome}.`}
  noindex
>
  <GuardaAcesso>
  <section
    class="org"
    data-campeonato-id={campeonato.id}
    data-categoria-nome={categoriaNome}
  >
    <a
      class="org__voltar"
      href={comBase(`/campeonatos/${campeonato.id}/organizar`)}
    >
      <span aria-hidden="true">←</span> Voltar às categorias
    </a>

    <header class="org__cabecalho">
      <p class="org__rotulo">Organização da categoria</p>
      <h1 class="org__titulo">{categoriaNome}</h1>
      <p class="org__subtitulo">{campeonato.nome}</p>
    </header>

    {/* Trocar de categoria em um clique + atalhos do campeonato. */}
    <OrganizarAbas
      campeonatoId={campeonato.id}
      categorias={campeonato.categoriasBanco}
      atual={categoriaNome}
    />
    <OrganizarAtalhos
      campeonatoId={campeonato.id}
      listado={campeonato.listado}
      temCategorias={campeonato.categoriasBanco.length > 0}
    />

    {/* Pula direto para Duplas, Formato, Chaveamento ou Jogos (página longa no celular). */}
    <OrganizarSecoes
      itens={[
        { id: "titulo-duplas", rotulo: "Duplas" },
        { id: "titulo-formato", rotulo: "Formato" },
        { id: "titulo-gerar", rotulo: "Chaveamento" },
        { id: "titulo-fila", rotulo: "Jogos" },
      ]}
    />

    {/* Faixa de status/erros global da página (persistência, carregamento). */}
    <p class="org__status" data-status role="status" aria-live="polite"></p>

    {/* Estado de inicialização: trocado pelo script quando pronto/indisponível. */}
    <p class="org__init" data-init role="status">Carregando organização…</p>

    {/* Conteúdo de organização, oculto até o script conseguir inicializar. */}
    <div class="org__conteudo" data-conteudo hidden>
      <!-- ============================ DUPLAS ============================ -->
      <section class="org__bloco" aria-labelledby="titulo-duplas">
        <h2 class="org__bloco-titulo" id="titulo-duplas">Duplas</h2>

        <form class="org__form" data-form-dupla novalidate>
          <div class="org__linha">
            <div class="org__campo">
              <label for="dupla-atleta-a">Atleta A</label>
              <input
                id="dupla-atleta-a"
                name="atletaA"
                type="text"
                autocomplete="off"
                maxlength="80"
                required
              />
              <small class="org__vinculo-info" data-vinculo-info aria-live="polite"></small>
            </div>
            <div class="org__campo">
              <label for="dupla-atleta-b">Atleta B</label>
              <input
                id="dupla-atleta-b"
                name="atletaB"
                type="text"
                autocomplete="off"
                maxlength="80"
                required
              />
              <small class="org__vinculo-info" data-vinculo-info aria-live="polite"></small>
            </div>
          </div>
          <datalist id="jogadores-opcoes" data-jogadores-lista></datalist>
          <button class="org__botao org__botao--primario" type="submit" data-add-dupla>
            Adicionar dupla
          </button>

          {/* Mesma dupla já inscrita: avisa e deixa decidir (podem ser homônimos). */}
          <div class="org__aviso" data-aviso-repetida role="alert" hidden>
            <p class="org__aviso-msg" data-repetida-msg></p>
            <div class="org__acoes">
              <button class="org__botao" type="button" data-repetida-revisar>Revisar</button>
              <button class="org__botao" type="button" data-repetida-forcar>Adicionar mesmo assim</button>
            </div>
          </div>
          <p class="org__erro" data-erro-dupla role="alert"></p>
        </form>

        {/* Lista colada do WhatsApp: uma dupla por linha. */}
        <details class="org__colar" data-colar>
          <summary class="org__colar-resumo">Colar lista de duplas</summary>
          <p class="org__ajuda">
            Cole a lista, uma dupla por linha (ex.: “Ana &amp; Bia” ou “Ana e Bia”).
            Números e marcadores no começo da linha são ignorados.
          </p>
          <label class="org__rotulo-campo" for="colar-texto">Lista de duplas</label>
          <textarea
            id="colar-texto"
            class="org__textarea"
            data-colar-texto
            rows="6"
            autocomplete="off"
            spellcheck="false"
            placeholder={"1. Ana & Bia\n2. Caio e Duda"}
          ></textarea>
          <p class="org__colar-sumario" data-colar-resumo aria-live="polite"></p>
          <ul class="org__colar-previa" data-colar-previa></ul>
          <button class="org__botao org__botao--primario" type="button" data-colar-confirmar disabled>
            Adicionar duplas
          </button>
          <p class="org__erro" data-colar-erro role="alert"></p>
        </details>

        <p class="org__contagem" data-contagem-duplas></p>
        <p class="org__ajuda" data-aviso-chaveamento hidden>
          Chaveamento já gerado: as duplas não podem mais ser editadas nem removidas.
        </p>
        <ul class="org__duplas" data-lista-duplas></ul>
      </section>

      <!-- ============================ FORMATO =========================== -->
      <section class="org__bloco" aria-labelledby="titulo-formato">
        <h2 class="org__bloco-titulo" id="titulo-formato">Formato</h2>

        <form class="org__form" data-form-formato novalidate>
          <div class="org__sugestao" data-sugestao hidden>
            <p class="org__sugestao-texto" data-sugestao-texto></p>
            <button class="org__botao" type="button" data-usar-sugestao>Usar sugestão</button>
          </div>
          <fieldset class="org__fieldset">
            <legend>Escolha o formato do chaveamento</legend>
            <label class="org__radio">
              <input
                type="radio"
                name="formato"
                value="eliminação simples"
                data-formato
              />
              <span>Eliminação simples</span>
            </label>
            <label class="org__radio">
              <input
                type="radio"
                name="formato"
                value="dupla eliminação"
                data-formato
              />
              <span>Dupla eliminação</span>
            </label>
            <label class="org__radio">
              <input
                type="radio"
                name="formato"
                value="fase de grupos"
                data-formato
              />
              <span>Fase de grupos</span>
            </label>
          </fieldset>

          {/* Parâmetros exclusivos da fase de grupos. */}
          <div class="org__grupos-params" data-grupos-params hidden>
            <div class="org__linha">
              <div class="org__campo">
                <label for="formato-grupos">Número de grupos</label>
                <input
                  id="formato-grupos"
                  name="numeroDeGrupos"
                  type="number"
                  min="1"
                  step="1"
                  inputmode="numeric"
                />
              </div>
              <div class="org__campo">
                <label for="formato-classificados">
                  Classificados por grupo
                </label>
                <input
                  id="formato-classificados"
                  name="classificadosPorGrupo"
                  type="number"
                  min="1"
                  step="1"
                  inputmode="numeric"
                />
              </div>
            </div>
          </div>

          <p class="org__ajuda" data-formato-dica aria-live="polite"></p>
          <p class="org__ajuda">O formato é salvo automaticamente.</p>
          <p class="org__erro" data-erro-formato role="alert"></p>
        </form>
      </section>

      <!-- =========================== NIVELADOR ========================= -->
      <section class="org__bloco" aria-labelledby="titulo-seeding">
        <h2 class="org__bloco-titulo" id="titulo-seeding">Nivelador</h2>
        <p class="org__ajuda">
          O nivelador equilibra grupos e chaves, evitando que as melhores
          duplas se enfrentem cedo. Se você não quiser usar, as duplas entram
          em ordem aleatória a cada vez que o chaveamento é gerado.
        </p>

        <label class="org__opcao">
          <input type="checkbox" data-usar-nivelador />
          Quero definir o nivelador (ordem de força das duplas)
        </label>

        <form class="org__form" data-form-seeding data-nivelador-conteudo hidden novalidate>
          <p class="org__ajuda">
            Ordene da dupla mais forte (topo) para a mais fraca. Arraste pela
            alça ⠿ ou use os botões de cada dupla. A ordem é salva
            automaticamente.
          </p>
          <div class="org__acoes">
            <button class="org__botao" type="button" data-sortear>Sortear e fixar</button>
            <button class="org__botao" type="button" data-alfabetica>Ordem alfabética</button>
          </div>
          <p class="org__ajuda" data-nivelador-estado aria-live="polite"></p>
          <ol class="org__nivelador" data-lista-seeding></ol>
          <p class="org__erro" data-erro-seeding role="alert"></p>
        </form>
      </section>

      <!-- =========================== GERAR ============================== -->
      <section class="org__bloco" aria-labelledby="titulo-gerar">
        <h2 class="org__bloco-titulo" id="titulo-gerar">Chaveamento</h2>

        <p class="org__resumo" data-resumo-geracao aria-live="polite"></p>

        <div class="org__acoes">
          <button class="org__botao org__botao--primario" type="button" data-gerar>
            Gerar chaveamento
          </button>
          {/* Botão de transição grupos → mata-mata; só habilitado quando todos
              os grupos estão completos (fase de grupos). */}
          <button class="org__botao" type="button" data-gerar-matamata hidden>
            Gerar mata-mata
          </button>
        </div>
        {/* Situação da fase de grupos: o que falta para liberar o mata-mata. */}
        <p class="org__ajuda" data-matamata-info aria-live="polite" hidden></p>

        {/* Prévia dos cruzamentos: nada é gravado antes de confirmar. */}
        <div class="org__confirmar" data-matamata-previa hidden role="alertdialog" aria-labelledby="matamata-titulo">
          <p class="org__confirmar-msg" id="matamata-titulo">
            Estes são os primeiros jogos do mata-mata. Confirme para gerar.
          </p>
          <ul class="org__cruzamentos" data-matamata-lista></ul>
          <div class="org__acoes">
            <button class="org__botao org__botao--primario" type="button" data-matamata-confirmar>
              Confirmar e gerar mata-mata
            </button>
            <button class="org__botao" type="button" data-matamata-cancelar>
              Cancelar
            </button>
          </div>
        </div>

        {/* Confirmação de substituição (R4.8/R4.9): só aparece quando já existe
            um chaveamento. Sem "Confirmar", nada é gravado. */}
        <div class="org__confirmar" data-confirmar hidden role="alertdialog" aria-labelledby="confirmar-msg">
          <p class="org__confirmar-msg" id="confirmar-msg">
            Já existe um chaveamento para esta categoria. Gerar novamente vai
            substituí-lo.<span data-confirmar-aviso></span> Deseja continuar?
          </p>
          <div class="org__acoes">
            <button class="org__botao org__botao--perigo" type="button" data-confirmar-sim>
              Confirmar substituição
            </button>
            <button class="org__botao" type="button" data-confirmar-nao>
              Cancelar
            </button>
          </div>
        </div>

        <p class="org__erro" data-erro-gerar role="alert"></p>
      </section>

      <!-- ========================= PRÓXIMOS JOGOS ======================= -->
      <section class="org__bloco" aria-labelledby="titulo-fila" data-fila hidden>
        <h2 class="org__bloco-titulo" id="titulo-fila">Próximos jogos</h2>
        <ul class="org__fila" data-fila-lista></ul>
        <button class="org__botao" type="button" data-fila-ver-todos hidden></button>
      </section>

      <!-- ===================== ESTADO ATUAL / RESULTADOS ================ -->
      <section class="org__bloco" aria-labelledby="titulo-estado">
        <h2 class="org__bloco-titulo" id="titulo-estado">Estado atual</h2>

        <div class="org__acoes">
          <button class="org__botao" type="button" data-tela-cheia hidden>
            ⛶ Tela cheia
          </button>
        </div>

        {/* Clique direto na dupla dentro de cada jogo registra o vencedor. */}
        {/* Visualização do chaveamento (renderBracketClient). */}
        <div class="org__bracket" data-bracket-slot>
          <p class="org__indisponivel">Nenhum chaveamento gerado ainda.</p>
        </div>
      </section>
    </div>
  </section>
  </GuardaAcesso>
  <Toasts />
  <OrganizarEstilos />
</Layout>

<script>
  // ========================================================================
  // Organização de UMA categoria — toda a interação roda no NAVEGADOR.
  //
  // Importa a lógica de domínio PURA e a store de I/O. É DEFENSIVO: se o
  // Supabase não estiver configurado (ex.: build/preview sem env), a página
  // exibe um aviso e não quebra. Cada operação de I/O passa pelo Result do
  // domínio e traduz DomainError para mensagens amigáveis em português.
  // ========================================================================
  import type { SupabaseClient } from "@supabase/supabase-js";
  import { criarBracketStoreBrowser } from "../../../../store/bracketStore";
  import { criarJogadorStoreBrowser } from "../../../../store/jogadorStore";
  import { criarAuthStoreBrowser } from "../../../../store/authStore";
  import { guardarAcesso } from "../../../../scripts/guarda";
  import { criarCampeonatoStoreBrowser } from "../../../../store/campeonatoStore";
  import { verificarPosseDoEvento } from "../../../../scripts/posse-evento";
  import {
    ligarSeletoresDeJogador,
    type SeletorJogadores,
  } from "../../../../scripts/seletor-jogador";
  import type {
    BracketStore,
    CategoryRef,
  } from "../../../../store/bracketStore";
  import { renderBracketClient } from "../../../../components/bracket/renderBracketClient";

  import type {
    Bracket,
    BracketConfig,
    DomainError,
    Pair,
  } from "../../../../domain/bracket/types";
  import type { Result } from "../../../../domain/result";
  import { mensagemErro } from "../../../../scripts/organizar/mensagens";

  import {
    seedingPadrao,
    seedingAleatorio,
  } from "../../../../domain/bracket/seeding";
  import { gerarChaveamento } from "../../../../domain/bracket/generator";
  import { rotuloDupla } from "../../../../domain/pairs/nome";
  import type { VinculosDuplaIds } from "../../../../store/bracketStore";
  import { resumirGeracao } from "../../../../domain/bracket/resumo";
  import { resumirPlacares, avisoDePlacaresPerdidos } from "../../../../domain/bracket/placares";
  import { mostrarToast, type OpcoesToast } from "../../../../scripts/organizar/toast";
  import { criarRascunho, prefixoDoRascunho, type Rascunho } from "../../../../scripts/organizar/rascunho";
  import { ligarSecoes } from "../../../../scripts/organizar/secoes";
  import { ligarDuplas, type ControleDuplas } from "../../../../scripts/organizar/duplas";
  import { ligarColarLista } from "../../../../scripts/organizar/colar-lista";
  import { ligarFormato, type ControleFormato } from "../../../../scripts/organizar/formato";
  import { ligarNivelador, type ControleNivelador } from "../../../../scripts/organizar/nivelador";
  import { ligarFila, type ControleFila } from "../../../../scripts/organizar/fila";
  import { abrirTelaPlacar as abrirPlacarModulo } from "../../../../scripts/organizar/placar";
  import {
    jogosPendentesDosGrupos,
    descreverFaltantes,
    podeGerarMataMata,
    prepararMataMata,
    type PreparoMataMata,
  } from "../../../../domain/bracket/matamata";
  import { abrirTelaChaveamento, type TelaChaveamento } from "../../../../components/bracket/telaChaveamento";
  import { abrirTelaJogo, type TelaJogo } from "../../../../components/bracket/telaJogo";
  import { registrarPlacar, atualizarPlacarAoVivo } from "../../../../domain/bracket/progression";
  import { numerarJogos } from "../../../../domain/bracket/ordenacao";
  import { jogosAlterados } from "../../../../domain/bracket/diff";

  // --------------------------------------------------------------------
  // Helpers de DOM
  // --------------------------------------------------------------------
  function q<T extends HTMLElement>(
    raiz: ParentNode,
    seletor: string,
  ): T | null {
    return raiz.querySelector<T>(seletor);
  }

  function setTexto(el: Element | null, texto: string): void {
    if (el) el.textContent = texto;
  }

  function limparErro(el: Element | null): void {
    setTexto(el, "");
  }

  // Escopo da organização: elementos e estado da página.
  interface Ctx {
    ref: CategoryRef;
    store: BracketStore;
    secao: HTMLElement;
    status: HTMLElement | null;
    // Estado em memória
    duplas: Pair[];
    bracket: Bracket | null;
    // Gravações de placar em andamento; enquanto houver, não relê o chaveamento
    // (evita sobrescrever a tela com dados ainda não gravados).
    salvando: number;
    recarregarDepois: boolean;
    // Telas cheias abertas (chaveamento completo / um jogo): acompanham as
    // atualizações do chaveamento.
    telaChaveamento: TelaChaveamento | null;
    telaJogo: TelaJogo | null;
    // Seletores opcionais de jogador cadastrado (null = indisponível; o
    // formulário segue só com texto).
    seletor: SeletorJogadores | null;
    // Vínculos das duplas com jogadores cadastrados (por id da dupla).
    vinculos: Record<string, VinculosDuplaIds>;
    // Formato salvo na categoria (colunas de `categorias`), se houver.
    configSalva: BracketConfig | null;
    // Módulos de UI (src/scripts/organizar/*): ligados em iniciar().
    duplasCtl: ControleDuplas | null;
    formatoCtl: ControleFormato | null;
    niveladorCtl: ControleNivelador | null;
    filaCtl: ControleFila | null;
    // Mata-mata montado e aguardando a confirmação da prévia.
    matamataPendente: Bracket | null;
  }

  /** Aviso curto no pé da tela (some sozinho). */
  const avisar = (opcoes: OpcoesToast): void => {
    mostrarToast(opcoes);
  };

  // --------------------------------------------------------------------
  // Inicialização
  // --------------------------------------------------------------------
  async function iniciar(): Promise<void> {
    // Administradores logados (qualquer evento) e organizadores (só os dele): a
    // guarda redireciona ou bloqueia os demais. A posse vem do banco.
    const idDoEvento = q<HTMLElement>(document, ".org[data-campeonato-id]")?.dataset.campeonatoId;
    if (!(await guardarAcesso({
      store: criarAuthStoreBrowser(),
      permitir: ["admin", "organizador"],
      verificar: verificarPosseDoEvento(criarCampeonatoStoreBrowser(), idDoEvento),
    }))) return;

    const secao = q<HTMLElement>(document, ".org[data-campeonato-id]");
    if (!secao) return;

    const campeonatoId = secao.dataset.campeonatoId;
    const categoriaNome = secao.dataset.categoriaNome;
    const init = q<HTMLElement>(secao, "[data-init]");
    const conteudo = q<HTMLElement>(secao, "[data-conteudo]");

    if (!campeonatoId || !categoriaNome) {
      setTexto(init, "Categoria inválida.");
      return;
    }

    // Import DINÂMICO do cliente público: `src/lib/supabase.ts` lança se as
    // variáveis de ambiente estiverem ausentes. Capturando aqui, a página não
    // quebra em ambientes sem Supabase (build/preview) — mostra um aviso.
    let supabase: SupabaseClient;
    try {
      const mod = await import("../../../../lib/supabase");
      supabase = mod.supabase;
    } catch {
      setTexto(
        init,
        "Organização indisponível: conexão com o banco não configurada neste ambiente.",
      );
      return;
    }

    // Resolve o id (uuid) da categoria por (campeonato_id, nome). Convenção da
    // página pública [id].astro: o nome é único por campeonato.
    let categoriaId: string;
    let configSalva: BracketConfig | null = null;
    try {
      const { data, error } = await supabase
        .from("categorias")
        .select("id, formato, numero_grupos, classificados_por_grupo")
        .eq("campeonato_id", campeonatoId)
        .eq("nome", categoriaNome)
        .maybeSingle();
      if (error || !data) {
        setTexto(
          init,
          "Categoria ainda não cadastrada no banco. Rode a migração das categorias antes de organizar.",
        );
        return;
      }
      categoriaId = data.id as string;
      configSalva = configDaCategoria(data);
    } catch {
      setTexto(init, "Falha ao localizar a categoria no banco.");
      return;
    }

    const store = criarBracketStoreBrowser(supabase);
    const ctx: Ctx = {
      ref: { campeonatoId, categoriaId },
      store,
      secao,
      status: q<HTMLElement>(secao, "[data-status]"),
      duplas: [],
      bracket: null,
      salvando: 0,
      recarregarDepois: false,
      telaChaveamento: null,
      telaJogo: null,
      seletor: null,
      vinculos: {},
      configSalva,
      duplasCtl: null,
      formatoCtl: null,
      niveladorCtl: null,
      filaCtl: null,
      matamataPendente: null,
    };

    // Carrega o estado inicial (duplas + chaveamento) antes de exibir a UI.
    await carregarEstado(ctx, { primeira: true });

    // Tempo real: placares lançados por outras pessoas aparecem sem recarregar.
    let timer: ReturnType<typeof setTimeout> | undefined;
    void store.assinarMudancas(ctx.ref, () => {
      clearTimeout(timer);
      timer = setTimeout(() => void recarregarChaveamento(ctx), 300);
    });

    // Liga os handlers e revela o conteúdo.
    ligarHandlers(ctx);
    ligarSecoes();
    // Opcional e isolado: se falhar, o formulário continua só com texto.
    void ligarJogadores(ctx, supabase);
    if (init) init.hidden = true;
    if (conteudo) conteudo.hidden = false;
  }

  // --------------------------------------------------------------------
  // Carregamento de estado (duplas + chaveamento) e re-render
  // --------------------------------------------------------------------
  async function carregarEstado(
    ctx: Ctx,
    opcoes: { primeira?: boolean } = {},
  ): Promise<void> {
    limparErro(ctx.status);

    // Duplas, vínculos e chaveamento são independentes: lê os três em paralelo.
    const [duplasRes, brRes, vincRes] = await Promise.all([
      ctx.store.listarDuplas(ctx.ref),
      ctx.store.carregarChaveamento(ctx.ref),
      ctx.store.listarVinculos(ctx.ref),
    ]);
    if (duplasRes.ok) {
      ctx.duplas = duplasRes.valor;
    } else {
      ctx.duplas = [];
      setTexto(ctx.status, mensagemErro(duplasRes.erro));
    }

    ctx.vinculos = vincRes.ok ? vincRes.valor : {};

    if (brRes.ok) {
      ctx.bracket = brRes.valor;
    } else {
      ctx.bracket = null;
      setTexto(ctx.status, mensagemErro(brRes.erro));
    }

    if (opcoes.primeira) ligarModulos(ctx);
    renderTudo(ctx);
  }

  /** Formato guardado nas colunas da categoria (null se ainda não definido). */
  function configDaCategoria(linha: {
    formato?: unknown;
    numero_grupos?: unknown;
    classificados_por_grupo?: unknown;
  }): BracketConfig | null {
    const f = linha.formato;
    if (f !== "fase de grupos" && f !== "dupla eliminação" && f !== "eliminação simples") return null;
    const config: BracketConfig = { formato: f };
    if (typeof linha.numero_grupos === "number") config.numeroDeGrupos = linha.numero_grupos;
    if (typeof linha.classificados_por_grupo === "number") {
      config.classificadosPorGrupo = linha.classificados_por_grupo;
    }
    return config;
  }

  /** Liga os módulos de duplas, colar lista, formato e nivelador (uma vez). */
  function ligarModulos(ctx: Ctx): void {
    const rascunho: Rascunho = criarRascunho(
      prefixoDoRascunho(ctx.ref.campeonatoId, ctx.ref.categoriaId),
    );
    ctx.niveladorCtl = ligarNivelador({
      secao: ctx.secao,
      store: ctx.store,
      ref: ctx.ref,
      estado: ctx,
      avisar,
      aplicarSeeds: (posicaoPorId) => {
        ctx.duplas = ctx.duplas.map((d) => ({ ...d, seed: posicaoPorId.get(d.id) ?? d.seed }));
      },
      aoMudar: () => renderResumo(ctx),
    });
    ctx.formatoCtl = ligarFormato({
      secao: ctx.secao,
      store: ctx.store,
      ref: ctx.ref,
      estado: ctx,
      rascunho,
      avisar,
      aoMudar: () => renderResumo(ctx),
    });
    ctx.duplasCtl = ligarDuplas({
      secao: ctx.secao,
      store: ctx.store,
      ref: ctx.ref,
      estado: ctx,
      rascunho,
      avisar,
      aoMudar: () => renderTudo(ctx),
      seletor: () => ctx.seletor,
      opcoesJogadores: () => ctx.seletor?.opcoes ?? null,
    });
    ligarColarLista({
      secao: ctx.secao,
      store: ctx.store,
      ref: ctx.ref,
      estado: ctx,
      avisar,
      aoMudar: () => renderTudo(ctx),
      renderDuplas: () => ctx.duplasCtl?.render(),
    });
    ctx.filaCtl = ligarFila({
      secao: ctx.secao,
      bracket: () => ctx.bracket,
      abrirPlacar: (matchId) => abrirTelaPlacar(ctx, matchId),
    });
    // Se já existe um nivelador salvo, a caixa começa marcada; senão, desmarcada.
    const usarNivelador = q<HTMLInputElement>(ctx.secao, "[data-usar-nivelador]");
    if (usarNivelador) usarNivelador.checked = ctx.niveladorCtl.temSeedingSalvo();
    ctx.niveladorCtl.atualizarVisibilidade();
  }

  /**
   * Relê só o chaveamento (sem mexer em duplas/nivelador, que podem ter edição
   * em andamento) e redesenha, preservando placares digitados e ainda não salvos.
   */
  async function recarregarChaveamento(ctx: Ctx): Promise<void> {
    if (ctx.salvando > 0) {
      ctx.recarregarDepois = true;
      return;
    }
    const res = await ctx.store.carregarChaveamento(ctx.ref);
    if (!res.ok || ctx.salvando > 0) {
      if (ctx.salvando > 0) ctx.recarregarDepois = true;
      return;
    }
    ctx.bracket = res.valor;
    renderBracket(ctx);
    renderBotaoMataMata(ctx);
  }

  function renderTudo(ctx: Ctx): void {
    ctx.duplasCtl?.render();
    ctx.niveladorCtl?.render();
    ctx.formatoCtl?.render();
    renderBracket(ctx);
    renderBotaoMataMata(ctx);
    renderResumo(ctx);
  }

  /** Resumo de uma linha antes de gerar: duplas · formato · nivelador. */
  function renderResumo(ctx: Ctx): void {
    const alvo = q<HTMLElement>(ctx.secao, "[data-resumo-geracao]");
    if (!alvo) return;
    const config = ctx.formatoCtl?.lerConfig();
    alvo.textContent = resumirGeracao({
      nDuplas: ctx.duplas.length,
      config: config?.ok ? config.valor : null,
      niveladorDefinido: ctx.niveladorCtl?.ligado() === true,
    });
  }

  // --------------------------------------------------------------------
  // GERAR (R4) — com confirmação de substituição (R4.8/R4.9)
  // --------------------------------------------------------------------

  /**
   * Monta a lista de duplas com seeding RESOLVIDO para alimentar o gerador,
   * a partir da ordem do nivelador exibida (inicialmente salva ou alfabética).
   */
  function duplasComSeeding(ctx: Ctx): Pair[] {
    // Sem nivelador: ordem aleatória (sorteada na borda; o gerador segue puro).
    if (ctx.niveladorCtl?.ligado() !== true) {
      const sorteio = new Map(
        seedingAleatorio(ctx.duplas).map((s) => [s.pairId, s.posicao]),
      );
      return ctx.duplas.map((d) => ({ ...d, seed: sorteio.get(d.id) ?? d.seed }));
    }
    // Com nivelador, o que o organizador vê na lista é o que vale (mesmo sem salvar).
    const ordem = ctx.niveladorCtl?.ordemAtual() ?? null;
    if (ordem) {
      const posicaoPorId = new Map(ordem.map((id, i) => [id, i + 1]));
      return ctx.duplas.map((d) => ({ ...d, seed: posicaoPorId.get(d.id) ?? d.seed }));
    }
    const padrao = seedingPadrao(ctx.duplas);
    const posicaoPorId = new Map(padrao.map((s) => [s.pairId, s.posicao]));
    return ctx.duplas.map((d) => ({
      ...d,
      seed: posicaoPorId.get(d.id) ?? d.seed,
    }));
  }

  /**
   * Lê o formato marcado na tela (já validado contra o número de duplas). Exige
   * um formato (R2.7); para "fase de grupos", valida os parâmetros.
   */
  function resolverConfigParaGerar(ctx: Ctx): Result<BracketConfig> {
    return (
      ctx.formatoCtl?.lerConfig() ?? { ok: false, erro: { code: "FORMATO_AUSENTE" } }
    );
  }

  async function clicarGerar(ctx: Ctx): Promise<void> {
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-gerar]");
    limparErro(erro);

    // Se já existe chaveamento, NÃO gera direto: exige confirmação explícita
    // (R4.8). Enquanto não confirmar, nada é gravado (R4.9).
    if (ctx.bracket !== null) {
      // Avisa o que se perde: placares já lançados somem junto com o chaveamento.
      const perdidos = avisoDePlacaresPerdidos(resumirPlacares(ctx.bracket));
      setTexto(
        q<HTMLElement>(ctx.secao, "[data-confirmar-aviso]"),
        perdidos ? ` Isso vai apagar ${perdidos}.` : "",
      );
      const confirmar = q<HTMLElement>(ctx.secao, "[data-confirmar]");
      if (confirmar) {
        confirmar.hidden = false;
        q<HTMLButtonElement>(confirmar, "[data-confirmar-nao]")?.focus();
      }
      return;
    }

    await gerarEffetivo(ctx);
  }

  async function gerarEffetivo(ctx: Ctx): Promise<void> {
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-gerar]");
    limparErro(erro);

    const configRes = resolverConfigParaGerar(ctx);
    if (!configRes.ok) {
      setTexto(erro, mensagemErro(configRes.erro));
      return;
    }

    const duplas = duplasComSeeding(ctx);
    const gen = gerarChaveamento({ duplas, config: configRes.valor });
    if (!gen.ok) {
      setTexto(erro, mensagemErro(gen.erro));
      return;
    }

    // Preenche os identificadores do par (campeonato, categoria) e já numera os
    // jogos elegíveis (ordem de disputa) antes de persistir.
    const bracket: Bracket = numerarJogos({
      ...gen.bracket,
      campeonatoId: ctx.ref.campeonatoId,
      categoriaId: ctx.ref.categoriaId,
    });

    const res = await ctx.store.salvarChaveamento(ctx.ref, bracket);
    if (!res.ok) {
      setTexto(erro, mensagemErro(res.erro));
      return;
    }

    avisar({ texto: "Chaveamento gerado e salvo." });
    await carregarEstado(ctx);
    // No celular o resultado fica bem abaixo: leva a pessoa até ele.
    q<HTMLElement>(ctx.secao, "#titulo-estado")?.scrollIntoView?.({ block: "start" });
  }

  // --------------------------------------------------------------------
  // GERAR MATA-MATA (transição grupos → mata-mata, R5.4/R5.5/R5.6)
  // --------------------------------------------------------------------

  /**
   * Botão e mensagem da passagem grupos → mata-mata: com a fase de grupos em
   * andamento mostra o que falta ("Faltam Jogo 4, 7 e 9") e deixa o botão
   * desabilitado; completa, libera o botão.
   */
  function renderBotaoMataMata(ctx: Ctx): void {
    const botao = q<HTMLButtonElement>(ctx.secao, "[data-gerar-matamata]");
    const info = q<HTMLElement>(ctx.secao, "[data-matamata-info]");
    if (!botao) return;
    const b = ctx.bracket;
    const emGrupos =
      b !== null &&
      b.formato === "fase de grupos" &&
      b.grupos.length > 0 &&
      !b.matches.some((m) => m.side !== "grupo");
    botao.hidden = !emGrupos;
    if (info) info.hidden = !emGrupos;
    if (!emGrupos || !b) {
      fecharPreviaMataMata(ctx);
      return;
    }
    const pendentes = jogosPendentesDosGrupos(b);
    botao.disabled = pendentes.length > 0;
    botao.textContent =
      pendentes.length > 0
        ? `Gerar mata-mata (faltam ${pendentes.length} ${pendentes.length === 1 ? "jogo" : "jogos"})`
        : "Gerar mata-mata";
    setTexto(
      info,
      pendentes.length > 0
        ? `${descreverFaltantes(pendentes)} para fechar a fase de grupos.`
        : "Fase de grupos concluída. Gere o mata-mata com os classificados.",
    );
    if (pendentes.length > 0) fecharPreviaMataMata(ctx);
  }

  function fecharPreviaMataMata(ctx: Ctx): void {
    ctx.matamataPendente = null;
    const previa = q<HTMLElement>(ctx.secao, "[data-matamata-previa]");
    if (previa) previa.hidden = true;
  }

  /** Monta o mata-mata e mostra os cruzamentos; só grava em `confirmarMataMata`. */
  function mostrarPreviaMataMata(ctx: Ctx): void {
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-gerar]");
    limparErro(erro);
    if (!ctx.bracket) return;
    const prep: PreparoMataMata = prepararMataMata(ctx.bracket);
    if (prep.tipo === "incompleto") {
      setTexto(erro, `${descreverFaltantes(prep.pendentes) || "A fase de grupos ainda não está completa"}.`);
      return;
    }
    if (prep.tipo === "erro") {
      setTexto(erro, mensagemErro(prep.erro));
      return;
    }
    ctx.matamataPendente = prep.bracket;
    const lista = q<HTMLElement>(ctx.secao, "[data-matamata-lista]");
    lista?.replaceChildren();
    for (const c of prep.cruzamentos) {
      const li = document.createElement("li");
      li.textContent = `${c.jogo !== null ? `Jogo ${c.jogo}: ` : ""}${c.a} × ${c.b}`;
      lista?.append(li);
    }
    const previa = q<HTMLElement>(ctx.secao, "[data-matamata-previa]");
    if (previa) {
      previa.hidden = false;
      q<HTMLButtonElement>(previa, "[data-matamata-cancelar]")?.focus();
    }
  }

  async function confirmarMataMata(ctx: Ctx): Promise<void> {
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-gerar]");
    limparErro(erro);
    const combinado = ctx.matamataPendente;
    if (!combinado) return;
    const botao = q<HTMLButtonElement>(ctx.secao, "[data-matamata-confirmar]");
    if (botao) botao.disabled = true;
    const res = await ctx.store.salvarChaveamento(ctx.ref, combinado);
    if (botao) botao.disabled = false;
    if (!res.ok) {
      setTexto(erro, mensagemErro(res.erro));
      return;
    }
    fecharPreviaMataMata(ctx);
    avisar({ texto: "Mata-mata gerado a partir dos classificados." });
    await carregarEstado(ctx);
  }

  // --------------------------------------------------------------------
  // REGISTRAR RESULTADOS (R6) — para cada jogo pronto (sem bye, ambas as duplas)
  // --------------------------------------------------------------------
  function nomeDupla(bracket: Bracket, pairId: string | null): string {
    if (!pairId) return "(indefinida)";
    const d = bracket.duplas.find((x) => x.id === pairId);
    return d ? rotuloDupla(d) : "(indefinida)";
  }

  /**
   * Registra o resultado FINAL de um jogo (vencedor derivado do placar, avanço
   * e cascata). Devolve a mensagem de erro, ou `null` se deu certo.
   */
  async function registrarResultado(
    ctx: Ctx,
    matchId: string,
    placarA: number,
    placarB: number,
  ): Promise<string | null> {
    const bracket = ctx.bracket;
    if (!bracket) return "Nenhum chaveamento carregado.";

    // Progressão PURA: produz um novo bracket (avanço + cascata). `agora` é
    // injetado na borda para manter a função pura (R6.1).
    const res = registrarPlacar(
      bracket,
      matchId,
      placarA,
      placarB,
      new Date().toISOString(),
    );
    if (!res.ok) {
      const msg = mensagemErro(res.erro);
      setTexto(ctx.status, msg);
      avisar({ texto: msg, tipo: "erro" });
      return msg;
    }

    // Numera os jogos que passaram a ser elegíveis com este resultado (ex.: a
    // próxima rodada do mata-mata cujas duplas acabaram de ser definidas). Os
    // já numerados permanecem estáveis.
    const numerado = numerarJogos(res.bracket);
    const alterados = jogosAlterados(bracket, numerado);
    if (alterados.length === 0) return null;

    // Atualização otimista: mostra o placar na hora e grava só os jogos que
    // mudaram (uma ida ao banco), sem reler o chaveamento inteiro.
    ctx.bracket = numerado;
    renderBracket(ctx);
    renderBotaoMataMata(ctx);

    ctx.salvando += 1;
    const salvo = await ctx.store.salvarJogos(ctx.ref, alterados, numerado.campeaId);
    ctx.salvando -= 1;
    const reler = ctx.salvando === 0 && ctx.recarregarDepois;
    if (reler) ctx.recarregarDepois = false;
    if (!salvo.ok) {
      // Falhou: volta ao estado anterior para a tela não mostrar algo não salvo.
      ctx.bracket = bracket;
      renderBracket(ctx);
      renderBotaoMataMata(ctx);
      const msg = mensagemErro(salvo.erro);
      setTexto(ctx.status, msg);
      avisar({ texto: msg, tipo: "erro" });
      if (reler) void recarregarChaveamento(ctx);
      return msg;
    }
    avisar({ texto: "Placar registrado." });
    if (!podeGerarMataMata(bracket) && podeGerarMataMata(numerado)) {
      avisar({ texto: "Fase de grupos concluída. Já dá para gerar o mata-mata." });
    }
    // Chegou evento de outra pessoa durante a gravação: relê agora.
    if (reler) void recarregarChaveamento(ctx);
    return null;
  }

  /**
   * Grava o placar PARCIAL de um jogo em andamento (sem encerrar nem avançar
   * ninguém). Cada toque no "+" chega aqui: quem acompanha vê o placar mudar.
   * Devolve a mensagem de erro, ou `null` se deu certo.
   */
  async function salvarPlacarAoVivo(
    ctx: Ctx,
    matchId: string,
    placarA: number,
    placarB: number,
  ): Promise<string | null> {
    const bracket = ctx.bracket;
    if (!bracket) return "Nenhum chaveamento carregado.";
    const res = atualizarPlacarAoVivo(bracket, matchId, placarA, placarB);
    if (!res.ok) return mensagemErro(res.erro);
    const alterados = jogosAlterados(bracket, res.bracket);
    if (alterados.length === 0) return null;

    ctx.bracket = res.bracket;
    renderBracket(ctx);

    ctx.salvando += 1;
    const salvo = await ctx.store.salvarJogos(ctx.ref, alterados, res.bracket.campeaId);
    ctx.salvando -= 1;
    const reler = ctx.salvando === 0 && ctx.recarregarDepois;
    if (reler) ctx.recarregarDepois = false;
    if (reler) void recarregarChaveamento(ctx);
    // Em caso de falha NÃO desfaz: o placar da tela de pontuação é o que vale e
    // o próximo toque reenvia o valor mais recente.
    return salvo.ok ? null : mensagemErro(salvo.erro);
  }

  // --------------------------------------------------------------------
  // TELA DE PLACAR (ao vivo)
  // --------------------------------------------------------------------
  /**
   * Abre a tela de placar do jogo (src/scripts/organizar/placar.ts). Em tela
   * cheia, `dentroDe` é o elemento em tela cheia: o navegador só mostra o que
   * está dentro dele, então a janela precisa ser criada ali.
   */
  function abrirTelaPlacar(ctx: Ctx, matchId: string, dentroDe?: HTMLElement): void {
    abrirPlacarModulo(
      {
        bracket: () => ctx.bracket,
        salvarAoVivo: (id, a, b) => salvarPlacarAoVivo(ctx, id, a, b),
        registrar: (id, a, b) => registrarResultado(ctx, id, a, b),
        avisar,
        dentroDe,
      },
      matchId,
    );
  }

  // --------------------------------------------------------------------
  // VISUALIZAÇÃO do estado atual (renderBracketClient)
  // --------------------------------------------------------------------
  function renderBracket(ctx: Ctx): void {
    ctx.filaCtl?.render();
    const slot = q<HTMLElement>(ctx.secao, "[data-bracket-slot]");
    if (!slot) return;

    // Botão "Tela cheia" só com chaveamento; telas cheias abertas acompanham.
    const botaoTelaCheia = q<HTMLButtonElement>(ctx.secao, "[data-tela-cheia]");
    if (botaoTelaCheia) botaoTelaCheia.hidden = !ctx.bracket;
    if (ctx.bracket) {
      ctx.telaChaveamento?.atualizar(ctx.bracket);
      ctx.telaJogo?.atualizar(ctx.bracket);
    } else {
      ctx.telaJogo?.fechar();
      ctx.telaChaveamento?.fechar();
    }

    if (!ctx.bracket) {
      const vazio = document.createElement("p");
      vazio.className = "org__indisponivel";
      vazio.textContent = "Nenhum chaveamento gerado ainda.";
      slot.replaceChildren(vazio);
      return;
    }

    try {
      // O organizador abre a tela de placar do jogo (ao vivo; vencedor =
      // maior número, sem empate). Ver `abrirTelaPlacar`.
      const view = renderBracketClient(ctx.bracket, {
        aoAbrirPlacar: (matchId) => abrirTelaPlacar(ctx, matchId),
      });
      slot.replaceChildren(view);
    } catch {
      const err = document.createElement("p");
      err.className = "org__indisponivel";
      err.textContent = "Não foi possível exibir o chaveamento.";
      slot.replaceChildren(err);
    }
  }

  // --------------------------------------------------------------------
  // Jogadores cadastrados (vínculo opcional da dupla com o perfil)
  // --------------------------------------------------------------------
  async function ligarJogadores(
    ctx: Ctx,
    supabase: SupabaseClient,
  ): Promise<void> {
    const form = q<HTMLFormElement>(ctx.secao, "[data-form-dupla]");
    if (!form) return;
    try {
      const r = await criarJogadorStoreBrowser(supabase).listar();
      if (!r.ok || r.valor.length === 0) return; // nada para escolher
      ctx.seletor = ligarSeletoresDeJogador(form, r.valor);
    } catch {
      // Segue sem os seletores: o cadastro por texto não depende deles.
    }
  }

  // --------------------------------------------------------------------
  // Ligação de handlers
  // --------------------------------------------------------------------
  /** "Tela cheia": o chaveamento completo, em tempo real (com lançamento de placar). */
  function ligarTelaCheia(ctx: Ctx): void {
    const categoria = ctx.secao.dataset.categoriaNome ?? "Chaveamento";
    const abrirJogo = (
      matchId: string,
      contexto?: { dentroDe: HTMLElement; aoFecharJogo: () => void },
    ): void => {
      if (!ctx.bracket) return;
      ctx.telaJogo?.fechar();
      ctx.telaJogo = abrirTelaJogo({
        bracket: ctx.bracket,
        matchId,
        categoria,
        dentroDe: contexto?.dentroDe,
        aoFechar: () => {
          ctx.telaJogo = null;
          contexto?.aoFecharJogo();
        },
      });
    };
    q<HTMLButtonElement>(ctx.secao, "[data-tela-cheia]")?.addEventListener("click", () => {
      if (!ctx.bracket) return;
      ctx.telaChaveamento?.fechar();
      ctx.telaChaveamento = abrirTelaChaveamento({
        bracket: ctx.bracket,
        categoria,
        aoAbrirJogo: abrirJogo,
        // Lançar placar também funciona em tela cheia: a janela abre dentro dela.
        aoAbrirPlacar: (matchId, contexto) =>
          abrirTelaPlacar(ctx, matchId, contexto.dentroDe),
        aoFechar: () => {
          ctx.telaChaveamento = null;
        },
      });
    });
  }

  function ligarHandlers(ctx: Ctx): void {
    ligarTelaCheia(ctx);
    // Gerar
    q<HTMLButtonElement>(ctx.secao, "[data-gerar]")?.addEventListener(
      "click",
      () => void clicarGerar(ctx),
    );

    // Gerar mata-mata
    q<HTMLButtonElement>(ctx.secao, "[data-gerar-matamata]")?.addEventListener(
      "click",
      () => mostrarPreviaMataMata(ctx),
    );
    q<HTMLButtonElement>(ctx.secao, "[data-matamata-confirmar]")?.addEventListener(
      "click",
      () => void confirmarMataMata(ctx),
    );
    q<HTMLButtonElement>(ctx.secao, "[data-matamata-cancelar]")?.addEventListener(
      "click",
      () => fecharPreviaMataMata(ctx),
    );

    // Confirmação de substituição (R4.8/R4.9)
    q<HTMLButtonElement>(ctx.secao, "[data-confirmar-sim]")?.addEventListener(
      "click",
      () => {
        const confirmar = q<HTMLElement>(ctx.secao, "[data-confirmar]");
        if (confirmar) confirmar.hidden = true;
        void gerarEffetivo(ctx);
      },
    );
    q<HTMLButtonElement>(ctx.secao, "[data-confirmar-nao]")?.addEventListener(
      "click",
      () => {
        // Cancela: nada é gravado (R4.9); apenas fecha o painel.
        const confirmar = q<HTMLElement>(ctx.secao, "[data-confirmar]");
        if (confirmar) confirmar.hidden = true;
        avisar({ texto: "Substituição cancelada. Nada foi alterado." });
      },
    );
  }

  iniciar();
</script>

