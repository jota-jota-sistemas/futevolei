---
import type { Campeonato } from "../../../../types";
import campeonatosData from "../../../../data/campeonatos.json";
import Layout from "../../../../layouts/Layout.astro";
import { comBase, slugCategoria } from "../../../../utils/url";

/**
 * Página de ORGANIZAÇÃO de UMA categoria (R9.1): gerencia duplas, configura o
 * formato, define o seeding, gera o chaveamento e registra resultados — tudo
 * POR CATEGORIA, de forma independente das demais categorias do campeonato.
 *
 * ## Arquitetura estática + organização no navegador
 *
 * O site é `output: "static"` (ver astro.config.mjs). Esta rota é
 * PRÉ-RENDERIDA em build a partir do JSON `src/data/campeonatos.json`: o
 * `getStaticPaths()` emite uma página para cada par (campeonato, categoria),
 * usando o SLUG estável do nome da categoria (`slugCategoria`, a mesma
 * convenção da 18.1). O `id` (uuid) real da categoria vive no Supabase; ele é
 * resolvido em RUNTIME, no navegador, por (campeonato_id, nome) na tabela
 * `categorias` (mesma convenção de resolução da página pública [id].astro).
 *
 * Toda a INTERAÇÃO de organização é client-side (o `<script>` abaixo). Ela:
 *   - usa a lógica de domínio PURA (validação de duplas/formato/seeding,
 *     geração, progressão, serialização) de `src/domain/...`;
 *   - persiste/lê via `criarBracketStoreBrowser(supabase)` de
 *     `src/store/bracketStore.ts` (cliente público com RLS);
 *   - reutiliza `renderBracketClient` para exibir o estado atual do chaveamento.
 *
 * Esta rota NÃO é linkada publicamente e o controle de acesso completo chega na
 * Fase 2a (R9.3). Como o ambiente de build não tem Supabase real, o script é
 * DEFENSIVO (try/catch): sem Supabase a página apenas mostra avisos e não
 * quebra a geração estática.
 *
 * ## Escopo do "gerar" (decisão documentada)
 *
 * O botão "Gerar chaveamento" cria a ESTRUTURA INICIAL do chaveamento da
 * categoria, chamando o domínio puro `gerarChaveamento`:
 *   - "dupla eliminação" → gera o mata-mata completo (upper/lower/grande final);
 *   - "fase de grupos"  → gera a FASE DE GRUPOS (grupos + round-robin).
 *
 * A TRANSIÇÃO grupos → mata-mata (posicionar os classificados) NÃO é feita no
 * "gerar". Ela depende dos resultados dos jogos de grupo e fica num passo
 * SEPARADO: quando todos os grupos estão completos, aparece o botão "Gerar
 * mata-mata", que usa `selecionarClassificados` + `posicionarClassificadosNoMataMata`
 * e re-salva o chaveamento (mantendo o fluxo simples e explícito).
 */
export function getStaticPaths() {
  const lista = campeonatosData as Campeonato[];
  const paths: Array<{
    params: { id: string; categoria: string };
    props: { campeonato: Campeonato; categoriaNome: string };
  }> = [];

  for (const campeonato of lista) {
    const categorias = campeonato.categorias ?? [];
    for (const categoriaNome of categorias) {
      paths.push({
        params: { id: campeonato.id, categoria: slugCategoria(categoriaNome) },
        props: { campeonato, categoriaNome },
      });
    }
  }

  return paths;
}

interface Props {
  campeonato: Campeonato;
  categoriaNome: string;
}

const { campeonato, categoriaNome } = Astro.props;
---

<Layout
  titulo={`Organizar ${categoriaNome} — ${campeonato.nome}`}
  descricao={`Organização da categoria ${categoriaNome} do campeonato ${campeonato.nome}.`}
>
  <section
    class="org"
    data-campeonato-id={campeonato.id}
    data-categoria-nome={categoriaNome}
  >
    <a
      class="org__voltar"
      href={comBase(`/campeonatos/${campeonato.id}/organizar`)}
    >
      <span aria-hidden="true">←</span> Voltar às categorias
    </a>

    <header class="org__cabecalho">
      <p class="org__rotulo">Organização da categoria</p>
      <h1 class="org__titulo">{categoriaNome}</h1>
      <p class="org__subtitulo">{campeonato.nome}</p>
    </header>

    {/* Faixa de status/erros global da página (persistência, carregamento). */}
    <p class="org__status" data-status role="status" aria-live="polite"></p>

    {/* Estado de inicialização: trocado pelo script quando pronto/indisponível. */}
    <p class="org__init" data-init role="status">Carregando organização…</p>

    {/* Conteúdo de organização, oculto até o script conseguir inicializar. */}
    <div class="org__conteudo" data-conteudo hidden>
      <!-- ============================ DUPLAS ============================ -->
      <section class="org__bloco" aria-labelledby="titulo-duplas">
        <h2 class="org__bloco-titulo" id="titulo-duplas">Duplas</h2>

        <form class="org__form" data-form-dupla novalidate>
          <div class="org__campo">
            <label for="dupla-nome">Nome da dupla</label>
            <input
              id="dupla-nome"
              name="nomeDupla"
              type="text"
              autocomplete="off"
              maxlength="80"
              required
            />
          </div>
          <div class="org__linha">
            <div class="org__campo">
              <label for="dupla-atleta-a">Atleta A</label>
              <input
                id="dupla-atleta-a"
                name="atletaA"
                type="text"
                autocomplete="off"
                maxlength="80"
                required
              />
            </div>
            <div class="org__campo">
              <label for="dupla-atleta-b">Atleta B</label>
              <input
                id="dupla-atleta-b"
                name="atletaB"
                type="text"
                autocomplete="off"
                maxlength="80"
                required
              />
            </div>
          </div>
          <button class="org__botao" type="submit" data-add-dupla>
            Adicionar dupla
          </button>
          <p class="org__erro" data-erro-dupla role="alert"></p>
        </form>

        <p class="org__contagem" data-contagem-duplas></p>
        <ul class="org__duplas" data-lista-duplas></ul>
      </section>

      <!-- ============================ FORMATO =========================== -->
      <section class="org__bloco" aria-labelledby="titulo-formato">
        <h2 class="org__bloco-titulo" id="titulo-formato">Formato</h2>

        <form class="org__form" data-form-formato novalidate>
          <fieldset class="org__fieldset">
            <legend>Escolha o formato do chaveamento</legend>
            <label class="org__radio">
              <input
                type="radio"
                name="formato"
                value="eliminação simples"
                data-formato
              />
              <span>Eliminação simples</span>
            </label>
            <label class="org__radio">
              <input
                type="radio"
                name="formato"
                value="dupla eliminação"
                data-formato
              />
              <span>Dupla eliminação</span>
            </label>
            <label class="org__radio">
              <input
                type="radio"
                name="formato"
                value="fase de grupos"
                data-formato
              />
              <span>Fase de grupos</span>
            </label>
          </fieldset>

          {/* Parâmetros exclusivos da fase de grupos. */}
          <div class="org__grupos-params" data-grupos-params hidden>
            <div class="org__linha">
              <div class="org__campo">
                <label for="formato-grupos">Número de grupos</label>
                <input
                  id="formato-grupos"
                  name="numeroDeGrupos"
                  type="number"
                  min="1"
                  step="1"
                  inputmode="numeric"
                />
              </div>
              <div class="org__campo">
                <label for="formato-classificados">
                  Classificados por grupo
                </label>
                <input
                  id="formato-classificados"
                  name="classificadosPorGrupo"
                  type="number"
                  min="1"
                  step="1"
                  inputmode="numeric"
                />
              </div>
            </div>
          </div>

          <button class="org__botao" type="submit" data-salvar-formato>
            Salvar formato
          </button>
          <p class="org__erro" data-erro-formato role="alert"></p>
        </form>
      </section>

      <!-- ============================ SEEDING =========================== -->
      <section class="org__bloco" aria-labelledby="titulo-seeding">
        <h2 class="org__bloco-titulo" id="titulo-seeding">Seeding</h2>
        <p class="org__ajuda">
          O seeding é opcional. Se você não definir posições, ao gerar o
          chaveamento será usado o seeding padrão (ordem alfabética do nome da
          dupla). Para definir manualmente, atribua posições 1…N sem repetir
          nem deixar lacunas.
        </p>

        <form class="org__form" data-form-seeding novalidate>
          <ul class="org__seeding" data-lista-seeding></ul>
          <button class="org__botao" type="submit" data-salvar-seeding>
            Salvar seeding
          </button>
          <p class="org__erro" data-erro-seeding role="alert"></p>
        </form>
      </section>

      <!-- =========================== GERAR ============================== -->
      <section class="org__bloco" aria-labelledby="titulo-gerar">
        <h2 class="org__bloco-titulo" id="titulo-gerar">Chaveamento</h2>

        <div class="org__acoes">
          <button class="org__botao org__botao--primario" type="button" data-gerar>
            Gerar chaveamento
          </button>
          {/* Botão de transição grupos → mata-mata; só habilitado quando todos
              os grupos estão completos (fase de grupos). */}
          <button class="org__botao" type="button" data-gerar-matamata hidden>
            Gerar mata-mata
          </button>
        </div>

        {/* Confirmação de substituição (R4.8/R4.9): só aparece quando já existe
            um chaveamento. Sem "Confirmar", nada é gravado. */}
        <div class="org__confirmar" data-confirmar hidden role="alertdialog" aria-labelledby="confirmar-msg">
          <p class="org__confirmar-msg" id="confirmar-msg">
            Já existe um chaveamento para esta categoria. Gerar novamente vai
            substituí-lo. Deseja continuar?
          </p>
          <div class="org__acoes">
            <button class="org__botao org__botao--perigo" type="button" data-confirmar-sim>
              Confirmar substituição
            </button>
            <button class="org__botao" type="button" data-confirmar-nao>
              Cancelar
            </button>
          </div>
        </div>

        <p class="org__erro" data-erro-gerar role="alert"></p>
      </section>

      <!-- ===================== ESTADO ATUAL / RESULTADOS ================ -->
      <section class="org__bloco" aria-labelledby="titulo-estado">
        <h2 class="org__bloco-titulo" id="titulo-estado">Estado atual</h2>

        {/* Clique direto na dupla dentro de cada jogo registra o vencedor. */}
        {/* Visualização do chaveamento (renderBracketClient). */}
        <div class="org__bracket" data-bracket-slot>
          <p class="org__indisponivel">Nenhum chaveamento gerado ainda.</p>
        </div>
      </section>
    </div>
  </section>
</Layout>

<script>
  // ========================================================================
  // Organização de UMA categoria — toda a interação roda no NAVEGADOR.
  //
  // Importa a lógica de domínio PURA e a store de I/O. É DEFENSIVO: se o
  // Supabase não estiver configurado (ex.: build/preview sem env), a página
  // exibe um aviso e não quebra. Cada operação de I/O passa pelo Result do
  // domínio e traduz DomainError para mensagens amigáveis em português.
  // ========================================================================
  import type { SupabaseClient } from "@supabase/supabase-js";
  import { criarBracketStoreBrowser } from "../../../../store/bracketStore";
  import type {
    BracketStore,
    CategoryRef,
  } from "../../../../store/bracketStore";
  import { renderBracketClient } from "../../../../components/bracket/renderBracketClient";

  import type {
    Bracket,
    BracketConfig,
    DomainError,
    Format,
    Pair,
  } from "../../../../domain/bracket/types";
  import type { Result } from "../../../../domain/result";

  import { validarDuplaCandidata } from "../../../../domain/pairs/validation";
  import {
    exigirFormato,
    validarNumeroDeGrupos,
    validarClassificadosPorGrupo,
  } from "../../../../domain/bracket/config";
  import {
    validarSeeding,
    seedingPadrao,
    type SeedAssignment,
  } from "../../../../domain/bracket/seeding";
  import {
    gerarChaveamento,
    posicionarClassificadosNoMataMata,
    type ClassificadoDoGrupo,
  } from "../../../../domain/bracket/generator";
  import { registrarVencedor } from "../../../../domain/bracket/progression";
  import { numerarJogos } from "../../../../domain/bracket/ordenacao";
  import {
    selecionarClassificados,
    indiceDeSeed,
  } from "../../../../domain/bracket/standings";

  // --------------------------------------------------------------------
  // Tradução de DomainError → mensagem amigável em português (R7/R2/etc.)
  // --------------------------------------------------------------------
  function mensagemErro(erro: DomainError): string {
    switch (erro.code) {
      case "NOME_DUPLA_INVALIDO":
        return "Informe um nome de dupla válido (1 a 80 caracteres).";
      case "NOME_ATLETA_INVALIDO":
        return `Informe um nome válido para o atleta ${erro.qual} (1 a 80 caracteres).`;
      case "NOME_DUPLICADO":
        return "Já existe uma dupla com esse nome nesta categoria.";
      case "REMOCAO_BLOQUEADA":
        return "Não é possível remover duplas depois que o chaveamento foi gerado.";
      case "FORMATO_AUSENTE":
        return "Escolha um formato antes de gerar o chaveamento.";
      case "FORMATO_INVALIDO":
        return "Formato inválido. Escolha 'fase de grupos' ou 'dupla eliminação'.";
      case "GRUPOS_INVALIDO":
        return "Número de grupos inválido (inteiro de 1 até a metade do número de duplas).";
      case "CLASSIFICADOS_INVALIDO":
        return "Número de classificados por grupo inválido (inteiro, de 1 até o tamanho do menor grupo menos 1).";
      case "SEED_DUPLICADO":
        return `A posição de seeding ${erro.posicao} está repetida.`;
      case "SEED_FORA_INTERVALO":
        return `A posição de seeding ${erro.posicao} está fora do intervalo permitido.`;
      case "SEED_LACUNA":
        return `Há uma lacuna no seeding: falta a posição ${erro.posicao}.`;
      case "DUPLAS_INSUFICIENTES":
        return "São necessárias pelo menos 2 duplas para gerar o chaveamento.";
      case "DUPLAS_EXCEDEM_LIMITE":
        return "O número de duplas excede o limite suportado (máximo de 128).";
      case "VENCEDOR_INVALIDO":
        return "A dupla informada não participa deste jogo.";
      case "JOGO_NAO_PRONTO":
        return "Este jogo ainda não está pronto para registro (falta definir uma das duplas).";
      case "FALHA_PERSISTENCIA":
        return "Falha ao salvar. Tente novamente em instantes.";
      case "FALHA_LEITURA":
        return "Falha ao carregar os dados. Tente novamente em instantes.";
      default:
        // Exaustividade: qualquer código novo cai aqui com mensagem genérica.
        return "Ocorreu um erro inesperado.";
    }
  }

  // --------------------------------------------------------------------
  // Helpers de DOM
  // --------------------------------------------------------------------
  function q<T extends HTMLElement>(
    raiz: ParentNode,
    seletor: string,
  ): T | null {
    return raiz.querySelector<T>(seletor);
  }

  function setTexto(el: Element | null, texto: string): void {
    if (el) el.textContent = texto;
  }

  function limparErro(el: Element | null): void {
    setTexto(el, "");
  }

  // Escopo da organização: elementos e estado da página.
  interface Ctx {
    ref: CategoryRef;
    store: BracketStore;
    secao: HTMLElement;
    status: HTMLElement | null;
    // Estado em memória
    duplas: Pair[];
    bracket: Bracket | null;
  }

  // --------------------------------------------------------------------
  // Inicialização
  // --------------------------------------------------------------------
  async function iniciar(): Promise<void> {
    const secao = q<HTMLElement>(document, ".org[data-campeonato-id]");
    if (!secao) return;

    const campeonatoId = secao.dataset.campeonatoId;
    const categoriaNome = secao.dataset.categoriaNome;
    const init = q<HTMLElement>(secao, "[data-init]");
    const conteudo = q<HTMLElement>(secao, "[data-conteudo]");

    if (!campeonatoId || !categoriaNome) {
      setTexto(init, "Categoria inválida.");
      return;
    }

    // Import DINÂMICO do cliente público: `src/lib/supabase.ts` lança se as
    // variáveis de ambiente estiverem ausentes. Capturando aqui, a página não
    // quebra em ambientes sem Supabase (build/preview) — mostra um aviso.
    let supabase: SupabaseClient;
    try {
      const mod = await import("../../../../lib/supabase");
      supabase = mod.supabase;
    } catch {
      setTexto(
        init,
        "Organização indisponível: conexão com o banco não configurada neste ambiente.",
      );
      return;
    }

    // Resolve o id (uuid) da categoria por (campeonato_id, nome). Convenção da
    // página pública [id].astro: o nome é único por campeonato.
    let categoriaId: string;
    try {
      const { data, error } = await supabase
        .from("categorias")
        .select("id")
        .eq("campeonato_id", campeonatoId)
        .eq("nome", categoriaNome)
        .maybeSingle();
      if (error || !data) {
        setTexto(
          init,
          "Categoria ainda não cadastrada no banco. Rode a migração das categorias antes de organizar.",
        );
        return;
      }
      categoriaId = data.id as string;
    } catch {
      setTexto(init, "Falha ao localizar a categoria no banco.");
      return;
    }

    const store = criarBracketStoreBrowser(supabase);
    const ctx: Ctx = {
      ref: { campeonatoId, categoriaId },
      store,
      secao,
      status: q<HTMLElement>(secao, "[data-status]"),
      duplas: [],
      bracket: null,
    };

    // Carrega o estado inicial (duplas + chaveamento) antes de exibir a UI.
    await carregarEstado(ctx);

    // Liga os handlers e revela o conteúdo.
    ligarHandlers(ctx);
    if (init) init.hidden = true;
    if (conteudo) conteudo.hidden = false;
  }

  // --------------------------------------------------------------------
  // Carregamento de estado (duplas + chaveamento) e re-render
  // --------------------------------------------------------------------
  async function carregarEstado(ctx: Ctx): Promise<void> {
    limparErro(ctx.status);

    const duplasRes = await ctx.store.listarDuplas(ctx.ref);
    if (duplasRes.ok) {
      ctx.duplas = duplasRes.valor;
    } else {
      ctx.duplas = [];
      setTexto(ctx.status, mensagemErro(duplasRes.erro));
    }

    const brRes = await ctx.store.carregarChaveamento(ctx.ref);
    if (brRes.ok) {
      ctx.bracket = brRes.valor;
    } else {
      ctx.bracket = null;
      setTexto(ctx.status, mensagemErro(brRes.erro));
    }

    renderTudo(ctx);
  }

  function renderTudo(ctx: Ctx): void {
    renderDuplas(ctx);
    renderSeeding(ctx);
    renderBracket(ctx);
    renderBotaoMataMata(ctx);
  }

  // --------------------------------------------------------------------
  // DUPLAS (R1)
  // --------------------------------------------------------------------
  function renderDuplas(ctx: Ctx): void {
    const lista = q<HTMLElement>(ctx.secao, "[data-lista-duplas]");
    const contagem = q<HTMLElement>(ctx.secao, "[data-contagem-duplas]");
    if (!lista) return;

    setTexto(
      contagem,
      ctx.duplas.length === 0
        ? "Nenhuma dupla cadastrada."
        : `${ctx.duplas.length} dupla(s) cadastrada(s).`,
    );

    lista.replaceChildren();
    // Já existe chaveamento? A remoção fica bloqueada (R1.6) — escondemos o
    // botão de remover e avisamos.
    const temBracket = ctx.bracket !== null;

    for (const dupla of ctx.duplas) {
      const li = document.createElement("li");
      li.className = "org__dupla";

      const info = document.createElement("div");
      info.className = "org__dupla-info";
      const nome = document.createElement("span");
      nome.className = "org__dupla-nome";
      nome.textContent = dupla.nomeDupla;
      const atletas = document.createElement("span");
      atletas.className = "org__dupla-atletas";
      atletas.textContent = `${dupla.atletaA} / ${dupla.atletaB}`;
      info.append(nome, atletas);
      li.append(info);

      if (!temBracket) {
        const remover = document.createElement("button");
        remover.type = "button";
        remover.className = "org__remover";
        remover.textContent = "Remover";
        remover.setAttribute(
          "aria-label",
          `Remover dupla ${dupla.nomeDupla}`,
        );
        remover.addEventListener("click", () => void removerDupla(ctx, dupla));
        li.append(remover);
      }

      lista.append(li);
    }
  }

  async function adicionarDupla(ctx: Ctx): Promise<void> {
    const form = q<HTMLFormElement>(ctx.secao, "[data-form-dupla]");
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-dupla]");
    if (!form) return;
    limparErro(erro);

    const dados = {
      nomeDupla: (q<HTMLInputElement>(form, "#dupla-nome")?.value ?? ""),
      atletaA: (q<HTMLInputElement>(form, "#dupla-atleta-a")?.value ?? ""),
      atletaB: (q<HTMLInputElement>(form, "#dupla-atleta-b")?.value ?? ""),
    };

    // Validação de domínio ANTES de qualquer I/O (R1.2–R1.4). A store também
    // revalida contra o banco (unicidade), mas validar aqui dá feedback rápido.
    const nomesExistentes = ctx.duplas.map((d) => d.nomeDupla);
    const validada = validarDuplaCandidata(dados, nomesExistentes);
    if (!validada.ok) {
      setTexto(erro, mensagemErro(validada.erro));
      return;
    }

    const res = await ctx.store.adicionarDupla(ctx.ref, dados);
    if (!res.ok) {
      setTexto(erro, mensagemErro(res.erro));
      return;
    }

    form.reset();
    await carregarEstado(ctx);
    q<HTMLInputElement>(form, "#dupla-nome")?.focus();
  }

  async function removerDupla(ctx: Ctx, dupla: Pair): Promise<void> {
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-dupla]");
    limparErro(erro);
    const res = await ctx.store.removerDupla(dupla.id);
    if (!res.ok) {
      setTexto(erro, mensagemErro(res.erro));
      return;
    }
    await carregarEstado(ctx);
  }

  // --------------------------------------------------------------------
  // FORMATO (R2)
  // --------------------------------------------------------------------
  function formatoSelecionado(ctx: Ctx): string | null {
    const marcado = q<HTMLInputElement>(
      ctx.secao,
      "input[name='formato']:checked",
    );
    return marcado?.value ?? null;
  }

  function atualizarVisibilidadeGrupos(ctx: Ctx): void {
    const params = q<HTMLElement>(ctx.secao, "[data-grupos-params]");
    if (!params) return;
    params.hidden = formatoSelecionado(ctx) !== "fase de grupos";
  }

  async function salvarFormato(ctx: Ctx): Promise<void> {
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-formato]");
    limparErro(erro);

    const formatoRes = exigirFormato(formatoSelecionado(ctx));
    if (!formatoRes.ok) {
      setTexto(erro, mensagemErro(formatoRes.erro));
      return;
    }
    const formato: Format = formatoRes.valor;

    const config: BracketConfig = { formato };

    if (formato === "fase de grupos") {
      const n = ctx.duplas.length;
      const gInput = q<HTMLInputElement>(ctx.secao, "#formato-grupos");
      const cInput = q<HTMLInputElement>(ctx.secao, "#formato-classificados");
      const g = Number(gInput?.value);
      const c = Number(cInput?.value);

      const gRes = validarNumeroDeGrupos(g, n);
      if (!gRes.ok) {
        setTexto(erro, mensagemErro(gRes.erro));
        return;
      }
      const cRes = validarClassificadosPorGrupo(c, n, gRes.valor);
      if (!cRes.ok) {
        setTexto(erro, mensagemErro(cRes.erro));
        return;
      }
      config.numeroDeGrupos = gRes.valor;
      config.classificadosPorGrupo = cRes.valor;
    }

    const res = await ctx.store.salvarConfig(ctx.ref, config);
    if (!res.ok) {
      setTexto(erro, mensagemErro(res.erro));
      return;
    }
    setTexto(ctx.status, "Formato salvo.");
  }

  // --------------------------------------------------------------------
  // SEEDING (R3)
  // --------------------------------------------------------------------
  function renderSeeding(ctx: Ctx): void {
    const lista = q<HTMLElement>(ctx.secao, "[data-lista-seeding]");
    if (!lista) return;
    lista.replaceChildren();

    if (ctx.duplas.length === 0) {
      const vazio = document.createElement("li");
      vazio.className = "org__seeding-vazio";
      vazio.textContent = "Cadastre duplas para definir o seeding.";
      lista.append(vazio);
      return;
    }

    for (const dupla of ctx.duplas) {
      const li = document.createElement("li");
      li.className = "org__seeding-item";

      const label = document.createElement("label");
      label.className = "org__seeding-label";
      label.textContent = dupla.nomeDupla;
      const inputId = `seed-${dupla.id}`;
      label.htmlFor = inputId;

      const input = document.createElement("input");
      input.id = inputId;
      input.type = "number";
      input.min = "1";
      input.step = "1";
      input.inputMode = "numeric";
      input.className = "org__seeding-input";
      input.dataset.pairId = dupla.id;
      // Preenche com o seed atual quando já definido (>0).
      if (dupla.seed && dupla.seed > 0) input.value = String(dupla.seed);

      li.append(label, input);
      lista.append(li);
    }
  }

  async function salvarSeeding(ctx: Ctx): Promise<void> {
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-seeding]");
    limparErro(erro);

    const inputs = Array.from(
      ctx.secao.querySelectorAll<HTMLInputElement>(".org__seeding-input"),
    );
    const seeds: SeedAssignment[] = inputs.map((input) => ({
      pairId: input.dataset.pairId ?? "",
      posicao: Number(input.value),
    }));

    const valido = validarSeeding(seeds, ctx.duplas.length);
    if (!valido.ok) {
      setTexto(erro, mensagemErro(valido.erro));
      return;
    }

    const res = await ctx.store.salvarSeeding(ctx.ref, valido.valor);
    if (!res.ok) {
      setTexto(erro, mensagemErro(res.erro));
      return;
    }
    setTexto(ctx.status, "Seeding salvo.");
    await carregarEstado(ctx);
  }

  // --------------------------------------------------------------------
  // GERAR (R4) — com confirmação de substituição (R4.8/R4.9)
  // --------------------------------------------------------------------

  /**
   * Monta a lista de duplas com seeding RESOLVIDO para alimentar o gerador:
   * usa o seed salvo em cada dupla quando TODAS têm seed válido (1..N); caso
   * contrário aplica o seeding padrão alfabético (R3.4).
   */
  function duplasComSeeding(ctx: Ctx): Pair[] {
    const n = ctx.duplas.length;
    const todasComSeed = ctx.duplas.every(
      (d) => Number.isInteger(d.seed) && d.seed >= 1 && d.seed <= n,
    );
    // Também exige que o conjunto de seeds seja exatamente {1..N}.
    const seedsOk =
      todasComSeed &&
      new Set(ctx.duplas.map((d) => d.seed)).size === n;

    if (seedsOk) {
      return ctx.duplas.map((d) => ({ ...d }));
    }

    const padrao = seedingPadrao(ctx.duplas);
    const posicaoPorId = new Map(padrao.map((s) => [s.pairId, s.posicao]));
    return ctx.duplas.map((d) => ({
      ...d,
      seed: posicaoPorId.get(d.id) ?? d.seed,
    }));
  }

  /**
   * Lê o formato a partir do que está marcado na UI OU do chaveamento/estado
   * existente. Exige um formato (R2.7). Para "fase de grupos", valida os
   * parâmetros contra o número de duplas.
   */
  function resolverConfigParaGerar(ctx: Ctx): Result<BracketConfig> {
    const n = ctx.duplas.length;

    const formatoRes = exigirFormato(formatoSelecionado(ctx));
    if (!formatoRes.ok) return { ok: false, erro: formatoRes.erro };
    const formato = formatoRes.valor;

    const config: BracketConfig = { formato };
    if (formato === "fase de grupos") {
      const g = Number(
        q<HTMLInputElement>(ctx.secao, "#formato-grupos")?.value,
      );
      const c = Number(
        q<HTMLInputElement>(ctx.secao, "#formato-classificados")?.value,
      );
      const gRes = validarNumeroDeGrupos(g, n);
      if (!gRes.ok) return { ok: false, erro: gRes.erro };
      const cRes = validarClassificadosPorGrupo(c, n, gRes.valor);
      if (!cRes.ok) return { ok: false, erro: cRes.erro };
      config.numeroDeGrupos = gRes.valor;
      config.classificadosPorGrupo = cRes.valor;
    }
    return { ok: true, valor: config };
  }

  async function clicarGerar(ctx: Ctx): Promise<void> {
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-gerar]");
    limparErro(erro);

    // Se já existe chaveamento, NÃO gera direto: exige confirmação explícita
    // (R4.8). Enquanto não confirmar, nada é gravado (R4.9).
    if (ctx.bracket !== null) {
      const confirmar = q<HTMLElement>(ctx.secao, "[data-confirmar]");
      if (confirmar) confirmar.hidden = false;
      return;
    }

    await gerarEffetivo(ctx);
  }

  async function gerarEffetivo(ctx: Ctx): Promise<void> {
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-gerar]");
    limparErro(erro);

    const configRes = resolverConfigParaGerar(ctx);
    if (!configRes.ok) {
      setTexto(erro, mensagemErro(configRes.erro));
      return;
    }

    const duplas = duplasComSeeding(ctx);
    const gen = gerarChaveamento({ duplas, config: configRes.valor });
    if (!gen.ok) {
      setTexto(erro, mensagemErro(gen.erro));
      return;
    }

    // Preenche os identificadores do par (campeonato, categoria) e já numera os
    // jogos elegíveis (ordem de disputa) antes de persistir.
    const bracket: Bracket = numerarJogos({
      ...gen.bracket,
      campeonatoId: ctx.ref.campeonatoId,
      categoriaId: ctx.ref.categoriaId,
    });

    const res = await ctx.store.salvarChaveamento(ctx.ref, bracket);
    if (!res.ok) {
      setTexto(erro, mensagemErro(res.erro));
      return;
    }

    setTexto(ctx.status, "Chaveamento gerado e salvo.");
    await carregarEstado(ctx);
  }

  // --------------------------------------------------------------------
  // GERAR MATA-MATA (transição grupos → mata-mata, R5.4/R5.5/R5.6)
  // --------------------------------------------------------------------

  /** Verdadeiro sse o bracket atual é de fase de grupos com todos os grupos
   *  completos (todos os jogos de grupo têm vencedor). */
  function gruposTodosCompletos(bracket: Bracket): boolean {
    if (bracket.formato !== "fase de grupos") return false;
    if (bracket.grupos.length === 0) return false;
    const jogosGrupo = bracket.matches.filter((m) => m.side === "grupo");
    if (jogosGrupo.length === 0) return false;
    return jogosGrupo.every((m) => m.vencedorId !== null);
  }

  /** Verdadeiro sse o mata-mata já foi gerado (há jogos fora de "grupo"). */
  function temMataMata(bracket: Bracket): boolean {
    return bracket.matches.some((m) => m.side !== "grupo");
  }

  function renderBotaoMataMata(ctx: Ctx): void {
    const botao = q<HTMLButtonElement>(ctx.secao, "[data-gerar-matamata]");
    if (!botao) return;
    const mostrar =
      ctx.bracket !== null &&
      gruposTodosCompletos(ctx.bracket) &&
      !temMataMata(ctx.bracket);
    botao.hidden = !mostrar;
  }

  async function gerarMataMata(ctx: Ctx): Promise<void> {
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-gerar]");
    limparErro(erro);
    const bracket = ctx.bracket;
    if (!bracket || !gruposTodosCompletos(bracket)) return;

    const classificadosPorGrupo = bracket.config.classificadosPorGrupo ?? 1;
    const seedIndex = indiceDeSeed(bracket.duplas);
    const duplaPorId = new Map(bracket.duplas.map((d) => [d.id, d]));

    // Monta a lista de classificados (dupla + grupo + posição) para posicionar.
    const classificados: ClassificadoDoGrupo[] = [];
    for (const grupo of bracket.grupos) {
      const top = selecionarClassificados(
        grupo,
        bracket.matches,
        seedIndex,
        classificadosPorGrupo,
      );
      if (top === null) {
        setTexto(erro, "A fase de grupos ainda não está completa.");
        return;
      }
      for (const standing of top) {
        const pair = duplaPorId.get(standing.pairId);
        if (!pair) continue;
        classificados.push({
          pair,
          grupoId: grupo.id,
          posicaoNoGrupo: standing.posicao,
        });
      }
    }

    const pos = posicionarClassificadosNoMataMata(
      classificados,
      bracket.config,
    );
    if (!pos.ok) {
      setTexto(erro, mensagemErro(pos.erro));
      return;
    }

    // O mata-mata gerado é um bracket independente; mesclamos os jogos/duplas
    // do mata-mata ao bracket de grupos existente, preservando os jogos de
    // grupo e seus resultados.
    const mataMata = pos.bracket;
    const jogosGrupo = bracket.matches.filter((m) => m.side === "grupo");
    const jogosMataMata = mataMata.matches.filter((m) => m.side !== "grupo");

    // União das duplas (snapshot): grupos + classificados (sem duplicar por id).
    const duplasUnidas = new Map<string, Pair>();
    for (const d of bracket.duplas) duplasUnidas.set(d.id, d);
    for (const d of mataMata.duplas) duplasUnidas.set(d.id, { ...d });

    const combinado: Bracket = numerarJogos({
      ...bracket,
      duplas: Array.from(duplasUnidas.values()),
      matches: [...jogosGrupo, ...jogosMataMata],
    });

    const res = await ctx.store.salvarChaveamento(ctx.ref, combinado);
    if (!res.ok) {
      setTexto(erro, mensagemErro(res.erro));
      return;
    }
    setTexto(ctx.status, "Mata-mata gerado a partir dos classificados.");
    await carregarEstado(ctx);
  }

  // --------------------------------------------------------------------
  // REGISTRAR RESULTADOS (R6) — para cada jogo pronto (sem bye, ambas as duplas)
  // --------------------------------------------------------------------
  function nomeDupla(bracket: Bracket, pairId: string | null): string {
    if (!pairId) return "(indefinida)";
    const d = bracket.duplas.find((x) => x.id === pairId);
    return d ? d.nomeDupla : "(indefinida)";
  }

  async function registrarResultado(
    ctx: Ctx,
    matchId: string,
    vencedorId: string,
  ): Promise<void> {
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-gerar]");
    limparErro(erro);
    const bracket = ctx.bracket;
    if (!bracket) return;

    // Progressão PURA: produz um novo bracket (avanço + cascata). `agora` é
    // injetado na borda para manter a função pura (R6.1).
    const res = registrarVencedor(
      bracket,
      matchId,
      vencedorId,
      new Date().toISOString(),
    );
    if (!res.ok) {
      setTexto(ctx.status, mensagemErro(res.erro));
      return;
    }

    // Numera os jogos que passaram a ser elegíveis com este resultado (ex.: a
    // próxima rodada do mata-mata cujas duplas acabaram de ser definidas). Os
    // já numerados permanecem estáveis.
    const numerado = numerarJogos(res.bracket);
    const salvo = await ctx.store.salvarChaveamento(ctx.ref, numerado);
    if (!salvo.ok) {
      setTexto(ctx.status, mensagemErro(salvo.erro));
      return;
    }
    setTexto(ctx.status, "Resultado registrado.");
    await carregarEstado(ctx);
  }

  // --------------------------------------------------------------------
  // VISUALIZAÇÃO do estado atual (renderBracketClient)
  // --------------------------------------------------------------------
  function renderBracket(ctx: Ctx): void {
    const slot = q<HTMLElement>(ctx.secao, "[data-bracket-slot]");
    if (!slot) return;

    if (!ctx.bracket) {
      const vazio = document.createElement("p");
      vazio.className = "org__indisponivel";
      vazio.textContent = "Nenhum chaveamento gerado ainda.";
      slot.replaceChildren(vazio);
      return;
    }

    try {
      // Clique direto na dupla para registrar o vencedor (R6). Pede confirmação
      // antes de salvar (clique único + confirmação). A lógica de registro/
      // correção/cascata e persistência está em `registrarResultado`.
      const view = renderBracketClient(ctx.bracket, {
        aoEscolherVencedor: (matchId, pairId) => {
          const nome = nomeDupla(ctx.bracket!, pairId);
          const ok = window.confirm(
            `Confirmar ${nome} como vencedora deste jogo?`,
          );
          if (!ok) return;
          void registrarResultado(ctx, matchId, pairId);
        },
      });
      slot.replaceChildren(view);
    } catch {
      const err = document.createElement("p");
      err.className = "org__indisponivel";
      err.textContent = "Não foi possível exibir o chaveamento.";
      slot.replaceChildren(err);
    }
  }

  // --------------------------------------------------------------------
  // Ligação de handlers
  // --------------------------------------------------------------------
  function ligarHandlers(ctx: Ctx): void {
    // Duplas
    const formDupla = q<HTMLFormElement>(ctx.secao, "[data-form-dupla]");
    formDupla?.addEventListener("submit", (e) => {
      e.preventDefault();
      void adicionarDupla(ctx);
    });

    // Formato: mostra/esconde parâmetros de grupos ao trocar o radio.
    for (const radio of Array.from(
      ctx.secao.querySelectorAll<HTMLInputElement>("[data-formato]"),
    )) {
      radio.addEventListener("change", () => atualizarVisibilidadeGrupos(ctx));
    }
    atualizarVisibilidadeGrupos(ctx);

    const formFormato = q<HTMLFormElement>(ctx.secao, "[data-form-formato]");
    formFormato?.addEventListener("submit", (e) => {
      e.preventDefault();
      void salvarFormato(ctx);
    });

    // Seeding
    const formSeeding = q<HTMLFormElement>(ctx.secao, "[data-form-seeding]");
    formSeeding?.addEventListener("submit", (e) => {
      e.preventDefault();
      void salvarSeeding(ctx);
    });

    // Gerar
    q<HTMLButtonElement>(ctx.secao, "[data-gerar]")?.addEventListener(
      "click",
      () => void clicarGerar(ctx),
    );

    // Gerar mata-mata
    q<HTMLButtonElement>(ctx.secao, "[data-gerar-matamata]")?.addEventListener(
      "click",
      () => void gerarMataMata(ctx),
    );

    // Confirmação de substituição (R4.8/R4.9)
    q<HTMLButtonElement>(ctx.secao, "[data-confirmar-sim]")?.addEventListener(
      "click",
      () => {
        const confirmar = q<HTMLElement>(ctx.secao, "[data-confirmar]");
        if (confirmar) confirmar.hidden = true;
        void gerarEffetivo(ctx);
      },
    );
    q<HTMLButtonElement>(ctx.secao, "[data-confirmar-nao]")?.addEventListener(
      "click",
      () => {
        // Cancela: nada é gravado (R4.9); apenas fecha o painel.
        const confirmar = q<HTMLElement>(ctx.secao, "[data-confirmar]");
        if (confirmar) confirmar.hidden = true;
        setTexto(ctx.status, "Substituição cancelada. Nada foi alterado.");
      },
    );
  }

  iniciar();
</script>

