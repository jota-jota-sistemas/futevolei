---
import type { Campeonato } from "../../../../types";
import campeonatosData from "../../../../data/campeonatos.json";
import Layout from "../../../../layouts/Layout.astro";
import GuardaAcesso from "../../../../components/GuardaAcesso.astro";
import { comBase, slugCategoria } from "../../../../utils/url";

/**
 * Página de ORGANIZAÇÃO de UMA categoria (R9.1): gerencia duplas, configura o
 * formato, define o seeding, gera o chaveamento e registra resultados — tudo
 * POR CATEGORIA, de forma independente das demais categorias do campeonato.
 *
 * ## Arquitetura estática + organização no navegador
 *
 * O site é `output: "static"` (ver astro.config.mjs). Esta rota é
 * PRÉ-RENDERIDA em build a partir do JSON `src/data/campeonatos.json`: o
 * `getStaticPaths()` emite uma página para cada par (campeonato, categoria),
 * usando o SLUG estável do nome da categoria (`slugCategoria`, a mesma
 * convenção da 18.1). O `id` (uuid) real da categoria vive no Supabase; ele é
 * resolvido em RUNTIME, no navegador, por (campeonato_id, nome) na tabela
 * `categorias` (mesma convenção de resolução da página pública [id].astro).
 *
 * Toda a INTERAÇÃO de organização é client-side (o `<script>` abaixo). Ela:
 *   - usa a lógica de domínio PURA (validação de duplas/formato/seeding,
 *     geração, progressão, serialização) de `src/domain/...`;
 *   - persiste/lê via `criarBracketStoreBrowser(supabase)` de
 *     `src/store/bracketStore.ts` (cliente público com RLS);
 *   - reutiliza `renderBracketClient` para exibir o estado atual do chaveamento.
 *
 * Esta rota NÃO é linkada publicamente e só administradores logados a usam
 * (GuardaAcesso + RLS com eh_admin()). Como o ambiente de build não tem Supabase real, o script é
 * DEFENSIVO (try/catch): sem Supabase a página apenas mostra avisos e não
 * quebra a geração estática.
 *
 * ## Escopo do "gerar" (decisão documentada)
 *
 * O botão "Gerar chaveamento" cria a ESTRUTURA INICIAL do chaveamento da
 * categoria, chamando o domínio puro `gerarChaveamento`:
 *   - "dupla eliminação" → gera o mata-mata completo (upper/lower/grande final);
 *   - "fase de grupos"  → gera a FASE DE GRUPOS (grupos + round-robin).
 *
 * A TRANSIÇÃO grupos → mata-mata (posicionar os classificados) NÃO é feita no
 * "gerar". Ela depende dos resultados dos jogos de grupo e fica num passo
 * SEPARADO: quando todos os grupos estão completos, aparece o botão "Gerar
 * mata-mata", que usa `selecionarClassificados` + `posicionarClassificadosNoMataMata`
 * e re-salva o chaveamento (mantendo o fluxo simples e explícito).
 */
export function getStaticPaths() {
  const lista = campeonatosData as Campeonato[];
  const paths: Array<{
    params: { id: string; categoria: string };
    props: { campeonato: Campeonato; categoriaNome: string };
  }> = [];

  for (const campeonato of lista) {
    const categorias = campeonato.categorias ?? [];
    for (const categoriaNome of categorias) {
      paths.push({
        params: { id: campeonato.id, categoria: slugCategoria(categoriaNome) },
        props: { campeonato, categoriaNome },
      });
    }
  }

  return paths;
}

interface Props {
  campeonato: Campeonato;
  categoriaNome: string;
}

const { campeonato, categoriaNome } = Astro.props;
---

<Layout
  titulo={`Organizar ${categoriaNome} — ${campeonato.nome}`}
  descricao={`Organização da categoria ${categoriaNome} do campeonato ${campeonato.nome}.`}
  noindex
>
  <GuardaAcesso>
  <section
    class="org"
    data-campeonato-id={campeonato.id}
    data-categoria-nome={categoriaNome}
  >
    <a
      class="org__voltar"
      href={comBase(`/campeonatos/${campeonato.id}/organizar`)}
    >
      <span aria-hidden="true">←</span> Voltar às categorias
    </a>

    <header class="org__cabecalho">
      <p class="org__rotulo">Organização da categoria</p>
      <h1 class="org__titulo">{categoriaNome}</h1>
      <p class="org__subtitulo">{campeonato.nome}</p>
    </header>

    {/* Faixa de status/erros global da página (persistência, carregamento). */}
    <p class="org__status" data-status role="status" aria-live="polite"></p>

    {/* Estado de inicialização: trocado pelo script quando pronto/indisponível. */}
    <p class="org__init" data-init role="status">Carregando organização…</p>

    {/* Conteúdo de organização, oculto até o script conseguir inicializar. */}
    <div class="org__conteudo" data-conteudo hidden>
      <!-- ============================ DUPLAS ============================ -->
      <section class="org__bloco" aria-labelledby="titulo-duplas">
        <h2 class="org__bloco-titulo" id="titulo-duplas">Duplas</h2>

        <form class="org__form" data-form-dupla novalidate>
          <div class="org__linha">
            <div class="org__campo">
              <label for="dupla-atleta-a">Atleta A</label>
              <input
                id="dupla-atleta-a"
                name="atletaA"
                type="text"
                autocomplete="off"
                maxlength="80"
                required
              />
              <div class="org__vinculo" data-vinculo hidden>
                <label for="dupla-jogador-a">Jogador cadastrado (opcional)</label>
                <select id="dupla-jogador-a" data-jogador-a>
                  <option value="">Não vincular</option>
                </select>
              </div>
            </div>
            <div class="org__campo">
              <label for="dupla-atleta-b">Atleta B</label>
              <input
                id="dupla-atleta-b"
                name="atletaB"
                type="text"
                autocomplete="off"
                maxlength="80"
                required
              />
              <div class="org__vinculo" data-vinculo hidden>
                <label for="dupla-jogador-b">Jogador cadastrado (opcional)</label>
                <select id="dupla-jogador-b" data-jogador-b>
                  <option value="">Não vincular</option>
                </select>
                <p class="org__vinculo-ajuda">
                  Vincular registra a dupla no histórico do jogador.
                </p>
              </div>
            </div>
          </div>
          <button class="org__botao" type="submit" data-add-dupla>
            Adicionar dupla
          </button>
          <p class="org__erro" data-erro-dupla role="alert"></p>
        </form>

        <p class="org__contagem" data-contagem-duplas></p>
        <ul class="org__duplas" data-lista-duplas></ul>
      </section>

      <!-- ============================ FORMATO =========================== -->
      <section class="org__bloco" aria-labelledby="titulo-formato">
        <h2 class="org__bloco-titulo" id="titulo-formato">Formato</h2>

        <form class="org__form" data-form-formato novalidate>
          <fieldset class="org__fieldset">
            <legend>Escolha o formato do chaveamento</legend>
            <label class="org__radio">
              <input
                type="radio"
                name="formato"
                value="eliminação simples"
                data-formato
              />
              <span>Eliminação simples</span>
            </label>
            <label class="org__radio">
              <input
                type="radio"
                name="formato"
                value="dupla eliminação"
                data-formato
              />
              <span>Dupla eliminação</span>
            </label>
            <label class="org__radio">
              <input
                type="radio"
                name="formato"
                value="fase de grupos"
                data-formato
              />
              <span>Fase de grupos</span>
            </label>
          </fieldset>

          {/* Parâmetros exclusivos da fase de grupos. */}
          <div class="org__grupos-params" data-grupos-params hidden>
            <div class="org__linha">
              <div class="org__campo">
                <label for="formato-grupos">Número de grupos</label>
                <input
                  id="formato-grupos"
                  name="numeroDeGrupos"
                  type="number"
                  min="1"
                  step="1"
                  inputmode="numeric"
                />
              </div>
              <div class="org__campo">
                <label for="formato-classificados">
                  Classificados por grupo
                </label>
                <input
                  id="formato-classificados"
                  name="classificadosPorGrupo"
                  type="number"
                  min="1"
                  step="1"
                  inputmode="numeric"
                />
              </div>
            </div>
          </div>

          <button class="org__botao" type="submit" data-salvar-formato>
            Salvar formato
          </button>
          <p class="org__erro" data-erro-formato role="alert"></p>
        </form>
      </section>

      <!-- =========================== NIVELADOR ========================= -->
      <section class="org__bloco" aria-labelledby="titulo-seeding">
        <h2 class="org__bloco-titulo" id="titulo-seeding">Nivelador</h2>
        <p class="org__ajuda">
          O nivelador equilibra grupos e chaves, evitando que as melhores
          duplas se enfrentem cedo. Se você não quiser usar, as duplas entram
          em ordem aleatória a cada vez que o chaveamento é gerado.
        </p>

        <label class="org__opcao">
          <input type="checkbox" data-usar-nivelador />
          Quero definir o nivelador (ordem de força das duplas)
        </label>

        <form class="org__form" data-form-seeding data-nivelador-conteudo hidden novalidate>
          <p class="org__ajuda">
            Ordene da dupla mais forte (topo) para a mais fraca. Já vem em ordem
            alfabética: arraste os cards para reordenar (ou use as setas) e
            clique em salvar.
          </p>
          <ol class="org__nivelador" data-lista-seeding></ol>
          <button class="org__botao" type="submit" data-salvar-seeding>
            Salvar nivelador
          </button>
          <p class="org__erro" data-erro-seeding role="alert"></p>
        </form>
      </section>

      <!-- =========================== GERAR ============================== -->
      <section class="org__bloco" aria-labelledby="titulo-gerar">
        <h2 class="org__bloco-titulo" id="titulo-gerar">Chaveamento</h2>

        <div class="org__acoes">
          <button class="org__botao org__botao--primario" type="button" data-gerar>
            Gerar chaveamento
          </button>
          {/* Botão de transição grupos → mata-mata; só habilitado quando todos
              os grupos estão completos (fase de grupos). */}
          <button class="org__botao" type="button" data-gerar-matamata hidden>
            Gerar mata-mata
          </button>
        </div>

        {/* Confirmação de substituição (R4.8/R4.9): só aparece quando já existe
            um chaveamento. Sem "Confirmar", nada é gravado. */}
        <div class="org__confirmar" data-confirmar hidden role="alertdialog" aria-labelledby="confirmar-msg">
          <p class="org__confirmar-msg" id="confirmar-msg">
            Já existe um chaveamento para esta categoria. Gerar novamente vai
            substituí-lo. Deseja continuar?
          </p>
          <div class="org__acoes">
            <button class="org__botao org__botao--perigo" type="button" data-confirmar-sim>
              Confirmar substituição
            </button>
            <button class="org__botao" type="button" data-confirmar-nao>
              Cancelar
            </button>
          </div>
        </div>

        <p class="org__erro" data-erro-gerar role="alert"></p>
      </section>

      <!-- ===================== ESTADO ATUAL / RESULTADOS ================ -->
      <section class="org__bloco" aria-labelledby="titulo-estado">
        <h2 class="org__bloco-titulo" id="titulo-estado">Estado atual</h2>

        <div class="org__acoes">
          <button class="org__botao" type="button" data-tela-cheia hidden>
            ⛶ Tela cheia
          </button>
        </div>

        {/* Clique direto na dupla dentro de cada jogo registra o vencedor. */}
        {/* Visualização do chaveamento (renderBracketClient). */}
        <div class="org__bracket" data-bracket-slot>
          <p class="org__indisponivel">Nenhum chaveamento gerado ainda.</p>
        </div>
      </section>
    </div>
  </section>
  </GuardaAcesso>
</Layout>

<script>
  // ========================================================================
  // Organização de UMA categoria — toda a interação roda no NAVEGADOR.
  //
  // Importa a lógica de domínio PURA e a store de I/O. É DEFENSIVO: se o
  // Supabase não estiver configurado (ex.: build/preview sem env), a página
  // exibe um aviso e não quebra. Cada operação de I/O passa pelo Result do
  // domínio e traduz DomainError para mensagens amigáveis em português.
  // ========================================================================
  import type { SupabaseClient } from "@supabase/supabase-js";
  import { criarBracketStoreBrowser } from "../../../../store/bracketStore";
  import { criarJogadorStoreBrowser } from "../../../../store/jogadorStore";
  import { criarAuthStoreBrowser } from "../../../../store/authStore";
  import { guardarAcesso } from "../../../../scripts/guarda";
  import {
    ligarSeletoresDeJogador,
    type SeletorJogadores,
  } from "../../../../scripts/seletor-jogador";
  import type {
    BracketStore,
    CategoryRef,
  } from "../../../../store/bracketStore";
  import { renderBracketClient } from "../../../../components/bracket/renderBracketClient";

  import type {
    Bracket,
    BracketConfig,
    DomainError,
    Format,
    Pair,
  } from "../../../../domain/bracket/types";
  import type { Result } from "../../../../domain/result";

  import { validarDuplaCandidata } from "../../../../domain/pairs/validation";
  import {
    exigirFormato,
    validarNumeroDeGrupos,
    validarClassificadosPorGrupo,
  } from "../../../../domain/bracket/config";
  import {
    validarSeeding,
    seedingPadrao,
    seedingAleatorio,
    type SeedAssignment,
  } from "../../../../domain/bracket/seeding";
  import {
    gerarChaveamento,
    posicionarClassificadosNoMataMata,
    type ClassificadoDoGrupo,
  } from "../../../../domain/bracket/generator";
  import { rotuloDupla, gerarNomeDupla } from "../../../../domain/pairs/nome";
  import { abrirTelaChaveamento, type TelaChaveamento } from "../../../../components/bracket/telaChaveamento";
  import { abrirTelaJogo, type TelaJogo } from "../../../../components/bracket/telaJogo";
  import { registrarPlacar, atualizarPlacarAoVivo } from "../../../../domain/bracket/progression";
  import { numerarJogos } from "../../../../domain/bracket/ordenacao";
  import { jogosAlterados } from "../../../../domain/bracket/diff";
  import { selecionarClassificados } from "../../../../domain/bracket/standings";

  // --------------------------------------------------------------------
  // Tradução de DomainError → mensagem amigável em português (R7/R2/etc.)
  // --------------------------------------------------------------------
  function mensagemErro(erro: DomainError): string {
    switch (erro.code) {
      case "NOME_DUPLA_INVALIDO":
        return "Informe um nome de dupla válido (1 a 80 caracteres).";
      case "NOME_ATLETA_INVALIDO":
        return `Informe um nome válido para o atleta ${erro.qual} (1 a 80 caracteres).`;
      case "NOME_DUPLICADO":
        return "Já existe uma dupla com esse nome nesta categoria.";
      case "REMOCAO_BLOQUEADA":
        return "Não é possível remover duplas depois que o chaveamento foi gerado.";
      case "FORMATO_AUSENTE":
        return "Escolha um formato antes de gerar o chaveamento.";
      case "FORMATO_INVALIDO":
        return "Formato inválido. Escolha 'fase de grupos' ou 'dupla eliminação'.";
      case "GRUPOS_INVALIDO":
        return "Número de grupos inválido (inteiro de 1 até a metade do número de duplas).";
      case "CLASSIFICADOS_INVALIDO":
        return "Número de classificados por grupo inválido (inteiro, de 1 até o tamanho do menor grupo menos 1).";
      case "SEED_DUPLICADO":
        return `A posição do nivelador ${erro.posicao} está repetida.`;
      case "SEED_FORA_INTERVALO":
        return `A posição do nivelador ${erro.posicao} está fora do intervalo permitido.`;
      case "SEED_LACUNA":
        return `Há uma lacuna no nivelador: falta a posição ${erro.posicao}.`;
      case "DUPLAS_INSUFICIENTES":
        return "São necessárias pelo menos 2 duplas para gerar o chaveamento.";
      case "DUPLAS_EXCEDEM_LIMITE":
        return "O número de duplas excede o limite suportado (máximo de 128).";
      case "VENCEDOR_INVALIDO":
        return "A dupla informada não participa deste jogo.";
      case "JOGO_NAO_PRONTO":
        return "Este jogo ainda não está pronto para registro (falta definir uma das duplas).";
      case "PLACAR_INVALIDO":
        return "Informe placares inteiros, 0 ou maior.";
      case "PLACAR_EMPATE":
        return "Não há empate: um dos placares deve ser maior.";
      case "JOGO_ENCERRADO":
        return "Este jogo já foi encerrado.";
      case "FALHA_PERSISTENCIA":
        return "Falha ao salvar. Tente novamente em instantes.";
      case "FALHA_LEITURA":
        return "Falha ao carregar os dados. Tente novamente em instantes.";
      default:
        // Exaustividade: qualquer código novo cai aqui com mensagem genérica.
        return "Ocorreu um erro inesperado.";
    }
  }

  // --------------------------------------------------------------------
  // Helpers de DOM
  // --------------------------------------------------------------------
  function q<T extends HTMLElement>(
    raiz: ParentNode,
    seletor: string,
  ): T | null {
    return raiz.querySelector<T>(seletor);
  }

  function setTexto(el: Element | null, texto: string): void {
    if (el) el.textContent = texto;
  }

  function limparErro(el: Element | null): void {
    setTexto(el, "");
  }

  // Escopo da organização: elementos e estado da página.
  interface Ctx {
    ref: CategoryRef;
    store: BracketStore;
    secao: HTMLElement;
    status: HTMLElement | null;
    // Estado em memória
    duplas: Pair[];
    bracket: Bracket | null;
    // Gravações de placar em andamento; enquanto houver, não relê o chaveamento
    // (evita sobrescrever a tela com dados ainda não gravados).
    salvando: number;
    recarregarDepois: boolean;
    // Telas cheias abertas (chaveamento completo / um jogo): acompanham as
    // atualizações do chaveamento.
    telaChaveamento: TelaChaveamento | null;
    telaJogo: TelaJogo | null;
    // Seletores opcionais de jogador cadastrado (null = indisponível; o
    // formulário segue só com texto).
    seletor: SeletorJogadores | null;
  }

  // --------------------------------------------------------------------
  // Inicialização
  // --------------------------------------------------------------------
  async function iniciar(): Promise<void> {
    // Só administradores logados: a guarda redireciona ou bloqueia os demais.
    if (!(await guardarAcesso({ store: criarAuthStoreBrowser() }))) return;

    const secao = q<HTMLElement>(document, ".org[data-campeonato-id]");
    if (!secao) return;

    const campeonatoId = secao.dataset.campeonatoId;
    const categoriaNome = secao.dataset.categoriaNome;
    const init = q<HTMLElement>(secao, "[data-init]");
    const conteudo = q<HTMLElement>(secao, "[data-conteudo]");

    if (!campeonatoId || !categoriaNome) {
      setTexto(init, "Categoria inválida.");
      return;
    }

    // Import DINÂMICO do cliente público: `src/lib/supabase.ts` lança se as
    // variáveis de ambiente estiverem ausentes. Capturando aqui, a página não
    // quebra em ambientes sem Supabase (build/preview) — mostra um aviso.
    let supabase: SupabaseClient;
    try {
      const mod = await import("../../../../lib/supabase");
      supabase = mod.supabase;
    } catch {
      setTexto(
        init,
        "Organização indisponível: conexão com o banco não configurada neste ambiente.",
      );
      return;
    }

    // Resolve o id (uuid) da categoria por (campeonato_id, nome). Convenção da
    // página pública [id].astro: o nome é único por campeonato.
    let categoriaId: string;
    try {
      const { data, error } = await supabase
        .from("categorias")
        .select("id")
        .eq("campeonato_id", campeonatoId)
        .eq("nome", categoriaNome)
        .maybeSingle();
      if (error || !data) {
        setTexto(
          init,
          "Categoria ainda não cadastrada no banco. Rode a migração das categorias antes de organizar.",
        );
        return;
      }
      categoriaId = data.id as string;
    } catch {
      setTexto(init, "Falha ao localizar a categoria no banco.");
      return;
    }

    const store = criarBracketStoreBrowser(supabase);
    const ctx: Ctx = {
      ref: { campeonatoId, categoriaId },
      store,
      secao,
      status: q<HTMLElement>(secao, "[data-status]"),
      duplas: [],
      bracket: null,
      salvando: 0,
      recarregarDepois: false,
      telaChaveamento: null,
      telaJogo: null,
      seletor: null,
    };

    // Carrega o estado inicial (duplas + chaveamento) antes de exibir a UI.
    await carregarEstado(ctx);

    // Se já existe um nivelador salvo, a caixa começa marcada; senão, desmarcada.
    const usarNivelador = q<HTMLInputElement>(secao, "[data-usar-nivelador]");
    if (usarNivelador) usarNivelador.checked = temSeedingSalvo(ctx);
    atualizarVisibilidadeNivelador(ctx);
    usarNivelador?.addEventListener("change", () => atualizarVisibilidadeNivelador(ctx));

    // Tempo real: placares lançados por outras pessoas aparecem sem recarregar.
    let timer: ReturnType<typeof setTimeout> | undefined;
    void store.assinarMudancas(ctx.ref, () => {
      clearTimeout(timer);
      timer = setTimeout(() => void recarregarChaveamento(ctx), 300);
    });

    // Liga os handlers e revela o conteúdo.
    ligarHandlers(ctx);
    // Opcional e isolado: se falhar, o formulário continua só com texto.
    void ligarJogadores(ctx, supabase);
    if (init) init.hidden = true;
    if (conteudo) conteudo.hidden = false;
  }

  // --------------------------------------------------------------------
  // Carregamento de estado (duplas + chaveamento) e re-render
  // --------------------------------------------------------------------
  async function carregarEstado(ctx: Ctx): Promise<void> {
    limparErro(ctx.status);

    // Duplas e chaveamento são independentes: lê os dois em paralelo.
    const [duplasRes, brRes] = await Promise.all([
      ctx.store.listarDuplas(ctx.ref),
      ctx.store.carregarChaveamento(ctx.ref),
    ]);
    if (duplasRes.ok) {
      ctx.duplas = duplasRes.valor;
    } else {
      ctx.duplas = [];
      setTexto(ctx.status, mensagemErro(duplasRes.erro));
    }

    if (brRes.ok) {
      ctx.bracket = brRes.valor;
    } else {
      ctx.bracket = null;
      setTexto(ctx.status, mensagemErro(brRes.erro));
    }

    renderTudo(ctx);
  }

  /**
   * Relê só o chaveamento (sem mexer em duplas/nivelador, que podem ter edição
   * em andamento) e redesenha, preservando placares digitados e ainda não salvos.
   */
  async function recarregarChaveamento(ctx: Ctx): Promise<void> {
    if (ctx.salvando > 0) {
      ctx.recarregarDepois = true;
      return;
    }
    const res = await ctx.store.carregarChaveamento(ctx.ref);
    if (!res.ok || ctx.salvando > 0) {
      if (ctx.salvando > 0) ctx.recarregarDepois = true;
      return;
    }
    ctx.bracket = res.valor;
    renderBracket(ctx);
    renderBotaoMataMata(ctx);
  }

  function renderTudo(ctx: Ctx): void {
    renderDuplas(ctx);
    renderSeeding(ctx);
    renderBracket(ctx);
    renderBotaoMataMata(ctx);
  }

  // --------------------------------------------------------------------
  // DUPLAS (R1)
  // --------------------------------------------------------------------
  function renderDuplas(ctx: Ctx): void {
    const lista = q<HTMLElement>(ctx.secao, "[data-lista-duplas]");
    const contagem = q<HTMLElement>(ctx.secao, "[data-contagem-duplas]");
    if (!lista) return;

    setTexto(
      contagem,
      ctx.duplas.length === 0
        ? "Nenhuma dupla cadastrada."
        : `${ctx.duplas.length} dupla(s) cadastrada(s).`,
    );

    lista.replaceChildren();
    // Já existe chaveamento? A remoção fica bloqueada (R1.6) — escondemos o
    // botão de remover e avisamos.
    const temBracket = ctx.bracket !== null;

    for (const dupla of ctx.duplas) {
      const li = document.createElement("li");
      li.className = "org__dupla";

      const info = document.createElement("div");
      info.className = "org__dupla-info";
      const nome = document.createElement("span");
      nome.className = "org__dupla-nome";
      nome.textContent = rotuloDupla(dupla);
      info.append(nome);
      li.append(info);

      if (!temBracket) {
        const remover = document.createElement("button");
        remover.type = "button";
        remover.className = "org__remover";
        remover.textContent = "Remover";
        remover.setAttribute(
          "aria-label",
          `Remover dupla ${rotuloDupla(dupla)}`,
        );
        remover.addEventListener("click", () => void removerDupla(ctx, dupla));
        li.append(remover);
      }

      lista.append(li);
    }
  }

  async function adicionarDupla(ctx: Ctx): Promise<void> {
    const form = q<HTMLFormElement>(ctx.secao, "[data-form-dupla]");
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-dupla]");
    if (!form) return;
    limparErro(erro);

    const atletaA = q<HTMLInputElement>(form, "#dupla-atleta-a")?.value ?? "";
    const atletaB = q<HTMLInputElement>(form, "#dupla-atleta-b")?.value ?? "";
    // Dupla não tem nome próprio: o nome interno (único) é "A & B <horário do
    // cadastro>". Nas telas aparece só "A & B".
    // Vínculos opcionais com jogadores cadastrados (nulos quando não escolhidos).
    if (ctx.seletor?.mesmoJogador()) {
      setTexto(erro, "Escolha jogadores diferentes para os dois atletas.");
      return;
    }
    const vinculos = ctx.seletor?.lerVinculos() ?? {
      jogadorAId: null,
      jogadorBId: null,
    };
    const dados = {
      nomeDupla: gerarNomeDupla(atletaA, atletaB, new Date().toISOString()),
      atletaA,
      atletaB,
      ...vinculos,
    };

    // Validação de domínio ANTES de qualquer I/O (R1.2–R1.4). A store também
    // revalida contra o banco (unicidade), mas validar aqui dá feedback rápido.
    const nomesExistentes = ctx.duplas.map((d) => d.nomeDupla);
    const validada = validarDuplaCandidata(dados, nomesExistentes);
    if (!validada.ok) {
      setTexto(erro, mensagemErro(validada.erro));
      return;
    }

    const res = await ctx.store.adicionarDupla(ctx.ref, dados);
    if (!res.ok) {
      setTexto(erro, mensagemErro(res.erro));
      return;
    }

    form.reset();
    await carregarEstado(ctx);
    q<HTMLInputElement>(form, "#dupla-atleta-a")?.focus();
  }

  async function removerDupla(ctx: Ctx, dupla: Pair): Promise<void> {
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-dupla]");
    limparErro(erro);
    const res = await ctx.store.removerDupla(dupla.id);
    if (!res.ok) {
      setTexto(erro, mensagemErro(res.erro));
      return;
    }
    await carregarEstado(ctx);
  }

  // --------------------------------------------------------------------
  // FORMATO (R2)
  // --------------------------------------------------------------------
  function formatoSelecionado(ctx: Ctx): string | null {
    const marcado = q<HTMLInputElement>(
      ctx.secao,
      "input[name='formato']:checked",
    );
    return marcado?.value ?? null;
  }

  function atualizarVisibilidadeGrupos(ctx: Ctx): void {
    const params = q<HTMLElement>(ctx.secao, "[data-grupos-params]");
    if (!params) return;
    params.hidden = formatoSelecionado(ctx) !== "fase de grupos";
  }

  async function salvarFormato(ctx: Ctx): Promise<void> {
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-formato]");
    limparErro(erro);

    const formatoRes = exigirFormato(formatoSelecionado(ctx));
    if (!formatoRes.ok) {
      setTexto(erro, mensagemErro(formatoRes.erro));
      return;
    }
    const formato: Format = formatoRes.valor;

    const config: BracketConfig = { formato };

    if (formato === "fase de grupos") {
      const n = ctx.duplas.length;
      const gInput = q<HTMLInputElement>(ctx.secao, "#formato-grupos");
      const cInput = q<HTMLInputElement>(ctx.secao, "#formato-classificados");
      const g = Number(gInput?.value);
      const c = Number(cInput?.value);

      const gRes = validarNumeroDeGrupos(g, n);
      if (!gRes.ok) {
        setTexto(erro, mensagemErro(gRes.erro));
        return;
      }
      const cRes = validarClassificadosPorGrupo(c, n, gRes.valor);
      if (!cRes.ok) {
        setTexto(erro, mensagemErro(cRes.erro));
        return;
      }
      config.numeroDeGrupos = gRes.valor;
      config.classificadosPorGrupo = cRes.valor;
    }

    const res = await ctx.store.salvarConfig(ctx.ref, config);
    if (!res.ok) {
      setTexto(erro, mensagemErro(res.erro));
      return;
    }
    setTexto(ctx.status, "Formato salvo.");
  }

  // --------------------------------------------------------------------
  // NIVELADOR (seeding, R3) — lista ordenável por arrastar-e-soltar
  // --------------------------------------------------------------------

  /** Ordem inicial: seed salvo (se válido e completo) ou alfabética. */
  function ordemInicialNivelador(ctx: Ctx): Pair[] {
    const n = ctx.duplas.length;
    const seedsValidos =
      ctx.duplas.every((d) => Number.isInteger(d.seed) && d.seed >= 1 && d.seed <= n) &&
      new Set(ctx.duplas.map((d) => d.seed)).size === n;
    if (seedsValidos) return [...ctx.duplas].sort((a, b) => a.seed - b.seed);
    const padrao = new Map(seedingPadrao(ctx.duplas).map((s) => [s.pairId, s.posicao]));
    return [...ctx.duplas].sort(
      (a, b) => (padrao.get(a.id) ?? 0) - (padrao.get(b.id) ?? 0),
    );
  }

  /** O organizador marcou "Quero definir o nivelador"? */
  function niveladorLigado(ctx: Ctx): boolean {
    return q<HTMLInputElement>(ctx.secao, "[data-usar-nivelador]")?.checked === true;
  }

  /** Mostra ou esconde a lista do nivelador conforme a caixa de seleção. */
  function atualizarVisibilidadeNivelador(ctx: Ctx): void {
    const conteudo = q<HTMLElement>(ctx.secao, "[data-nivelador-conteudo]");
    if (conteudo) conteudo.hidden = !niveladorLigado(ctx);
  }

  /** Há seeding completo salvo (1..N sem repetição) vindo de um nivelador anterior? */
  function temSeedingSalvo(ctx: Ctx): boolean {
    const n = ctx.duplas.length;
    return (
      n > 0 &&
      ctx.duplas.every((d) => Number.isInteger(d.seed) && d.seed >= 1 && d.seed <= n) &&
      new Set(ctx.duplas.map((d) => d.seed)).size === n
    );
  }

  /** Ids das duplas na ordem atual mostrada na lista (ou null se não há lista). */
  function ordemAtualDoNivelador(ctx: Ctx): string[] | null {
    const itens = Array.from(
      ctx.secao.querySelectorAll<HTMLElement>(".org__nivelador-item"),
    );
    if (itens.length !== ctx.duplas.length || itens.length === 0) return null;
    return itens.map((li) => li.dataset.pairId ?? "");
  }

  function atualizarPosicoesNivelador(lista: HTMLElement): void {
    const itens = Array.from(lista.querySelectorAll<HTMLElement>(".org__nivelador-item"));
    itens.forEach((li, i) => {
      const pos = li.querySelector<HTMLElement>(".org__nivelador-pos");
      if (pos) pos.textContent = `${i + 1}º`;
      const sobe = li.querySelector<HTMLButtonElement>("[data-sobe]");
      const desce = li.querySelector<HTMLButtonElement>("[data-desce]");
      if (sobe) sobe.disabled = i === 0;
      if (desce) desce.disabled = i === itens.length - 1;
    });
  }

  function renderSeeding(ctx: Ctx): void {
    const lista = q<HTMLElement>(ctx.secao, "[data-lista-seeding]");
    if (!lista) return;
    lista.replaceChildren();

    if (ctx.duplas.length === 0) {
      const vazio = document.createElement("li");
      vazio.className = "org__seeding-vazio";
      vazio.textContent = "Cadastre duplas para definir o nivelador.";
      lista.append(vazio);
      return;
    }

    let arrastando: HTMLElement | null = null;

    for (const dupla of ordemInicialNivelador(ctx)) {
      const li = document.createElement("li");
      li.className = "org__nivelador-item";
      li.dataset.pairId = dupla.id;
      li.draggable = true;

      const alca = document.createElement("span");
      alca.className = "org__nivelador-alca";
      alca.setAttribute("aria-hidden", "true");
      alca.textContent = "⠿";

      const pos = document.createElement("span");
      pos.className = "org__nivelador-pos";

      const nome = document.createElement("span");
      nome.className = "org__nivelador-nome";
      nome.textContent = rotuloDupla(dupla);

      const mover = (delta: number): void => {
        const irmao = delta < 0 ? li.previousElementSibling : li.nextElementSibling;
        if (!irmao) return;
        if (delta < 0) lista.insertBefore(li, irmao);
        else lista.insertBefore(irmao, li);
        atualizarPosicoesNivelador(lista);
        li.querySelector<HTMLButtonElement>(delta < 0 ? "[data-sobe]" : "[data-desce]")?.focus();
      };
      const botao = (rotulo: string, aria: string, attr: string, delta: number) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "org__nivelador-seta";
        b.textContent = rotulo;
        b.setAttribute("aria-label", `${aria}: ${rotuloDupla(dupla)}`);
        b.setAttribute(attr, "");
        b.addEventListener("click", () => mover(delta));
        return b;
      };

      li.append(alca, pos, nome, botao("▲", "Subir", "data-sobe", -1), botao("▼", "Descer", "data-desce", 1));

      // Arrastar e soltar (mouse). Em telas de toque, usar as setas.
      li.addEventListener("dragstart", (e) => {
        arrastando = li;
        li.classList.add("org__nivelador-item--arrastando");
        e.dataTransfer?.setData("text/plain", dupla.id);
        if (e.dataTransfer) e.dataTransfer.effectAllowed = "move";
      });
      li.addEventListener("dragend", () => {
        arrastando = null;
        li.classList.remove("org__nivelador-item--arrastando");
        atualizarPosicoesNivelador(lista);
      });
      li.addEventListener("dragover", (e) => {
        e.preventDefault();
        if (!arrastando || arrastando === li) return;
        const r = li.getBoundingClientRect();
        const depois = e.clientY > r.top + r.height / 2;
        lista.insertBefore(arrastando, depois ? li.nextSibling : li);
      });
      li.addEventListener("drop", (e) => e.preventDefault());

      lista.append(li);
    }
    atualizarPosicoesNivelador(lista);
  }

  async function salvarSeeding(ctx: Ctx): Promise<void> {
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-seeding]");
    limparErro(erro);

    const ordem = ordemAtualDoNivelador(ctx);
    if (!ordem) return;
    // A posição de cada dupla é a sua posição na lista (1 = mais forte).
    const seeds: SeedAssignment[] = ordem.map((pairId, i) => ({
      pairId,
      posicao: i + 1,
    }));

    const valido = validarSeeding(seeds, ctx.duplas.length);
    if (!valido.ok) {
      setTexto(erro, mensagemErro(valido.erro));
      return;
    }

    const res = await ctx.store.salvarSeeding(ctx.ref, valido.valor);
    if (!res.ok) {
      setTexto(erro, mensagemErro(res.erro));
      return;
    }
    setTexto(ctx.status, "Nivelador salvo.");
    await carregarEstado(ctx);
  }

  // --------------------------------------------------------------------
  // GERAR (R4) — com confirmação de substituição (R4.8/R4.9)
  // --------------------------------------------------------------------

  /**
   * Monta a lista de duplas com seeding RESOLVIDO para alimentar o gerador,
   * a partir da ordem do nivelador exibida (inicialmente salva ou alfabética).
   */
  function duplasComSeeding(ctx: Ctx): Pair[] {
    // Sem nivelador: ordem aleatória (sorteada na borda; o gerador segue puro).
    if (!niveladorLigado(ctx)) {
      const sorteio = new Map(
        seedingAleatorio(ctx.duplas).map((s) => [s.pairId, s.posicao]),
      );
      return ctx.duplas.map((d) => ({ ...d, seed: sorteio.get(d.id) ?? d.seed }));
    }
    // Com nivelador, o que o organizador vê na lista é o que vale (mesmo sem salvar).
    const ordem = ordemAtualDoNivelador(ctx);
    if (ordem) {
      const posicaoPorId = new Map(ordem.map((id, i) => [id, i + 1]));
      return ctx.duplas.map((d) => ({ ...d, seed: posicaoPorId.get(d.id) ?? d.seed }));
    }
    const padrao = seedingPadrao(ctx.duplas);
    const posicaoPorId = new Map(padrao.map((s) => [s.pairId, s.posicao]));
    return ctx.duplas.map((d) => ({
      ...d,
      seed: posicaoPorId.get(d.id) ?? d.seed,
    }));
  }

  /**
   * Lê o formato a partir do que está marcado na UI OU do chaveamento/estado
   * existente. Exige um formato (R2.7). Para "fase de grupos", valida os
   * parâmetros contra o número de duplas.
   */
  function resolverConfigParaGerar(ctx: Ctx): Result<BracketConfig> {
    const n = ctx.duplas.length;

    const formatoRes = exigirFormato(formatoSelecionado(ctx));
    if (!formatoRes.ok) return { ok: false, erro: formatoRes.erro };
    const formato = formatoRes.valor;

    const config: BracketConfig = { formato };
    if (formato === "fase de grupos") {
      const g = Number(
        q<HTMLInputElement>(ctx.secao, "#formato-grupos")?.value,
      );
      const c = Number(
        q<HTMLInputElement>(ctx.secao, "#formato-classificados")?.value,
      );
      const gRes = validarNumeroDeGrupos(g, n);
      if (!gRes.ok) return { ok: false, erro: gRes.erro };
      const cRes = validarClassificadosPorGrupo(c, n, gRes.valor);
      if (!cRes.ok) return { ok: false, erro: cRes.erro };
      config.numeroDeGrupos = gRes.valor;
      config.classificadosPorGrupo = cRes.valor;
    }
    return { ok: true, valor: config };
  }

  async function clicarGerar(ctx: Ctx): Promise<void> {
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-gerar]");
    limparErro(erro);

    // Se já existe chaveamento, NÃO gera direto: exige confirmação explícita
    // (R4.8). Enquanto não confirmar, nada é gravado (R4.9).
    if (ctx.bracket !== null) {
      const confirmar = q<HTMLElement>(ctx.secao, "[data-confirmar]");
      if (confirmar) confirmar.hidden = false;
      return;
    }

    await gerarEffetivo(ctx);
  }

  async function gerarEffetivo(ctx: Ctx): Promise<void> {
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-gerar]");
    limparErro(erro);

    const configRes = resolverConfigParaGerar(ctx);
    if (!configRes.ok) {
      setTexto(erro, mensagemErro(configRes.erro));
      return;
    }

    const duplas = duplasComSeeding(ctx);
    const gen = gerarChaveamento({ duplas, config: configRes.valor });
    if (!gen.ok) {
      setTexto(erro, mensagemErro(gen.erro));
      return;
    }

    // Preenche os identificadores do par (campeonato, categoria) e já numera os
    // jogos elegíveis (ordem de disputa) antes de persistir.
    const bracket: Bracket = numerarJogos({
      ...gen.bracket,
      campeonatoId: ctx.ref.campeonatoId,
      categoriaId: ctx.ref.categoriaId,
    });

    const res = await ctx.store.salvarChaveamento(ctx.ref, bracket);
    if (!res.ok) {
      setTexto(erro, mensagemErro(res.erro));
      return;
    }

    setTexto(ctx.status, "Chaveamento gerado e salvo.");
    await carregarEstado(ctx);
  }

  // --------------------------------------------------------------------
  // GERAR MATA-MATA (transição grupos → mata-mata, R5.4/R5.5/R5.6)
  // --------------------------------------------------------------------

  /** Verdadeiro sse o bracket atual é de fase de grupos com todos os grupos
   *  completos (todos os jogos de grupo têm vencedor). */
  function gruposTodosCompletos(bracket: Bracket): boolean {
    if (bracket.formato !== "fase de grupos") return false;
    if (bracket.grupos.length === 0) return false;
    const jogosGrupo = bracket.matches.filter((m) => m.side === "grupo");
    if (jogosGrupo.length === 0) return false;
    return jogosGrupo.every((m) => m.vencedorId !== null);
  }

  /** Verdadeiro sse o mata-mata já foi gerado (há jogos fora de "grupo"). */
  function temMataMata(bracket: Bracket): boolean {
    return bracket.matches.some((m) => m.side !== "grupo");
  }

  function renderBotaoMataMata(ctx: Ctx): void {
    const botao = q<HTMLButtonElement>(ctx.secao, "[data-gerar-matamata]");
    if (!botao) return;
    const mostrar =
      ctx.bracket !== null &&
      gruposTodosCompletos(ctx.bracket) &&
      !temMataMata(ctx.bracket);
    botao.hidden = !mostrar;
  }

  async function gerarMataMata(ctx: Ctx): Promise<void> {
    const erro = q<HTMLElement>(ctx.secao, "[data-erro-gerar]");
    limparErro(erro);
    const bracket = ctx.bracket;
    if (!bracket || !gruposTodosCompletos(bracket)) return;

    const classificadosPorGrupo = bracket.config.classificadosPorGrupo ?? 1;
    const duplaPorId = new Map(bracket.duplas.map((d) => [d.id, d]));

    // Monta a lista de classificados (dupla + grupo + posição) para posicionar.
    const classificados: ClassificadoDoGrupo[] = [];
    for (const grupo of bracket.grupos) {
      const top = selecionarClassificados(
        grupo,
        bracket.matches,
        classificadosPorGrupo,
      );
      if (top === null) {
        setTexto(erro, "A fase de grupos ainda não está completa.");
        return;
      }
      for (const standing of top) {
        const pair = duplaPorId.get(standing.pairId);
        if (!pair) continue;
        classificados.push({
          pair,
          grupoId: grupo.id,
          posicaoNoGrupo: standing.posicao,
        });
      }
    }

    const pos = posicionarClassificadosNoMataMata(
      classificados,
      bracket.config,
    );
    if (!pos.ok) {
      setTexto(erro, mensagemErro(pos.erro));
      return;
    }

    // O mata-mata gerado é um bracket independente; mesclamos os jogos/duplas
    // do mata-mata ao bracket de grupos existente, preservando os jogos de
    // grupo e seus resultados.
    const mataMata = pos.bracket;
    const jogosGrupo = bracket.matches.filter((m) => m.side === "grupo");
    const jogosMataMata = mataMata.matches.filter((m) => m.side !== "grupo");

    // União das duplas (snapshot): grupos + classificados (sem duplicar por id).
    const duplasUnidas = new Map<string, Pair>();
    for (const d of bracket.duplas) duplasUnidas.set(d.id, d);
    for (const d of mataMata.duplas) duplasUnidas.set(d.id, { ...d });

    const combinado: Bracket = numerarJogos({
      ...bracket,
      duplas: Array.from(duplasUnidas.values()),
      matches: [...jogosGrupo, ...jogosMataMata],
    });

    const res = await ctx.store.salvarChaveamento(ctx.ref, combinado);
    if (!res.ok) {
      setTexto(erro, mensagemErro(res.erro));
      return;
    }
    setTexto(ctx.status, "Mata-mata gerado a partir dos classificados.");
    await carregarEstado(ctx);
  }

  // --------------------------------------------------------------------
  // REGISTRAR RESULTADOS (R6) — para cada jogo pronto (sem bye, ambas as duplas)
  // --------------------------------------------------------------------
  function nomeDupla(bracket: Bracket, pairId: string | null): string {
    if (!pairId) return "(indefinida)";
    const d = bracket.duplas.find((x) => x.id === pairId);
    return d ? rotuloDupla(d) : "(indefinida)";
  }

  /**
   * Registra o resultado FINAL de um jogo (vencedor derivado do placar, avanço
   * e cascata). Devolve a mensagem de erro, ou `null` se deu certo.
   */
  async function registrarResultado(
    ctx: Ctx,
    matchId: string,
    placarA: number,
    placarB: number,
  ): Promise<string | null> {
    const bracket = ctx.bracket;
    if (!bracket) return "Nenhum chaveamento carregado.";

    // Progressão PURA: produz um novo bracket (avanço + cascata). `agora` é
    // injetado na borda para manter a função pura (R6.1).
    const res = registrarPlacar(
      bracket,
      matchId,
      placarA,
      placarB,
      new Date().toISOString(),
    );
    if (!res.ok) {
      const msg = mensagemErro(res.erro);
      setTexto(ctx.status, msg);
      return msg;
    }

    // Numera os jogos que passaram a ser elegíveis com este resultado (ex.: a
    // próxima rodada do mata-mata cujas duplas acabaram de ser definidas). Os
    // já numerados permanecem estáveis.
    const numerado = numerarJogos(res.bracket);
    const alterados = jogosAlterados(bracket, numerado);
    if (alterados.length === 0) return null;

    // Atualização otimista: mostra o placar na hora e grava só os jogos que
    // mudaram (uma ida ao banco), sem reler o chaveamento inteiro.
    ctx.bracket = numerado;
    renderBracket(ctx);
    renderBotaoMataMata(ctx);
    setTexto(ctx.status, "Salvando placar…");

    ctx.salvando += 1;
    const salvo = await ctx.store.salvarJogos(ctx.ref, alterados, numerado.campeaId);
    ctx.salvando -= 1;
    const reler = ctx.salvando === 0 && ctx.recarregarDepois;
    if (reler) ctx.recarregarDepois = false;
    if (!salvo.ok) {
      // Falhou: volta ao estado anterior para a tela não mostrar algo não salvo.
      ctx.bracket = bracket;
      renderBracket(ctx);
      renderBotaoMataMata(ctx);
      const msg = mensagemErro(salvo.erro);
      setTexto(ctx.status, msg);
      if (reler) void recarregarChaveamento(ctx);
      return msg;
    }
    setTexto(ctx.status, "Placar registrado.");
    // Chegou evento de outra pessoa durante a gravação: relê agora.
    if (reler) void recarregarChaveamento(ctx);
    return null;
  }

  /**
   * Grava o placar PARCIAL de um jogo em andamento (sem encerrar nem avançar
   * ninguém). Cada toque no "+" chega aqui: quem acompanha vê o placar mudar.
   * Devolve a mensagem de erro, ou `null` se deu certo.
   */
  async function salvarPlacarAoVivo(
    ctx: Ctx,
    matchId: string,
    placarA: number,
    placarB: number,
  ): Promise<string | null> {
    const bracket = ctx.bracket;
    if (!bracket) return "Nenhum chaveamento carregado.";
    const res = atualizarPlacarAoVivo(bracket, matchId, placarA, placarB);
    if (!res.ok) return mensagemErro(res.erro);
    const alterados = jogosAlterados(bracket, res.bracket);
    if (alterados.length === 0) return null;

    ctx.bracket = res.bracket;
    renderBracket(ctx);

    ctx.salvando += 1;
    const salvo = await ctx.store.salvarJogos(ctx.ref, alterados, res.bracket.campeaId);
    ctx.salvando -= 1;
    const reler = ctx.salvando === 0 && ctx.recarregarDepois;
    if (reler) ctx.recarregarDepois = false;
    if (reler) void recarregarChaveamento(ctx);
    // Em caso de falha NÃO desfaz: o placar da tela de pontuação é o que vale e
    // o próximo toque reenvia o valor mais recente.
    return salvo.ok ? null : mensagemErro(salvo.erro);
  }

  // --------------------------------------------------------------------
  // TELA DE PLACAR (ao vivo)
  // --------------------------------------------------------------------
  let telaPlacarAberta = false;

  function abrirTelaPlacar(ctx: Ctx, matchId: string): void {
    const bracket = ctx.bracket;
    const jogo = bracket?.matches.find((m) => m.id === matchId);
    if (!bracket || !jogo || telaPlacarAberta) return;
    const duplaA = jogo.a.pairId ? bracket.duplas.find((d) => d.id === jogo.a.pairId) : undefined;
    const duplaB = jogo.b.pairId ? bracket.duplas.find((d) => d.id === jogo.b.pairId) : undefined;
    if (!duplaA || !duplaB) return;
    telaPlacarAberta = true;

    // Jogo já encerrado: modo CORREÇÃO (nada é gravado até confirmar). Em
    // andamento: modo AO VIVO (cada toque grava).
    const correcao = jogo.vencedorId !== null;
    const estado = { a: jogo.placarA ?? 0, b: jogo.placarB ?? 0 };
    let ultimoEnviado = jogo.placarA !== null ? `${jogo.placarA}x${jogo.placarB}` : "";
    let cadeia: Promise<unknown> = Promise.resolve();

    const dialog = document.createElement("dialog");
    dialog.className = "placar-tela";
    dialog.setAttribute("aria-labelledby", "placar-tela-titulo");

    const titulo = document.createElement("h2");
    titulo.id = "placar-tela-titulo";
    titulo.className = "placar-tela__titulo";
    titulo.textContent = jogo.ordemDisputa !== null ? `Jogo ${jogo.ordemDisputa}` : "Placar";

    const subtitulo = document.createElement("p");
    subtitulo.className = "placar-tela__sub";
    subtitulo.textContent = correcao
      ? "Jogo encerrado: ajuste o placar e salve a correção."
      : "Toque em +1 a cada ponto (o público acompanha em tempo real) ou digite o placar final.";

    const lados = document.createElement("div");
    lados.className = "placar-tela__lados";

    const msg = document.createElement("p");
    msg.className = "placar-tela__msg";
    msg.setAttribute("role", "status");

    // O placar de cada lado é um campo numérico grande: dá para tocar em +1/−1
    // ou digitar o valor (útil quando não dá para marcar em tempo real).
    const pontos: Record<"a" | "b", HTMLInputElement> = {
      a: document.createElement("input"),
      b: document.createElement("input"),
    };

    /** Valor inteiro ≥ 0 do campo; vazio ou inválido conta como 0. */
    const lerCampo = (lado: "a" | "b"): number => {
      const n = Math.floor(Number(pontos[lado].value));
      return Number.isFinite(n) && n > 0 ? n : 0;
    };

    const enviarAoVivo = (): void => {
      if (correcao) return;
      cadeia = cadeia.then(async () => {
        const chave = `${estado.a}x${estado.b}`;
        if (chave === ultimoEnviado) return;
        ultimoEnviado = chave;
        const erro = await salvarPlacarAoVivo(ctx, matchId, estado.a, estado.b);
        msg.textContent = erro ?? "";
        if (erro) ultimoEnviado = ""; // força reenvio no próximo toque
      });
    };

    const mudar = (lado: "a" | "b", delta: number): void => {
      estado[lado] = Math.max(0, estado[lado] + delta);
      pontos[lado].value = String(estado[lado]);
      enviarAoVivo();
    };

    const montarLado = (lado: "a" | "b", nome: string): HTMLElement => {
      const caixa = document.createElement("div");
      caixa.className = "placar-tela__lado";
      const n = document.createElement("p");
      n.className = "placar-tela__nome";
      n.textContent = nome;
      const campo = pontos[lado];
      campo.className = "placar-tela__pontos";
      campo.type = "number";
      campo.min = "0";
      campo.step = "1";
      campo.inputMode = "numeric";
      campo.setAttribute("aria-label", `Placar de ${nome}`);
      campo.value = String(estado[lado]);
      // Enquanto digita, só guarda o valor (sem gravar "1" a caminho de "15").
      campo.addEventListener("input", () => {
        estado[lado] = lerCampo(lado);
      });
      // Ao terminar de digitar (sai do campo / Enter), normaliza e grava ao vivo.
      campo.addEventListener("change", () => {
        estado[lado] = lerCampo(lado);
        campo.value = String(estado[lado]);
        enviarAoVivo();
      });
      campo.addEventListener("keydown", (e) => {
        if (e.key === "Enter") campo.blur();
      });
      campo.addEventListener("focus", () => campo.select());
      const mais = document.createElement("button");
      mais.type = "button";
      mais.className = "placar-tela__mais";
      mais.textContent = "+1";
      mais.setAttribute("aria-label", `Mais um ponto para ${nome}`);
      mais.addEventListener("click", () => mudar(lado, 1));
      const menos = document.createElement("button");
      menos.type = "button";
      menos.className = "placar-tela__menos";
      menos.textContent = "−1";
      menos.setAttribute("aria-label", `Tirar um ponto de ${nome}`);
      menos.addEventListener("click", () => mudar(lado, -1));
      caixa.append(n, pontos[lado], mais, menos);
      return caixa;
    };
    lados.append(montarLado("a", rotuloDupla(duplaA)), montarLado("b", rotuloDupla(duplaB)));

    const acoes = document.createElement("div");
    acoes.className = "placar-tela__acoes";
    const encerrar = document.createElement("button");
    encerrar.type = "button";
    encerrar.className = "org__botao org__botao--primario placar-tela__encerrar";
    encerrar.textContent = correcao ? "Salvar correção" : "Partida encerrada";
    const fechar = document.createElement("button");
    fechar.type = "button";
    fechar.className = "org__botao";
    fechar.textContent = "Fechar";
    acoes.append(encerrar, fechar);

    dialog.append(titulo, subtitulo, lados, msg, acoes);
    document.body.append(dialog);

    const limpar = (): void => {
      telaPlacarAberta = false;
      dialog.remove();
    };
    dialog.addEventListener("close", limpar);
    fechar.addEventListener("click", () => dialog.close());

    encerrar.addEventListener("click", async () => {
      encerrar.disabled = true;
      msg.textContent = "";
      // Garante que o que está digitado nos campos vale, mesmo sem ter saído deles.
      estado.a = lerCampo("a");
      estado.b = lerCampo("b");
      await cadeia; // espera os toques em andamento gravarem
      const erro = await registrarResultado(ctx, matchId, estado.a, estado.b);
      if (erro) {
        msg.textContent = erro;
        encerrar.disabled = false;
        return;
      }
      dialog.close();
    });

    dialog.showModal();
    encerrar.focus();
  }

  // --------------------------------------------------------------------
  // VISUALIZAÇÃO do estado atual (renderBracketClient)
  // --------------------------------------------------------------------
  function renderBracket(ctx: Ctx): void {
    const slot = q<HTMLElement>(ctx.secao, "[data-bracket-slot]");
    if (!slot) return;

    // Botão "Tela cheia" só com chaveamento; telas cheias abertas acompanham.
    const botaoTelaCheia = q<HTMLButtonElement>(ctx.secao, "[data-tela-cheia]");
    if (botaoTelaCheia) botaoTelaCheia.hidden = !ctx.bracket;
    if (ctx.bracket) {
      ctx.telaChaveamento?.atualizar(ctx.bracket);
      ctx.telaJogo?.atualizar(ctx.bracket);
    } else {
      ctx.telaJogo?.fechar();
      ctx.telaChaveamento?.fechar();
    }

    if (!ctx.bracket) {
      const vazio = document.createElement("p");
      vazio.className = "org__indisponivel";
      vazio.textContent = "Nenhum chaveamento gerado ainda.";
      slot.replaceChildren(vazio);
      return;
    }

    try {
      // O organizador abre a tela de placar do jogo (ao vivo; vencedor =
      // maior número, sem empate). Ver `abrirTelaPlacar`.
      const view = renderBracketClient(ctx.bracket, {
        aoAbrirPlacar: (matchId) => abrirTelaPlacar(ctx, matchId),
      });
      slot.replaceChildren(view);
    } catch {
      const err = document.createElement("p");
      err.className = "org__indisponivel";
      err.textContent = "Não foi possível exibir o chaveamento.";
      slot.replaceChildren(err);
    }
  }

  // --------------------------------------------------------------------
  // Jogadores cadastrados (vínculo opcional da dupla com o perfil)
  // --------------------------------------------------------------------
  async function ligarJogadores(
    ctx: Ctx,
    supabase: SupabaseClient,
  ): Promise<void> {
    const form = q<HTMLFormElement>(ctx.secao, "[data-form-dupla]");
    if (!form) return;
    try {
      const r = await criarJogadorStoreBrowser(supabase).listar();
      if (!r.ok || r.valor.length === 0) return; // nada para escolher
      ctx.seletor = ligarSeletoresDeJogador(form, r.valor);
    } catch {
      // Segue sem os seletores: o cadastro por texto não depende deles.
    }
  }

  // --------------------------------------------------------------------
  // Ligação de handlers
  // --------------------------------------------------------------------
  /** "Tela cheia": o chaveamento completo (só visualização), em tempo real. */
  function ligarTelaCheia(ctx: Ctx): void {
    const categoria = ctx.secao.dataset.categoriaNome ?? "Chaveamento";
    const abrirJogo = (
      matchId: string,
      contexto?: { dentroDe: HTMLElement; aoFecharJogo: () => void },
    ): void => {
      if (!ctx.bracket) return;
      ctx.telaJogo?.fechar();
      ctx.telaJogo = abrirTelaJogo({
        bracket: ctx.bracket,
        matchId,
        categoria,
        dentroDe: contexto?.dentroDe,
        aoFechar: () => {
          ctx.telaJogo = null;
          contexto?.aoFecharJogo();
        },
      });
    };
    q<HTMLButtonElement>(ctx.secao, "[data-tela-cheia]")?.addEventListener("click", () => {
      if (!ctx.bracket) return;
      ctx.telaChaveamento?.fechar();
      ctx.telaChaveamento = abrirTelaChaveamento({
        bracket: ctx.bracket,
        categoria,
        aoAbrirJogo: abrirJogo,
        aoFechar: () => {
          ctx.telaChaveamento = null;
        },
      });
    });
  }

  function ligarHandlers(ctx: Ctx): void {
    ligarTelaCheia(ctx);
    // Duplas
    const formDupla = q<HTMLFormElement>(ctx.secao, "[data-form-dupla]");
    formDupla?.addEventListener("submit", (e) => {
      e.preventDefault();
      void adicionarDupla(ctx);
    });

    // Formato: mostra/esconde parâmetros de grupos ao trocar o radio.
    for (const radio of Array.from(
      ctx.secao.querySelectorAll<HTMLInputElement>("[data-formato]"),
    )) {
      radio.addEventListener("change", () => atualizarVisibilidadeGrupos(ctx));
    }
    atualizarVisibilidadeGrupos(ctx);

    const formFormato = q<HTMLFormElement>(ctx.secao, "[data-form-formato]");
    formFormato?.addEventListener("submit", (e) => {
      e.preventDefault();
      void salvarFormato(ctx);
    });

    // Seeding
    const formSeeding = q<HTMLFormElement>(ctx.secao, "[data-form-seeding]");
    formSeeding?.addEventListener("submit", (e) => {
      e.preventDefault();
      void salvarSeeding(ctx);
    });

    // Gerar
    q<HTMLButtonElement>(ctx.secao, "[data-gerar]")?.addEventListener(
      "click",
      () => void clicarGerar(ctx),
    );

    // Gerar mata-mata
    q<HTMLButtonElement>(ctx.secao, "[data-gerar-matamata]")?.addEventListener(
      "click",
      () => void gerarMataMata(ctx),
    );

    // Confirmação de substituição (R4.8/R4.9)
    q<HTMLButtonElement>(ctx.secao, "[data-confirmar-sim]")?.addEventListener(
      "click",
      () => {
        const confirmar = q<HTMLElement>(ctx.secao, "[data-confirmar]");
        if (confirmar) confirmar.hidden = true;
        void gerarEffetivo(ctx);
      },
    );
    q<HTMLButtonElement>(ctx.secao, "[data-confirmar-nao]")?.addEventListener(
      "click",
      () => {
        // Cancela: nada é gravado (R4.9); apenas fecha o painel.
        const confirmar = q<HTMLElement>(ctx.secao, "[data-confirmar]");
        if (confirmar) confirmar.hidden = true;
        setTexto(ctx.status, "Substituição cancelada. Nada foi alterado.");
      },
    );
  }

  iniciar();
</script>

