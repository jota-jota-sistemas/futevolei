---
import Layout from "../layouts/Layout.astro";
import PaginaTopo from "../components/PaginaTopo.astro";
import Cartao from "../components/Cartao.astro";
import { comBase } from "../utils/url";
---

<Layout
  titulo="Entrar — Pingo Futevôlei"
  descricao="Receba um link de acesso por e-mail para entrar."
  noindex
>
  <PaginaTopo
    titulo="Entrar"
    subtitulo="Informe seu e-mail e receba um link de acesso."
    voltarHref={comBase("/")}
    voltarTexto="Voltar aos eventos"
  />

  <div class="entrar">
    <Cartao titulo="Acesse sua conta" id="entrar">
      <p class="entrar__estado" data-entrar-estado role="status">Verificando sua sessão…</p>

      <div data-entrar-formulario hidden>
        {/* Login com Google desativado por ora (a configuração do provedor não
            ficou pronta). Para reativar: devolver o botão com `data-google`; o
            script e a store já tratam o clique. */}
        <form class="entrar__form" data-form-link novalidate>
          <label for="email-entrar">E-mail para receber o link</label>
          <input
            id="email-entrar"
            class="entrar__campo"
            type="email"
            name="email"
            autocomplete="email"
            inputmode="email"
            placeholder="voce@exemplo.com"
            data-email
            required
          />
          <button type="submit" class="btn-destaque entrar__enviar" data-enviar-link>
            Enviar link de acesso
          </button>
        </form>

        <p class="entrar__erro" data-entrar-erro role="alert"></p>
        <p class="entrar__sucesso" data-entrar-sucesso role="status"></p>
      </div>

      <noscript><p>Ative o JavaScript para entrar.</p></noscript>
    </Cartao>
  </div>
</Layout>

<script>
  import { iniciarEntrar } from "../scripts/entrar";
  import { criarAuthStoreBrowser } from "../store/authStore";

  void iniciarEntrar({
    store: criarAuthStoreBrowser(),
    volta: new URLSearchParams(window.location.search).get("volta"),
  });
</script>

<style>
  .entrar {
    max-width: 480px;
    margin: 0 auto;
    padding: 1.5rem 1rem 1rem;
  }

  .entrar__estado {
    margin: 0;
    color: var(--cor-texto-suave);
  }

  .entrar__enviar:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .entrar__form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .entrar__form label {
    font-size: 0.85rem;
    font-weight: 700;
  }

  .entrar__campo {
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    font: inherit;
    font-size: 1rem;
    border: 1px solid var(--cor-texto-suave);
    border-radius: 12px;
  }

  .entrar__enviar {
    min-height: 44px;
    margin-top: 0.25rem;
  }

  .entrar__erro {
    margin: 0.75rem 0 0;
    color: var(--cor-erro);
    font-weight: 600;
  }

  .entrar__sucesso {
    margin: 0.75rem 0 0;
    color: var(--cor-destaque-texto);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .entrar__erro:empty,
  .entrar__sucesso:empty {
    display: none;
  }
</style>
