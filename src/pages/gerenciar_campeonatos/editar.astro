---
import Layout from "../../layouts/Layout.astro";
import PaginaTopo from "../../components/PaginaTopo.astro";
import CampeonatoPerfil from "../../components/CampeonatoPerfil.astro";
import GuardaAcesso from "../../components/GuardaAcesso.astro";
import { comBase } from "../../utils/url";

// Edição de UM campeonato (?id=…) na área de gerenciamento: editar dados, arquivar
// ou reativar e excluir. Mesmo controle de acesso de /gerenciar_campeonatos:
// administradores e organizadores logados (guarda de interface + RLS); o
// organizador só edita campeonatos em que é dono.
---

<Layout
  titulo="Editar campeonato — Pingo Futevôlei"
  descricao="Área de gerenciamento de campeonatos."
  noindex
>
  <GuardaAcesso>
  <PaginaTopo
    titulo="Editar campeonato"
    voltarHref={comBase("/gerenciar_campeonatos")}
    voltarTexto="Voltar ao gerenciamento"
  />

  <CampeonatoPerfil />
  </GuardaAcesso>
</Layout>

<script>
  import { iniciarEdicao } from "../../scripts/campeonato-editar";
  import { criarCampeonatoStoreBrowser } from "../../store/campeonatoStore";
  import { criarCategoriaStoreBrowser } from "../../store/categoriaStore";
  import { irParaGerenciarCampeonatos } from "../../scripts/rotas-gerenciar";
  import { guardarAcesso } from "../../scripts/guarda";
  import { criarAuthStoreBrowser } from "../../store/authStore";

  // A edição só inicia depois que a guarda libera o acesso. Organizador: confere
  // no banco se é dono deste campeonato antes de mostrar a edição.
  let papel: "admin" | "organizador" = "admin";
  void guardarAcesso({ store: criarAuthStoreBrowser(), permitir: ["admin", "organizador"], aoLiberar: (p) => { papel = p; } }).then((liberado) => {
    if (!liberado) return;
    const campeonatos = criarCampeonatoStoreBrowser();
    void iniciarEdicao({
      store: campeonatos,
      categoriaStore: criarCategoriaStoreBrowser(),
      // Para "copiar categorias de outro evento": o organizador só vê os dele.
      listarEventosParaCopiar: async () => {
        const r = papel === "organizador" ? await campeonatos.listarMeus() : await campeonatos.listar();
        return r.ok ? r.valor.map((c) => ({ id: c.id, nome: c.nome })) : [];
      },
      id: new URLSearchParams(window.location.search).get("id"),
      verificarPosse: papel === "organizador",
      // Depois de excluir de vez, volta para a lista de GERENCIAMENTO.
      irParaLista: irParaGerenciarCampeonatos,
    });
  });
</script>
