---
import Layout from "../../layouts/Layout.astro";
import PaginaTopo from "../../components/PaginaTopo.astro";
import CampeonatosLista from "../../components/CampeonatosLista.astro";
import GuardaAcesso from "../../components/GuardaAcesso.astro";
import { comBase } from "../../utils/url";

// ÁREA DE GERENCIAMENTO: criar, alterar, arquivar e excluir campeonatos (eventos).
//
// Administradores e organizadores logados usam esta área; o organizador vê e
// gerencia só os campeonatos em que é dono. O conteúdo fica atrás de
// GuardaAcesso (revelado por scripts/guarda.ts) e a escrita no banco exige
// eh_admin() ou ser dono do evento (RLS). A guarda da tela é só de interface:
// o HTML estático continua baixável; quem protege os dados é o RLS.
---

<Layout
  titulo="Gerenciar campeonatos — Pingo Futevôlei"
  descricao="Área de gerenciamento de campeonatos."
  noindex
>
  <GuardaAcesso>
  <PaginaTopo
    titulo="Gerenciar campeonatos"
    subtitulo="Cadastro, edição, arquivamento e exclusão de eventos."
    voltarHref={comBase("/gerenciar")}
    voltarTexto="Voltar ao painel"
  >
    <a slot="acoes" class="btn-destaque" href="#novo-campeonato">
      <span aria-hidden="true">+</span> Novo campeonato
    </a>
  </PaginaTopo>

  <CampeonatosLista />
  </GuardaAcesso>
</Layout>

<script>
  import { iniciarLista } from "../../scripts/campeonatos-lista";
  import { criarCampeonatoStoreBrowser } from "../../store/campeonatoStore";
  import { hrefGerenciarCampeonato } from "../../scripts/rotas-gerenciar";
  import { guardarAcesso } from "../../scripts/guarda";
  import { criarAuthStoreBrowser } from "../../store/authStore";

  // A lista só inicia depois que a guarda libera o acesso. Administrador vê todos
  // os campeonatos; organizador, só aqueles em que é dono (o banco confere).
  let papel: "admin" | "organizador" = "admin";
  void guardarAcesso({ store: criarAuthStoreBrowser(), permitir: ["admin", "organizador"], aoLiberar: (p) => { papel = p; } }).then((liberado) => {
    if (!liberado) return;
    void iniciarLista({
      store: criarCampeonatoStoreBrowser(),
      hrefEditar: hrefGerenciarCampeonato,
      apenasMeus: papel === "organizador",
    });
  });
</script>
