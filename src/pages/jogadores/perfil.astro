---
import Layout from "../../layouts/Layout.astro";
import PaginaTopo from "../../components/PaginaTopo.astro";
import JogadorPerfil from "../../components/JogadorPerfil.astro";
import { comBase } from "../../utils/url";

// Perfil PÚBLICO de um jogador (?id=…): resumo e histórico de duplas, somente
// leitura. O site é estático e os jogadores existem só em runtime, então o id vai
// na query string de uma única página.
---

<Layout
  titulo="Perfil do jogador — Pingo Futevôlei"
  descricao="Perfil de jogador de futevôlei."
>
  <PaginaTopo
    titulo="Perfil do jogador"
    voltarHref={comBase("/jogadores")}
    voltarTexto="Voltar aos jogadores"
  />

  <JogadorPerfil />
</Layout>

<script>
  import { iniciarPerfil } from "../../scripts/jogador-perfil";
  import { lerEventosComDetalhe } from "../../scripts/eventos-detalhe";
  import { criarJogadorStoreBrowser } from "../../store/jogadorStore";

  void iniciarPerfil({
    store: criarJogadorStoreBrowser(),
    id: new URLSearchParams(window.location.search).get("id"),
    eventosComDetalhe: lerEventosComDetalhe(),
  });
</script>
