---
import Layout from "../../layouts/Layout.astro";
import PaginaTopo from "../../components/PaginaTopo.astro";
import JogadoresLista from "../../components/JogadoresLista.astro";
import { comBase } from "../../utils/url";

// Consulta PÚBLICA: lista e perfil dos jogadores, somente leitura. Cadastro,
// edição e exclusão ficam em /gerenciar_jogadores (sem link em nenhuma página).
---

<Layout
  titulo="Jogadores — Pingo Futevôlei"
  descricao="Consulte os perfis dos jogadores de futevôlei."
>
  <PaginaTopo
    titulo="Jogadores"
    subtitulo="Consulte os perfis dos atletas."
    voltarHref={comBase("/")}
    voltarTexto="Voltar aos eventos"
  />

  <JogadoresLista />
</Layout>

<script>
  import { iniciarLista } from "../../scripts/jogadores-lista";
  import { criarJogadorStoreBrowser } from "../../store/jogadorStore";

  void iniciarLista({ store: criarJogadorStoreBrowser() });
</script>
