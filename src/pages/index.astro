---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import EventsSection from "../components/EventsSection.astro";
import { carregarCampeonatos } from "../utils/torneios";
import {
  opcoesCidades,
  contagemNiveis,
  contagemGeneros,
  opcoesPresetsMes,
} from "../utils/eventos";

/*
  Dono dos dados: como a SearchBar é renderizada dentro do Hero (e não no
  EventsSection), a página deriva aqui no build as opções dos filtros a partir
  do JSON (src/data/torneios.json, via carregarCampeonatos) e as repassa ao
  Hero → SearchBar:
   - cidades: lista normalizada (via cidadeDoLocal) com contagem por cidade;
   - presets: meses com eventos (chips de período), relativos resolvidos no cliente;
   - niveis / generos: as categorias (texto livre) reduzidas a Nível e Gênero,
     com contagem de eventos (ver utils/categorias.ts).
  A ordem dos cards continua sob responsabilidade do EventsSection.
*/
const campeonatos = carregarCampeonatos();
const cidades = opcoesCidades(campeonatos);
const niveis = contagemNiveis(campeonatos);
const generos = contagemGeneros(campeonatos);
const presetsMes = opcoesPresetsMes(campeonatos);
---

<Layout>
  {/*
    Hero com foto de futevôlei de fundo (Requirement 3.3). O overlay
    azul-marinho do Hero preserva o contraste AA do texto sobreposto.
    Para trocar a foto, substitua public/hero-futevolei.jpg (mantém-se o
    fallback azul-marinho caso a prop `imagem` seja removida).
  */}
  <Hero
    imagem="/hero-futevolei.jpg"
    cidades={cidades}
    niveis={niveis}
    generos={generos}
    presetsMes={presetsMes}
  />
  <EventsSection />
</Layout>
