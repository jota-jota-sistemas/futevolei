---
import Layout from "../../layouts/Layout.astro";
import PaginaTopo from "../../components/PaginaTopo.astro";
import JogadoresLista from "../../components/JogadoresLista.astro";
import GuardaAcesso from "../../components/GuardaAcesso.astro";
import { comBase } from "../../utils/url";

// ÁREA DE GERENCIAMENTO: criar, alterar e excluir jogadores.
//
// Só administradores logados usam esta área. O conteúdo fica atrás de
// GuardaAcesso (revelado por scripts/guarda.ts) e a escrita no banco exige
// eh_admin() no RLS. A guarda da tela é só de interface: o HTML estático
// continua baixável; quem protege os dados é o RLS.
---

<Layout
  titulo="Gerenciar jogadores — Pingo Futevôlei"
  descricao="Área de gerenciamento de jogadores."
  noindex
>
  <GuardaAcesso>
  <PaginaTopo
    titulo="Gerenciar jogadores"
    subtitulo="Cadastro, edição e exclusão de perfis."
    voltarHref={comBase("/jogadores")}
    voltarTexto="Ver lista pública"
  >
    <a slot="acoes" class="btn-destaque" href="#novo-jogador">
      <span aria-hidden="true">+</span> Novo jogador
    </a>
  </PaginaTopo>

  <JogadoresLista gerenciar />
  </GuardaAcesso>
</Layout>

<script>
  import { iniciarLista } from "../../scripts/jogadores-lista";
  import { criarJogadorStoreBrowser } from "../../store/jogadorStore";
  import { hrefGerenciarJogador } from "../../scripts/rotas-gerenciar";
  import { guardarAcesso } from "../../scripts/guarda";
  import { criarAuthStoreBrowser } from "../../store/authStore";

  // A lista só inicia depois que a guarda libera o acesso (administrador).
  void guardarAcesso({ store: criarAuthStoreBrowser() }).then((liberado) => {
    if (!liberado) return;
    void iniciarLista({
      store: criarJogadorStoreBrowser(),
      gerenciar: true,
      hrefPerfil: hrefGerenciarJogador,
    });
  });
</script>
