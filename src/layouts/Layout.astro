---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { comBase } from "../utils/url";

interface Props {
  titulo?: string;
  descricao?: string;
}

const {
  titulo = "Pingo — futevôlei",
  descricao =
    "Campeonatos, partidas e experiências de futevôlei em um só lugar.",
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descricao} />
    <link rel="icon" type="image/svg+xml" href={comBase("/favicon.svg")} />
    <title>{titulo}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    /* Marca / destaque — laranja vibrante */
    --cor-destaque: #f97316;
    --cor-destaque-forte: #ea580c;
    --cor-destaque-suave: #fff1e6;

    /* Superfícies claras */
    --cor-fundo: #fdf8f1; /* creme / off-white */
    --cor-superficie: #ffffff; /* cards brancos */
    --cor-borda: #ece3d6;

    /* Zonas escuras — header e footer */
    --cor-escuro: #14110f;
    --cor-escuro-2: #241f1b;
    --cor-borda-escura: #342d27;

    /* Texto */
    --cor-texto: #1a1a1a;
    --cor-texto-suave: #6b6b6b;
    --cor-texto-claro: #f7f3ee;
    --cor-texto-claro-suave: #b9b0a6;

    /* Layout */
    --largura-conteudo: 1200px;
    --raio-card: 16px;

    color-scheme: light; /* paleta fixa PINGO; sem dark mode do SO */
  }

  * {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    font-family:
      system-ui,
      -apple-system,
      "Segoe UI",
      Roboto,
      Helvetica,
      Arial,
      sans-serif;
    background: var(--cor-fundo);
    color: var(--cor-texto);
    line-height: 1.5;
  }

  main {
    min-height: 40vh;
  }

  img {
    max-width: 100%;
  }

  :focus-visible {
    outline: 2px solid var(--cor-destaque);
    outline-offset: 2px;
  }

  /* Botão de destaque laranja reutilizável */
  .btn-destaque {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.7rem 1.3rem;
    border: none;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    background: var(--cor-destaque);
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .btn-destaque:hover {
    background: var(--cor-destaque-forte);
  }

  /* Controle placeholder: visual presente, porém inerte ("disponível em breve") */
  .placeholder {
    cursor: not-allowed;
    opacity: 0.6;
    pointer-events: none;
  }

  .btn-destaque.placeholder:hover {
    background: var(--cor-destaque);
    transform: none;
  }
</style>
