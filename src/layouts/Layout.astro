---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { comBase } from "../utils/url";

interface Props {
  titulo?: string;
  descricao?: string;
}

const {
  titulo = "Pingo — futevôlei",
  descricao =
    "Campeonatos, partidas e experiências de futevôlei em um só lugar.",
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descricao} />
    <link rel="icon" type="image/png" href={comBase("/icone.png")} />
    <title>{titulo}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    /* Marca / destaque — turquesa */
    --cor-destaque: #00b8a9; /* fill de CTA, badges, barras */
    --cor-destaque-forte: #009b8e; /* hover de fill */
    --cor-destaque-suave: #e3f5f2; /* fundo de mídia vazia (turquesa bem claro) */
    --cor-destaque-texto: #00695f; /* turquesa como TEXTO/ícone sobre claro (AA) */
    --cor-destaque-contraste: #102a43; /* texto sobre fill turquesa (azul-marinho, AA) */

    /* Superfícies claras */
    --cor-fundo: #f2e8d8; /* areia */
    --cor-superficie: #ffffff; /* cards brancos */
    --cor-borda: #e0d4bf; /* areia mais escura */

    /* Zonas escuras — header, footer e hero fallback */
    --cor-escuro: #102a43; /* azul-marinho */
    --cor-escuro-2: #1c3d5a; /* azul-marinho mais claro */
    --cor-borda-escura: #243b53; /* azul-marinho de contorno */

    /* Texto */
    --cor-texto: #102a43; /* azul-marinho (texto escuro sobre claro) */
    --cor-texto-suave: #4a5b6b; /* azul-acinzentado */
    --cor-texto-claro: #ffffff; /* branco (sobre escuro) */
    --cor-texto-claro-suave: #9fb3c8; /* azul-claro dessaturado (sobre escuro) */

    /* Layout */
    --largura-conteudo: 1200px;
    --raio-card: 16px;

    color-scheme: light; /* paleta fixa PINGO; sem dark mode do SO */
  }

  * {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    font-family:
      system-ui,
      -apple-system,
      "Segoe UI",
      Roboto,
      Helvetica,
      Arial,
      sans-serif;
    background: var(--cor-fundo);
    color: var(--cor-texto);
    line-height: 1.5;
  }

  main {
    min-height: 40vh;
  }

  img {
    max-width: 100%;
  }

  /*
   * Indicador de foco com DUPLO CONTORNO, robusto em qualquer fundo do site.
   * O outline turquesa (--cor-destaque) é visível sobre zonas escuras
   * (azul-marinho), onde rende ~5.9:1. O anel interno azul-marinho
   * (--cor-destaque-contraste, #102A43) via box-shadow garante >= 3:1 sobre
   * fundos claros (areia 8.9:1, branco 14.6:1). Assim o indicador sempre tem
   * ao menos uma borda com >= 3:1 contra qualquer fundo: o anel escuro em
   * fundos claros e o turquesa em fundos escuros.
   */
  :focus-visible {
    outline: 3px solid var(--cor-destaque);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--cor-destaque-contraste);
  }

  /* Botão de destaque laranja reutilizável */
  .btn-destaque {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.7rem 1.3rem;
    border: none;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--cor-destaque-contraste);
    background: var(--cor-destaque);
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .btn-destaque:hover {
    background: var(--cor-destaque-forte);
  }

  /* Controle placeholder: visual presente, porém inerte ("disponível em breve") */
  .placeholder {
    cursor: not-allowed;
    opacity: 0.6;
    pointer-events: none;
  }

  .btn-destaque.placeholder:hover {
    background: var(--cor-destaque);
    transform: none;
  }
</style>
