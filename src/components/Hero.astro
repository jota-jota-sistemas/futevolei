---
import SearchBar from "./SearchBar.astro";
import { comBase } from "../utils/url";

interface Props {
  /**
   * Imagem de fundo do hero (relativa à pasta public/). Opcional:
   * quando ausente, o hero usa o gradiente escuro como fundo, mantendo
   * o texto legível. Basta colocar um arquivo em public/ e passar o caminho.
   */
  imagem?: string;
  /**
   * Opções dos filtros da SearchBar, derivadas dos dados no build e repassadas
   * sem transformação. O Hero apenas encaminha para a SearchBar.
   */
  cidades?: { cidade: string; total: number }[];
  niveis?: { nivel: string; total: number }[];
  generos?: { genero: string; total: number }[];
  presetsMes?: { valor: string; rotulo: string; total: number }[];
}

const {
  imagem,
  cidades = [],
  niveis = [],
  generos = [],
  presetsMes = [],
} = Astro.props;
const bg = imagem ? comBase(imagem) : null;
---

<section
  class="hero"
  style={bg ? `--hero-bg: url('${bg}')` : undefined}
  data-com-imagem={bg ? "true" : "false"}
>
  <div class="hero__overlay"></div>
  <div class="hero__conteudo">
    <div class="hero__texto">
      <h1 class="hero__titulo">
        Encontre seu<br />próximo <span class="hero__realce">jogo</span>.
      </h1>
      <p class="hero__subtitulo">
        Campeonatos, partidas e experiências de futevôlei em um só lugar.
      </p>
    </div>
    <SearchBar
      cidades={cidades}
      niveis={niveis}
      generos={generos}
      presetsMes={presetsMes}
    />
  </div>
</section>

<style>
  .hero {
    position: relative;
    background-color: var(--cor-escuro);
    background-size: cover;
    /* Foto paisagem (3:2) com a ação no centro-superior; ancorar no topo
       mantém o jogador e a bola visíveis ao cortar verticalmente. */
    background-position: center top;
    overflow: hidden;
  }

  .hero[data-com-imagem="true"] {
    background-image: var(--hero-bg);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    /* No mobile o texto ocupa a largura toda: overlay mais uniforme para
       garantir contraste em qualquer ponto. */
    background: linear-gradient(
      180deg,
      rgba(16, 42, 67, 0.8) 0%,
      rgba(16, 42, 67, 0.68) 100%
    );
  }

  /* ---- Base: mobile ---- */
  .hero__conteudo {
    position: relative;
    max-width: var(--largura-conteudo);
    margin: 0 auto;
    padding: 2.5rem 1rem 1.5rem;
  }

  .hero__texto {
    max-width: 560px;
  }

  .hero__titulo {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    line-height: 1.05;
    font-weight: 800;
    font-style: italic;
    color: var(--cor-texto-claro);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .hero__realce {
    color: var(--cor-destaque);
  }

  .hero__subtitulo {
    margin: 1rem 0 0;
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    color: var(--cor-texto-claro-suave);
    max-width: 440px;
  }

  .hero__conteudo :global(.busca) {
    margin-top: 1.75rem;
  }

  /* ---- A partir de 768px ---- */
  @media (min-width: 768px) {
    .hero {
      /* No desktop o texto fica à esquerda; a jogada (jogador + bola) está à
         direita/centro da foto, então o gradiente deixa a direita mais clara. */
      background-position: center center;
    }

    .hero__overlay {
      background: linear-gradient(
        90deg,
        rgba(16, 42, 67, 0.9) 0%,
        rgba(16, 42, 67, 0.65) 45%,
        rgba(16, 42, 67, 0.3) 100%
      );
    }

    .hero__conteudo {
      padding: 4rem 1.5rem 2.5rem;
    }

    .hero__conteudo :global(.busca) {
      margin-top: 2.5rem;
    }
  }
</style>
