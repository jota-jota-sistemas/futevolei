---
import { comBase } from "../utils/url";

interface Props {
  /** "escuro" = usado sobre header/footer escuros; "claro" = sobre fundo creme */
  variante?: "claro" | "escuro";
  /** quando true, envolve a marca num link para a home */
  comLink?: boolean;
}

const { variante = "claro", comLink = false } = Astro.props;
const classeTexto = variante === "escuro" ? "marca--escuro" : "marca--claro";
const Tag = comLink ? "a" : "div";
const attrs = comLink ? { href: comBase("/") } : {};
---

<Tag class={`marca ${classeTexto}`} {...attrs}>
  <!-- Bola de futevôlei estilizada (laranja). Se não renderizar, o texto permanece. -->
  <svg
    class="marca__bola"
    viewBox="0 0 32 32"
    width="30"
    height="30"
    aria-hidden="true"
  >
    <circle cx="16" cy="16" r="14" fill="var(--cor-destaque)" />
    <path
      d="M16 4 C20 9 20 23 16 28 M6 11 C12 13 20 13 26 11 M6 21 C12 19 20 19 26 21"
      fill="none"
      stroke="#14110f"
      stroke-width="1.6"
      stroke-linecap="round"
    />
    <circle
      cx="16"
      cy="16"
      r="14"
      fill="none"
      stroke="#14110f"
      stroke-width="1.6"
    />
  </svg>
  <span class="marca__texto">
    <span class="marca__nome">Pingo</span>
    <span class="marca__sub">FUTEVÔLEI</span>
  </span>
</Tag>

<style>
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
  }

  .marca__bola {
    flex-shrink: 0;
  }

  .marca__texto {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .marca__nome {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    font-style: italic;
  }

  .marca__sub {
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    margin-top: 0.2rem;
  }

  .marca--claro {
    color: var(--cor-texto);
  }

  .marca--escuro {
    color: var(--cor-texto-claro);
  }
</style>
