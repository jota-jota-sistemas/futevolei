---
import { comBase } from "../utils/url";

interface Props {
  /** "escuro" = usado sobre header/footer azul-marinho; "claro" = sobre fundo areia */
  variante?: "claro" | "escuro";
  /** quando true, envolve a marca num link para a home */
  comLink?: boolean;
}

const { variante = "claro", comLink = false } = Astro.props;
const Tag = comLink ? "a" : "div";
const attrs = comLink ? { href: comBase("/") } : {};

/*
 * Logo oficial "Pingo FTV" (arte PNG com fundo transparente).
 *
 * São duas versões da MESMA arte, escolhidas pela variante para garantir
 * contraste do wordmark:
 *   - claro  (sobre areia): logo original, com "PINGO" em azul-marinho.
 *   - escuro (header/footer azul-marinho): versão com "PINGO"/"FTV" em branco,
 *     gerada a partir do original por scripts/gerar-logo-claro.mjs. O símbolo
 *     turquesa e o bloco "FTV" turquesa são idênticos nas duas.
 *
 * Proporção da arte: 1388x413 (~3.36:1). A altura é fixada via CSS e a largura
 * acompanha automaticamente.
 */
const logo =
  variante === "escuro"
    ? comBase("/logo-pingo-ftv-claro.png")
    : comBase("/logo-pingo-ftv.png");
---

<Tag class="marca" {...attrs}>
  <img
    class="marca__img"
    src={logo}
    alt="Pingo FTV"
    width="1388"
    height="413"
  />
</Tag>

<style>
  .marca {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 0;
  }

  .marca__img {
    display: block;
    height: 40px;
    width: auto;
  }

  @media (min-width: 768px) {
    .marca__img {
      height: 44px;
    }
  }
</style>
