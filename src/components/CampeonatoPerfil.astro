---
// Edição de UM campeonato na área de gerenciamento (/gerenciar_campeonatos/editar):
// resumo, categorias (criar, remover e copiar, com o caminho para organizar), edição dos
// dados, arquivar/reativar e excluir. O comportamento é ligado pelo script da
// página (ver scripts/campeonato-editar.ts).
import Cartao from "./Cartao.astro";
import CampeonatoForm from "./CampeonatoForm.astro";
import CategoriasEditor from "./CategoriasEditor.astro";
---

<div class="perfil">
  <p class="perfil__estado" data-estado-perfil role="status">Carregando campeonato…</p>

  <div class="perfil__conteudo" data-perfil hidden>
    <div class="perfil__coluna">
      <Cartao titulo="Campeonato" id="resumo">
        <p class="resumo__nome" data-perfil-nome></p>
        <p class="resumo__linha" data-perfil-periodo></p>
        <p class="resumo__linha" data-perfil-local hidden></p>
        <div class="pf-chips" data-perfil-chips></div>
      </Cartao>

      <Cartao titulo="Categorias" id="categorias">
        <CategoriasEditor />
        <p class="categorias__ajuda">
          Crie as categorias aqui. As duplas e os chaveamentos de cada uma são montados na organização do evento.
        </p>
        <a class="gerenciar__botao categorias__link" data-organizar-link href="#">
          Ir para organizar
        </a>
      </Cartao>

      <Cartao titulo="Organizadores do evento" id="donos">
        <p class="donos__estado" data-donos-estado role="status" hidden></p>
        <ul class="pf-donos" data-donos-lista aria-label="Organizadores do evento"></ul>
        <form class="donos__form" data-donos-form novalidate>
          <label for="dono-email">Adicionar organizador (e-mail)</label>
          <div class="donos__linha">
            <input
              id="dono-email"
              name="email"
              type="email"
              maxlength="254"
              autocomplete="off"
              placeholder="pessoa@exemplo.com"
              aria-describedby="dono-ajuda"
            />
            <button type="submit" class="btn-destaque" data-donos-adicionar>Adicionar</button>
          </div>
          <p class="donos__ajuda" id="dono-ajuda">
            A pessoa precisa já ser organizadora: em Minha conta, “Quero ser organizador”.
          </p>
        </form>
        <p class="donos__status" data-donos-status role="status" aria-live="polite" hidden></p>
      </Cartao>

      <Cartao titulo="Duplicar" id="duplicar">
        <p class="duplicar__ajuda">
          Cria um campeonato novo com os mesmos dados (cidade, preço, link…). As datas já vêm
          52 semanas depois, no mesmo dia da semana. Duplas e placares não são copiados.
        </p>
        <form class="duplicar__form" data-duplicar-form novalidate>
          <div class="duplicar__campo">
            <label for="duplicar-nome">Nome do novo campeonato</label>
            <input id="duplicar-nome" name="nome" type="text" maxlength="120" autocomplete="off" />
          </div>
          <div class="duplicar__datas">
            <div class="duplicar__campo">
              <label for="duplicar-data">Data de início</label>
              <input id="duplicar-data" name="data" type="date" />
            </div>
            <div class="duplicar__campo">
              <label for="duplicar-data-fim">Data final</label>
              <input id="duplicar-data-fim" name="dataFim" type="date" />
            </div>
          </div>
          <label class="duplicar__check">
            <input type="checkbox" name="copiarCategorias" checked />
            Copiar as categorias
          </label>
          <p class="duplicar__erro" data-duplicar-erro role="alert" hidden></p>
          <button type="submit" class="btn-destaque duplicar__botao" data-duplicar-enviar>
            Criar cópia
          </button>
        </form>
      </Cartao>

      <Cartao titulo="Gerenciar" id="gerenciar">
        <div class="gerenciar__acoes">
          <button type="button" class="gerenciar__botao" data-arquivar>
            Arquivar campeonato
          </button>
          <button type="button" class="gerenciar__botao gerenciar__botao--perigo" data-excluir>
            Excluir campeonato
          </button>
        </div>

        <div class="confirmacao" data-confirmacao-exclusao role="alert" hidden>
          <p class="confirmacao__texto" data-confirmacao-texto></p>
          <div class="confirmacao__acoes">
            <button
              type="button"
              class="gerenciar__botao gerenciar__botao--perigo"
              data-confirmar-exclusao
            >
              Excluir de vez
            </button>
            <button type="button" class="gerenciar__botao" data-cancelar-exclusao>
              Cancelar
            </button>
          </div>
        </div>

        <p class="gerenciar__status" data-acoes-status role="status" aria-live="polite" hidden></p>
      </Cartao>
    </div>

    <Cartao titulo="Editar dados" id="editar">
      <CampeonatoForm prefixo="editar" rotuloEnvio="Salvar alterações" detalhesAbertos />
    </Cartao>
  </div>
</div>

<style>
  .perfil {
    max-width: var(--largura-conteudo);
    margin: 0 auto;
    padding: 1.25rem 1rem 3rem;
  }

  .perfil__estado {
    margin: 0;
    padding: 2rem 0;
    text-align: center;
    color: var(--cor-texto-suave);
  }

  .perfil__conteudo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 1.25rem;
  }

  .perfil__conteudo[hidden],
  .resumo__linha[hidden],
  .confirmacao[hidden],
  .gerenciar__status[hidden] {
    display: none;
  }

  .perfil__coluna {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  /* ---- Resumo ---- */
  .resumo__nome {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .resumo__linha {
    margin: 0.3rem 0 0;
    color: var(--cor-texto-suave);
    overflow-wrap: anywhere;
  }

  /* ---- Categorias ---- */
  .categorias__ajuda {
    margin: 1rem 0 0.8rem;
    font-size: 0.9rem;
    color: var(--cor-texto-suave);
  }

  .categorias__link {
    display: inline-block;
    text-decoration: none;
  }

  /* ---- Organizadores do evento ---- */
  .donos__estado,
  .donos__ajuda {
    margin: 0 0 0.8rem;
    font-size: 0.9rem;
    color: var(--cor-texto-suave);
  }

  .donos__estado[hidden],
  .donos__status[hidden] {
    display: none;
  }

  .donos__form label {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .donos__linha {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .donos__linha input {
    flex: 1 1 200px;
    min-width: 0;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--cor-texto-suave);
    border-radius: 12px;
    background: var(--cor-superficie);
    color: var(--cor-texto);
    font-family: inherit;
    font-size: 1rem;
  }

  .donos__linha input[aria-invalid="true"] {
    border-color: var(--cor-erro);
    border-width: 2px;
  }

  .donos__linha button[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .donos__ajuda {
    margin: 0.5rem 0 0;
  }

  .donos__status {
    margin: 0.8rem 0 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--cor-destaque-texto);
  }

  .donos__status[data-tipo="erro"] {
    color: var(--cor-erro);
  }

  /* ---- Duplicar ---- */
  .duplicar__ajuda {
    margin: 0 0 1rem;
    font-size: 0.9rem;
    color: var(--cor-texto-suave);
  }

  .duplicar__form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .duplicar__datas {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
  }

  .duplicar__campo {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .duplicar__campo label {
    font-size: 0.8rem;
    font-weight: 700;
  }

  .duplicar__campo input {
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--cor-texto-suave);
    border-radius: 12px;
    background: var(--cor-superficie);
    color: var(--cor-texto);
    font-family: inherit;
    font-size: 1rem; /* 16px evita o zoom automático do iOS */
  }

  .duplicar__check {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-size: 0.95rem;
    cursor: pointer;
  }

  .duplicar__check input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--cor-destaque-texto);
  }

  .duplicar__erro {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--cor-erro);
  }

  .duplicar__erro[hidden] {
    display: none;
  }

  .duplicar__erro :global(a) {
    color: var(--cor-destaque-texto);
    font-weight: 700;
  }

  .duplicar__botao {
    min-height: 44px;
  }

  .duplicar__botao[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
  }

  @media (min-width: 560px) {
    .duplicar__datas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---- Gerenciar ---- */
  .gerenciar__acoes,
  .confirmacao__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .gerenciar__botao {
    padding: 0.65rem 1.2rem;
    border: 1.5px solid var(--cor-escuro);
    border-radius: 999px;
    background: none;
    color: var(--cor-texto);
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
  }

  .gerenciar__botao:hover {
    background: var(--cor-escuro);
    color: var(--cor-texto-claro);
  }

  .gerenciar__botao--perigo {
    border-color: var(--cor-erro);
    color: var(--cor-erro);
  }

  .gerenciar__botao--perigo:hover {
    background: var(--cor-erro);
    color: #ffffff;
  }

  .gerenciar__botao[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .confirmacao {
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    border: 1.5px solid var(--cor-erro);
    border-radius: 12px;
  }

  .confirmacao__texto {
    margin: 0 0 0.8rem;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .gerenciar__status {
    margin: 1rem 0 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--cor-destaque-texto);
  }

  .gerenciar__status[data-tipo="erro"] {
    color: var(--cor-erro);
  }

  @media (min-width: 900px) {
    .perfil {
      padding: 2rem 1.5rem 4rem;
    }

    .perfil__conteudo {
      grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
</style>

<!-- Elementos criados em runtime pelo script: CSS global com prefixo `pf-`. -->
<style is:global>
  .pf-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .pf-chip {
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    background: var(--cor-destaque-suave);
    color: var(--cor-destaque-texto);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1;
  }

  .pf-chip--arquivado {
    background: var(--cor-borda);
    color: var(--cor-texto);
  }

  .pf-donos {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .pf-dono {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--cor-borda);
    border-radius: 12px;
    background: var(--cor-superficie);
  }

  .pf-dono__email {
    min-width: 0;
    overflow-wrap: anywhere;
    font-weight: 600;
  }

  .pf-dono__remover {
    flex: none;
    padding: 0.4rem 0.9rem;
    border: 1.5px solid var(--cor-erro);
    border-radius: 999px;
    background: none;
    color: var(--cor-erro);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
  }

  .pf-dono__remover:hover {
    background: var(--cor-erro);
    color: #ffffff;
  }

  .pf-dono__remover[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .pf-retentar {
    padding: 0;
    border: none;
    background: none;
    color: var(--cor-destaque-texto);
    font-family: inherit;
    font-size: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
  }
</style>
