---
// Barra de busca: visual da referência, inerte na fase atual ("disponível em breve").
// CSS mobile-first: base é coluna única (mobile); a partir de 768px vira a
// barra horizontal arredondada com divisores entre os campos.
---

<form class="busca" aria-label="Buscar eventos" onsubmit="return false">
  <div class="busca__campo">
    <span class="busca__icone" aria-hidden="true">📍</span>
    <div class="busca__texto">
      <label class="busca__rotulo">Onde?</label>
      <input
        class="busca__input placeholder"
        type="text"
        placeholder="Cidade, bairro ou arena"
        disabled
        title="Busca por local (disponível em breve)"
      />
    </div>
  </div>

  <div class="busca__campo">
    <span class="busca__icone" aria-hidden="true">📅</span>
    <div class="busca__texto">
      <label class="busca__rotulo">Quando?</label>
      <input
        class="busca__input placeholder"
        type="text"
        placeholder="Selecione uma data"
        disabled
        title="Busca por data (disponível em breve)"
      />
    </div>
  </div>

  <div class="busca__campo">
    <span class="busca__icone" aria-hidden="true">🏷️</span>
    <div class="busca__texto">
      <label class="busca__rotulo">Categoria</label>
      <input
        class="busca__input placeholder"
        type="text"
        placeholder="Todas as categorias"
        disabled
        title="Busca por categoria (disponível em breve)"
      />
    </div>
  </div>

  <button
    class="btn-destaque placeholder busca__botao"
    type="button"
    disabled
    title="Buscar eventos (disponível em breve)"
  >
    <span aria-hidden="true">🔍</span> Buscar eventos
  </button>
</form>

<style>
  /* ---- Base: mobile (coluna única) ---- */
  .busca {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    background: var(--cor-superficie);
    border-radius: var(--raio-card);
    padding: 0.75rem;
    box-shadow: 0 12px 30px rgba(16, 42, 67, 0.18);
  }

  .busca__campo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.25rem;
    border-bottom: 1px solid var(--cor-borda);
  }

  .busca__texto {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .busca__rotulo {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--cor-texto);
  }

  .busca__input {
    border: none;
    background: none;
    padding: 0.1rem 0;
    font-size: 0.85rem;
    color: var(--cor-texto-suave);
    width: 100%;
  }

  .busca__input::placeholder {
    color: var(--cor-texto-suave);
  }

  .busca__botao {
    white-space: nowrap;
    margin-top: 0.5rem;
    width: 100%;
  }

  /* ---- A partir de 768px: barra horizontal arredondada ---- */
  @media (min-width: 768px) {
    .busca {
      grid-template-columns: repeat(3, 1fr) auto;
      align-items: center;
      gap: 0.5rem;
      border-radius: 999px;
      padding: 0.5rem 0.5rem 0.5rem 1rem;
    }

    .busca__campo {
      padding: 0.35rem 0.75rem;
      border-bottom: none;
      border-right: 1px solid var(--cor-borda);
    }

    .busca__botao {
      margin-top: 0;
      width: auto;
    }
  }
</style>
