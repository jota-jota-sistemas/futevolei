---
import type { Campeonato } from "../types";
import campeonatosData from "../data/campeonatos.json";
import CampeonatoCard from "./CampeonatoCard.astro";

const campeonatos = campeonatosData as Campeonato[];

// Ordena por data: os próximos campeonatos aparecem primeiro.
const ordenados = [...campeonatos].sort((a, b) =>
  a.data.localeCompare(b.data),
);
---

<section class="feed" aria-label="Campeonatos de futevôlei">
  {
    ordenados.length === 0 ? (
      <p class="feed__vazio">Nenhum campeonato cadastrado no momento.</p>
    ) : (
      ordenados.map((campeonato) => (
        <CampeonatoCard campeonato={campeonato} />
      ))
    )
  }
</section>

<style>
  .feed {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    max-width: 480px; /* coluna estreita estilo Instagram no mobile/desktop */
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }

  .feed__vazio {
    text-align: center;
    color: var(--cor-texto-suave);
    padding: 3rem 0;
  }
</style>
