---
// Formulário de campeonato (evento), reutilizado no cadastro (lista) e na edição.
// Só markup e estilo: a leitura, validação e o envio são feitos pelos scripts
// (scripts/campeonato-form.ts, campeonatos-lista.ts e campeonato-editar.ts) por
// meio dos atributos data-*. `novalidate`: as mensagens vêm do domínio, em pt-BR.
// O campo de foto não existe aqui de propósito (fora do escopo por enquanto).
import { UFS_BRASIL } from "../domain/jogadores/validation";

interface Props {
  /** Prefixo dos ids (evita colisão se houver mais de um formulário na página). */
  prefixo: string;
  rotuloEnvio: string;
}

const { prefixo, rotuloEnvio } = Astro.props;
---

<form class="cf" data-campeonato-form novalidate>
  <div class="cf__grade">
    <div class="cf__campo cf__campo--cheio">
      <label for={`${prefixo}-nome`}>Nome <span class="cf__obrig" aria-hidden="true">*</span></label>
      <input
        id={`${prefixo}-nome`}
        name="nome"
        type="text"
        maxlength="120"
        autocomplete="off"
        required
        aria-describedby={`${prefixo}-nome-erro`}
      />
      <p class="cf__erro" id={`${prefixo}-nome-erro`} data-erro="nome" hidden></p>
    </div>

    <div class="cf__campo">
      <label for={`${prefixo}-data`}>Data de início <span class="cf__obrig" aria-hidden="true">*</span></label>
      <input
        id={`${prefixo}-data`}
        name="data"
        type="date"
        required
        aria-describedby={`${prefixo}-data-erro`}
      />
      <p class="cf__erro" id={`${prefixo}-data-erro`} data-erro="data" hidden></p>
    </div>

    <div class="cf__campo">
      <label for={`${prefixo}-dataFim`}>Data final</label>
      <input
        id={`${prefixo}-dataFim`}
        name="dataFim"
        type="date"
        aria-describedby={`${prefixo}-dataFim-ajuda ${prefixo}-dataFim-erro`}
      />
      <p class="cf__ajuda" id={`${prefixo}-dataFim-ajuda`}>Só para eventos de mais de um dia.</p>
      <p class="cf__erro" id={`${prefixo}-dataFim-erro`} data-erro="dataFim" hidden></p>
    </div>

    <div class="cf__campo">
      <label for={`${prefixo}-cidade`}>Cidade</label>
      <input
        id={`${prefixo}-cidade`}
        name="cidade"
        type="text"
        maxlength="80"
        autocomplete="off"
        aria-describedby={`${prefixo}-cidade-erro`}
      />
      <p class="cf__erro" id={`${prefixo}-cidade-erro`} data-erro="cidade" hidden></p>
    </div>

    <div class="cf__campo">
      <label for={`${prefixo}-uf`}>UF</label>
      <select id={`${prefixo}-uf`} name="uf" aria-describedby={`${prefixo}-uf-erro`}>
        <option value="">—</option>
        {UFS_BRASIL.map((uf) => <option value={uf}>{uf}</option>)}
      </select>
      <p class="cf__erro" id={`${prefixo}-uf-erro`} data-erro="uf" hidden></p>
    </div>

    <div class="cf__campo cf__campo--cheio">
      <label for={`${prefixo}-endereco`}>Arena / endereço</label>
      <input
        id={`${prefixo}-endereco`}
        name="endereco"
        type="text"
        maxlength="200"
        autocomplete="off"
        aria-describedby={`${prefixo}-endereco-erro`}
      />
      <p class="cf__erro" id={`${prefixo}-endereco-erro`} data-erro="endereco" hidden></p>
    </div>

    <div class="cf__campo">
      <label for={`${prefixo}-preco`}>Preço (R$)</label>
      <input
        id={`${prefixo}-preco`}
        name="preco"
        type="text"
        inputmode="decimal"
        maxlength="20"
        autocomplete="off"
        placeholder="160,00"
        aria-describedby={`${prefixo}-preco-erro`}
      />
      <p class="cf__erro" id={`${prefixo}-preco-erro`} data-erro="preco" hidden></p>
    </div>

    <div class="cf__campo">
      <label for={`${prefixo}-precoTexto`}>Preço como texto</label>
      <input
        id={`${prefixo}-precoTexto`}
        name="precoTexto"
        type="text"
        maxlength="60"
        autocomplete="off"
        placeholder="R$ 160,00 ou Valor a confirmar"
        aria-describedby={`${prefixo}-precoTexto-erro`}
      />
      <p class="cf__erro" id={`${prefixo}-precoTexto-erro`} data-erro="precoTexto" hidden></p>
    </div>

    <div class="cf__campo cf__campo--cheio">
      <label for={`${prefixo}-inscricao`}>Link de inscrição</label>
      <input
        id={`${prefixo}-inscricao`}
        name="inscricao"
        type="text"
        maxlength="500"
        autocomplete="off"
        placeholder="https://"
        aria-describedby={`${prefixo}-inscricao-erro`}
      />
      <p class="cf__erro" id={`${prefixo}-inscricao-erro`} data-erro="inscricao" hidden></p>
    </div>

    <div class="cf__campo cf__campo--cheio">
      <label for={`${prefixo}-instagram`}>Instagram</label>
      <input
        id={`${prefixo}-instagram`}
        name="instagram"
        type="text"
        maxlength="200"
        autocomplete="off"
        placeholder="@usuario"
        aria-describedby={`${prefixo}-instagram-ajuda ${prefixo}-instagram-erro`}
      />
      <p class="cf__ajuda" id={`${prefixo}-instagram-ajuda`}>
        Aceita @usuario ou um link do instagram.com.
      </p>
      <p class="cf__erro" id={`${prefixo}-instagram-erro`} data-erro="instagram" hidden></p>
    </div>

    <div class="cf__campo cf__campo--cheio">
      <label for={`${prefixo}-descricao`}>Descrição</label>
      <textarea
        id={`${prefixo}-descricao`}
        name="descricao"
        rows="4"
        maxlength="2000"
        aria-describedby={`${prefixo}-descricao-erro`}></textarea>
      <p class="cf__erro" id={`${prefixo}-descricao-erro`} data-erro="descricao" hidden></p>
    </div>

    <div class="cf__campo cf__campo--cheio">
      <label class="cf__check">
        <input type="checkbox" name="listado" checked aria-describedby={`${prefixo}-listado-ajuda`} />
        Aparece na home e tem página de detalhe
      </label>
      <p class="cf__ajuda" id={`${prefixo}-listado-ajuda`}>
        Desmarcado, o evento só tem as telas de organizar e acompanhar.
      </p>
    </div>
  </div>

  <p class="cf__aviso">
    As alterações aparecem no site público em cerca de 1 minuto (o site guarda cada página em cache por pouco tempo).
  </p>

  <p class="cf__status" data-status role="status" aria-live="polite" hidden></p>

  <div class="cf__acoes">
    <button type="submit" class="btn-destaque" data-enviar>{rotuloEnvio}</button>
    <slot />
  </div>
</form>

<style>
  .cf {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cf__grade {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
  }

  .cf__campo {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .cf__campo label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--cor-texto);
  }

  .cf__obrig {
    color: var(--cor-erro);
  }

  /* Borda escura o bastante para o contorno do campo ter contraste de interface (>= 3:1). */
  .cf__campo input:not([type="checkbox"]),
  .cf__campo select,
  .cf__campo textarea {
    width: 100%;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--cor-texto-suave);
    border-radius: 12px;
    background: var(--cor-superficie);
    color: var(--cor-texto);
    font-family: inherit;
    font-size: 1rem; /* 16px evita o zoom automático do iOS ao focar */
  }

  .cf__campo textarea {
    resize: vertical;
  }

  .cf__campo input[aria-invalid="true"],
  .cf__campo select[aria-invalid="true"],
  .cf__campo textarea[aria-invalid="true"] {
    border-color: var(--cor-erro);
    border-width: 2px;
  }

  .cf__campo .cf__check {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-size: 0.95rem;
    cursor: pointer;
  }

  .cf__check input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--cor-destaque-texto);
  }

  .cf__ajuda {
    margin: 0;
    font-size: 0.8rem;
    color: var(--cor-texto-suave);
  }

  .cf__erro {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--cor-erro);
  }

  .cf__aviso {
    margin: 0;
    font-size: 0.85rem;
    color: var(--cor-texto-suave);
  }

  .cf__acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .cf__status {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--cor-destaque-texto);
  }

  .cf__status[data-tipo="erro"] {
    color: var(--cor-erro);
  }

  .cf button[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
  }

  @media (min-width: 560px) {
    .cf__grade {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cf__campo--cheio {
      grid-column: 1 / -1;
    }
  }
</style>
