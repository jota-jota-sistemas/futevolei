---
import BrandLogo from "./BrandLogo.astro";
import { comBase } from "../utils/url";
---

<header class="header">
  <div class="header__conteudo">
    <BrandLogo variante="escuro" comLink={true} />

    <nav class="header__nav" aria-label="Navegação principal">
      <a
        class="header__link placeholder"
        aria-disabled="true"
        title="Eventos (disponível em breve)">Eventos</a
      >
      <a class="header__link" href={comBase("/jogadores")}>Jogadores</a>
      <a
        class="header__link placeholder"
        aria-disabled="true"
        title="Como funciona (disponível em breve)">Como funciona</a
      >
      <a
        class="header__link placeholder"
        aria-disabled="true"
        title="Para organizadores (disponível em breve)">Para organizadores</a
      >
    </nav>

    <div class="header__acoes">
      <button
        class="header__menu placeholder"
        type="button"
        disabled
        aria-label="Abrir menu (disponível em breve)"
        title="Abrir menu (disponível em breve)"
      >
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path>
        </svg>
      </button>
      <button
        class="btn-destaque header__criar placeholder"
        type="button"
        disabled
        title="Criar evento (disponível em breve)"
      >
        <span aria-hidden="true">+</span> Criar evento
      </button>
      <button
        class="header__conta placeholder"
        type="button"
        disabled
        aria-label="Minha conta (disponível em breve)"
        title="Minha conta (disponível em breve)"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <circle
            cx="12"
            cy="8"
            r="4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"></circle>
          <path
            d="M4 20c0-4 4-6 8-6s8 2 8 6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--cor-escuro);
    border-bottom: 1px solid var(--cor-borda-escura);
  }

  .header__conteudo {
    max-width: var(--largura-conteudo);
    margin: 0 auto;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* ---- Base: mobile ---- */
  /* Nav colapsada; mostra só o logo e o botão de menu. */
  .header__nav {
    display: none;
    align-items: center;
    gap: 1.5rem;
    flex: 1;
  }

  .header__link {
    color: var(--cor-texto-claro);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    position: relative;
  }

  .header__acoes {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  /* No mobile, apenas o menu hambúrguer aparece nas ações. */
  .header__menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: 1px solid var(--cor-borda-escura);
    background: var(--cor-escuro-2);
    color: var(--cor-texto-claro);
  }

  .header__criar {
    display: none;
  }

  .header__conta {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--cor-borda-escura);
    background: var(--cor-escuro-2);
    color: var(--cor-texto-claro);
  }

  /* ---- A partir de 768px: nav e ações completas ---- */
  @media (min-width: 768px) {
    .header__conteudo {
      padding: 0.85rem 1.5rem;
      gap: 1.5rem;
    }

    .header__nav {
      display: flex;
    }

    .header__acoes {
      gap: 1rem;
    }

    .header__menu {
      display: none;
    }

    .header__criar {
      display: inline-flex;
    }

    .header__conta {
      display: inline-flex;
    }
  }
</style>
