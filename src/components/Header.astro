---
import BrandLogo from "./BrandLogo.astro";
import { comBase } from "../utils/url";
import { ITENS_MENU, itemAtivo } from "../utils/menu";

const base = import.meta.env.BASE_URL || "/";
const caminho = Astro.url.pathname;
---

<header class="header">
  <div class="header__conteudo">
    <BrandLogo variante="escuro" comLink={true} />

    {/* O menu fica na própria barra do topo em qualquer largura. Com poucos
        itens não precisa de hambúrguer (nem de JavaScript); se a lista crescer,
        é aqui que um menu recolhível entraria. */}
    <nav class="header__nav" aria-label="Navegação principal">
      {
        ITENS_MENU.map((item) => (
          <a
            class="header__link"
            href={comBase(item.href)}
            aria-current={itemAtivo(item, caminho, base) ? "page" : undefined}
          >
            {item.rotulo}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--cor-escuro);
    border-bottom: 1px solid var(--cor-borda-escura);
  }

  .header__conteudo {
    max-width: var(--largura-conteudo);
    margin: 0 auto;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* ---- Base: mobile. Logo à esquerda, menu à direita, na mesma linha. ---- */
  .header__nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
    min-width: 0;
  }

  .header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* alvo de toque confortável */
    padding: 0 0.15rem;
    color: var(--cor-texto-claro-suave);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .header__link:hover {
    color: var(--cor-texto-claro);
  }

  /* Página atual: texto claro, mais forte e sublinhado turquesa. */
  .header__link[aria-current="page"] {
    color: var(--cor-texto-claro);
    font-weight: 700;
  }

  .header__link[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0.15rem;
    right: 0.15rem;
    bottom: 0.45rem;
    height: 2px;
    border-radius: 2px;
    background: var(--cor-destaque);
  }

  /* Telas muito estreitas (ex.: 320px): aperta um pouco para tudo caber. */
  @media (max-width: 359px) {
    .header__conteudo {
      padding: 0.75rem 0.75rem;
      gap: 0.5rem;
    }

    .header__nav {
      gap: 0.5rem;
    }

    .header__link {
      font-size: 0.9rem;
    }
  }

  /* ---- A partir de 768px: menu ao lado do logo ---- */
  @media (min-width: 768px) {
    .header__conteudo {
      padding: 0.85rem 1.5rem;
      gap: 1.5rem;
    }

    .header__nav {
      flex: 1;
      margin-left: 0;
      gap: 1.5rem;
    }

    .header__link {
      padding: 0;
    }

    .header__link[aria-current="page"]::after {
      left: 0;
      right: 0;
    }
  }
</style>
