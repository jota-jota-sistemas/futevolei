---
// Envolve o conteúdo de uma tela de GERENCIAMENTO. O conteúdo nasce oculto e só
// é revelado por scripts/guarda.ts para administradores logados. Isto é uma
// guarda de interface: a proteção real dos dados é o RLS do Supabase.
import { comBase } from "../utils/url";
import { hrefConta } from "../scripts/rotas-auth";
---

<div class="guarda" data-guarda>
  <p class="guarda__estado" data-guarda-status role="status">Verificando acesso…</p>

  <div class="guarda__negado" data-guarda-negado hidden>
    <h2 class="guarda__titulo">Acesso restrito</h2>
    <p>
      Sua conta não tem permissão para usar esta área. Fale com a organização
      para ser autorizado.
    </p>
    <p class="guarda__acoes">
      <a class="btn-destaque" href={hrefConta()}>Minha conta</a>
      <a class="guarda__voltar" href={comBase("/")}>Voltar ao início</a>
    </p>
  </div>

  <noscript>
    <p class="guarda__estado">Ative o JavaScript para acessar esta área.</p>
  </noscript>

  <div data-protegido hidden>
    <slot />
  </div>
</div>

<style>
  .guarda__estado,
  .guarda__negado {
    max-width: 560px;
    margin: 2rem auto;
    padding: 1.25rem 1rem;
    background: var(--cor-superficie);
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio-card);
    color: var(--cor-texto);
  }

  .guarda__titulo {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }

  .guarda__acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .guarda__voltar {
    color: var(--cor-destaque-texto);
    font-weight: 600;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  /* Garante que [hidden] vença os estilos acima. */
  [hidden] {
    display: none !important;
  }
</style>
