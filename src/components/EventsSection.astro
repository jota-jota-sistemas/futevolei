---
import type { Campeonato } from "../types";
import campeonatosData from "../data/campeonatos.json";
import EventCard from "./EventCard.astro";
import { ordenarPorDataId } from "../utils/eventos";

const campeonatos = campeonatosData as Campeonato[];

// Ordena por data (asc); desempate por id para uma ordem determinística.
const ordenados = ordenarPorDataId(campeonatos);
---

<section class="eventos" aria-label="Próximos eventos">
  <div class="eventos__conteudo">
    <div class="eventos__topo">
      <h2 class="eventos__titulo">
        <span class="eventos__barra" aria-hidden="true"></span>
        Próximos eventos
      </h2>
      <span class="eventos__ver-todos placeholder" aria-disabled="true"
        title="Ver todos os eventos (disponível em breve)"
      >Ver todos os eventos →</span>
    </div>

    {/*
      Região de resultados: contador + chips de filtros ativos.
      Preenchida/atualizada pelo script client-side a cada busca. Começa com o
      total de eventos e sem chips. `aria-live=polite` anuncia a contagem a
      leitores de tela após filtrar.
    */}
    <div class="eventos__resultados" data-resultados hidden={ordenados.length === 0}>
      <p class="eventos__contador" data-contador aria-live="polite" role="status">
        {ordenados.length} eventos
      </p>
      <ul class="eventos__chips" data-chips aria-label="Filtros ativos"></ul>
    </div>

    {
      ordenados.length === 0 ? (
        <p class="eventos__vazio">Nenhum evento cadastrado no momento.</p>
      ) : (
        <div class="eventos__grid" data-grid-eventos>
          {ordenados.map((c) => <EventCard campeonato={c} />)}
          {/* Estado vazio de FILTRO: distinto do "nenhum evento cadastrado". */}
          {/* Alternado pelo script client-side quando nada corresponde aos filtros. */}
          <p class="eventos__vazio" data-vazio-filtro hidden>
            Nenhum evento corresponde aos filtros selecionados.
          </p>
        </div>
      )
    }
  </div>
</section>

<!-- Filtragem client-side (show/hide dos cards). Lógica detalhada na tarefa 5.1. -->
<script>
  import "../scripts/filtros-cliente.ts";
</script>

<style>
  /* ---- Base: mobile ---- */
  .eventos__conteudo {
    max-width: var(--largura-conteudo);
    margin: 0 auto;
    padding: 2rem 1rem 1rem;
  }

  .eventos__topo {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 1.25rem;
  }

  .eventos__titulo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.35rem;
    font-weight: 800;
    margin: 0;
  }

  .eventos__barra {
    width: 5px;
    height: 1.4rem;
    border-radius: 3px;
    background: var(--cor-destaque);
  }

  .eventos__ver-todos {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--cor-destaque-texto);
    text-decoration: none;
    white-space: nowrap;
  }

  /* ---- Região de resultados: contador + chips (mobile-first) ---- */
  .eventos__resultados {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .eventos__contador {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--cor-texto-suave);
  }

  .eventos__chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }

  /* Cada chip é um botão removível (toda a área é tocável — alvo >= 32px). */
  .eventos__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--cor-borda);
    border-radius: 999px;
    background: var(--cor-destaque-suave);
    color: var(--cor-destaque-texto);
    font-size: 0.8rem;
    font-weight: 600;
    font-family: inherit;
    line-height: 1;
    cursor: pointer;
  }

  .eventos__chip:hover {
    border-color: var(--cor-destaque-texto);
  }

  /* O "x" do chip: círculo discreto com contraste suficiente. */
  .eventos__chip-x {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: rgba(16, 42, 67, 0.12);
    font-size: 0.75rem;
    line-height: 1;
  }

  .eventos__vazio {
    text-align: center;
    color: var(--cor-texto-suave);
    padding: 3rem 0;
  }

  /* Dentro do grid, a mensagem de vazio de filtro ocupa a linha inteira. */
  .eventos__grid > .eventos__vazio {
    grid-column: 1 / -1;
  }

  .eventos__grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr; /* mobile: 1 coluna */
  }

  /* ---- Breakpoints crescentes ---- */
  @media (min-width: 640px) {
    .eventos__grid {
      grid-template-columns: repeat(2, 1fr); /* 2 colunas */
    }
  }

  @media (min-width: 768px) {
    .eventos__conteudo {
      padding: 2.5rem 1.5rem 1rem;
    }

    .eventos__titulo {
      font-size: 1.5rem;
    }

    .eventos__topo {
      margin-bottom: 1.5rem;
    }

    .eventos__grid {
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .eventos__grid {
      grid-template-columns: repeat(4, 1fr); /* desktop: 4 colunas */
    }
  }
</style>
