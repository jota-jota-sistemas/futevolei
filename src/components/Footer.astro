---
import BrandLogo from "./BrandLogo.astro";
import { comBase } from "../utils/url";
---

<footer class="footer">
  <div class="footer__conteudo">
    <div class="footer__marca">
      <BrandLogo variante="escuro" />
      <p class="footer__tagline">Conectando a comunidade do futevôlei</p>
    </div>

    <nav class="footer__links" aria-label="Links do rodapé">
      <a class="footer__link" href={comBase("/jogadores")}>Jogadores</a>
      <a
        class="footer__link placeholder"
        aria-disabled="true"
        title="Sobre o Pingo (disponível em breve)">Sobre o Pingo</a
      >
      <a
        class="footer__link placeholder"
        aria-disabled="true"
        title="Termos de uso (disponível em breve)">Termos de uso</a
      >
      <a
        class="footer__link placeholder"
        aria-disabled="true"
        title="Privacidade (disponível em breve)">Privacidade</a
      >
    </nav>

    <div class="footer__social">
      <button
        class="footer__icone placeholder"
        type="button"
        disabled
        aria-label="Instagram (disponível em breve)"
        title="Instagram (disponível em breve)"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <rect
            x="3"
            y="3"
            width="18"
            height="18"
            rx="5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"></rect>
          <circle
            cx="12"
            cy="12"
            r="4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"></circle>
          <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"></circle>
        </svg>
      </button>
      <button
        class="footer__icone placeholder"
        type="button"
        disabled
        aria-label="YouTube (disponível em breve)"
        title="YouTube (disponível em breve)"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <rect
            x="2"
            y="5"
            width="20"
            height="14"
            rx="4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"></rect>
          <path d="M10 9l5 3-5 3z" fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--cor-escuro);
    border-top: 1px solid var(--cor-borda-escura);
    margin-top: 3rem;
  }

  /* ---- Base: mobile (coluna) ---- */
  .footer__conteudo {
    max-width: var(--largura-conteudo);
    margin: 0 auto;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .footer__marca {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer__tagline {
    margin: 0;
    font-size: 0.9rem;
    color: var(--cor-texto-claro-suave);
  }

  .footer__links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer__link {
    color: var(--cor-texto-claro-suave);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .footer__social {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer__icone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--cor-borda-escura);
    background: var(--cor-escuro-2);
    color: var(--cor-texto-claro);
  }

  /* ---- A partir de 768px: linha horizontal ---- */
  @media (min-width: 768px) {
    .footer__conteudo {
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
      padding: 1.5rem;
    }

    .footer__links {
      margin-left: auto;
      gap: 1.5rem;
    }
  }
</style>
