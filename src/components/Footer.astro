---
import BrandLogo from "./BrandLogo.astro";
import { comBase } from "../utils/url";
import { ITENS_MENU } from "../utils/menu";
---

<footer class="footer">
  <div class="footer__conteudo">
    <div class="footer__marca">
      <BrandLogo variante="escuro" />
      <p class="footer__tagline">Conectando a comunidade do futevôlei</p>
    </div>

    <nav class="footer__links" aria-label="Links do rodapé">
      {
        ITENS_MENU.map((item) => (
          <a class="footer__link" href={comBase(item.href)}>
            {item.rotulo}
          </a>
        ))
      }
    </nav>
  </div>
</footer>

<style>
  .footer {
    background: var(--cor-escuro);
    border-top: 1px solid var(--cor-borda-escura);
    margin-top: 3rem;
  }

  /* ---- Base: mobile (coluna) ---- */
  .footer__conteudo {
    max-width: var(--largura-conteudo);
    margin: 0 auto;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .footer__marca {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer__tagline {
    margin: 0;
    font-size: 0.9rem;
    color: var(--cor-texto-claro-suave);
  }

  .footer__links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* alvo de toque confortável */
    color: var(--cor-texto-claro-suave);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .footer__link:hover {
    color: var(--cor-texto-claro);
  }

  /* ---- A partir de 768px: linha horizontal ---- */
  @media (min-width: 768px) {
    .footer__conteudo {
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
      padding: 1.5rem;
    }

    .footer__links {
      margin-left: auto;
      gap: 1.5rem;
    }

    .footer__link {
      min-height: 0;
    }
  }
</style>
