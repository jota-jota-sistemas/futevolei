# URL do projeto — Settings → Data API
PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Publishable key (antiga "anon") — pode ir ao frontend
PUBLIC_SUPABASE_ANON_KEY=sua-publishable-key-aqui

# Secret key (antiga "service_role") — SECRETA, só no servidor
SUPABASE_SERVICE_ROLE_KEY=sua-secret-key-aqui
